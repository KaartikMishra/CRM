# ---------------------------------------------------------------------------
# RoyalStuffs CRM — copy to .env and fill in. NEVER commit the filled-in file.
# ---------------------------------------------------------------------------

# --- Database (Neon PostgreSQL) --------------------------------------------
# Pooled connection used by the running application.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/royalstuffs_crm?sslmode=require"
# Direct (non-pooled) connection — Prisma Migrate requires this.
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/royalstuffs_crm?sslmode=require"

# --- Auth -------------------------------------------------------------------
# Shared by NextAuth (signing) and Express (verification). Generate with:
#   openssl rand -base64 32
AUTH_SECRET=""
SESSION_MAX_AGE_SECONDS="28800"

# --- Service URLs -----------------------------------------------------------
# Where the browser opens the notification socket. Reaches the client bundle,
# so it must never hold a secret — it is only a URL.
#
# Told to the client rather than derived: BACKEND_URL is server-only, and
# window.location is wrong whenever the API answers on a different host. Behind
# one origin this is wss://crm.example.com/ws; on a split host it is the API's.
# Leave empty to disable real-time delivery — notifications still arrive on
# fetch, just not instantly.
NEXT_PUBLIC_WS_URL="ws://localhost:4000/ws"

FRONTEND_URL="http://localhost:3000"
BACKEND_URL="http://localhost:4000"
PORT="4000"
NODE_ENV="development"

# --- Cloudinary -------------------------------------------------------------
# One credential string: cloudinary://<api_key>:<api_secret>@<cloud_name>
# Backend only. The API secret must never reach the browser, so there is
# deliberately no NEXT_PUBLIC_ equivalent. Leave blank to disable uploads.
CLOUDINARY_URL=

# Largest image accepted, in megabytes.
UPLOAD_MAX_MB="5"

# --- Shopify (RS Products) --------------------------------------------------
# Backend only. RS Products reads the catalogue from Shopify using the client
# credentials grant, which works because the app and the store belong to the
# same Shopify organisation. There is no OAuth redirect and no callback URL.
#
# SHOPIFY_CLIENT_SECRET is a credential: it is used server-side to request a
# short-lived access token and must never reach the browser. There is
# deliberately no NEXT_PUBLIC_ equivalent for any of these.
#
# Leave blank to disable the integration — the API still boots, and the
# connection check reports that Shopify is not configured.
#
# Store domain only: no https://, no trailing slash.
SHOPIFY_STORE_DOMAIN=
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
# Pinned deliberately. Changing it changes Shopify response shapes, so treat it
# as a code change with a test run, not a routine bump.
SHOPIFY_API_VERSION="2026-07"

# --- Mail (Nodemailer) ------------------------------------------------------
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
MAIL_FROM="RoyalStuffs CRM <crm@royalstuffs.com>"

# --- Business policy --------------------------------------------------------
# Snapshotted onto each enquiry at creation; changing it never rewrites history.
ENQUIRY_SLA_MINUTES="15"
# Enquiry number period strategy: CALENDAR (2026) or FINANCIAL (2026-27).
ENQUIRY_NUMBER_PERIOD="CALENDAR"

# --- Seed passwords ---------------------------------------------------------
# Used only by database/prisma/seed.ts, which creates the three administrator
# accounts. Keep out of the committed seed file; every other account is created
# through the admin User Management screen, not here.
#   1 = kaartikmishra074@gmail.com
#   2 = techroyalstuffs@gmail.com
#   3 = ajaygpt07@gmail.com
# Must be at least 8 characters and must not contain '$'.
SEED_ADMIN_1_PASSWORD=""
SEED_ADMIN_2_PASSWORD=""
SEED_ADMIN_3_PASSWORD=""

# --- Shopify webhooks (Phase 6) ---------------------------------------------
# No new variable: Shopify signs each delivery with the app's CLIENT SECRET,
# so SHOPIFY_CLIENT_SECRET above is what verifies the HMAC. There is
# deliberately no separate webhook signing key to configure.
#
# Register these four topics against the app (Dev Dashboard or Admin API):
#   products/create            -> POST /api/rs-products/webhooks/products-create
#   products/update            -> POST /api/rs-products/webhooks/products-update
#   products/delete            -> POST /api/rs-products/webhooks/products-delete
#   inventory_levels/update    -> POST /api/rs-products/webhooks/inventory_levels-update
#
# Production base: https://crm.royalstuffs.com
# The proxy must forward the request body unchanged (byte-for-byte), preserve
# the X-Shopify-* headers, allow >5s, and never redirect — Shopify treats 3xx
# as a failure, and eight consecutive failures delete the subscription.
