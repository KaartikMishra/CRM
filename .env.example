# ---------------------------------------------------------------------------
# RoyalStuffs CRM — copy to .env and fill in. NEVER commit the filled-in file.
# ---------------------------------------------------------------------------

# --- Database (Neon PostgreSQL) --------------------------------------------
# Pooled connection used by the running application.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/royalstuffs_crm?sslmode=require"
# Direct (non-pooled) connection — Prisma Migrate requires this.
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/royalstuffs_crm?sslmode=require"

# --- Auth -------------------------------------------------------------------
# Shared by NextAuth (signing) and Express (verification). Generate with:
#   openssl rand -base64 32
AUTH_SECRET=""
SESSION_MAX_AGE_SECONDS="28800"

# --- Service URLs -----------------------------------------------------------
FRONTEND_URL="http://localhost:3000"
BACKEND_URL="http://localhost:4000"
PORT="4000"
NODE_ENV="development"

# --- Cloudinary -------------------------------------------------------------
# Storage only for now; detailed upload behaviour pending requirements.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# --- Mail (Nodemailer) ------------------------------------------------------
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
MAIL_FROM="RoyalStuffs CRM <crm@royalstuffs.com>"

# --- Business policy --------------------------------------------------------
# Snapshotted onto each enquiry at creation; changing it never rewrites history.
ENQUIRY_SLA_MINUTES="15"
# Enquiry number period strategy: CALENDAR (2026) or FINANCIAL (2026-27).
ENQUIRY_NUMBER_PERIOD="CALENDAR"

# --- Seed passwords ---------------------------------------------------------
# Used only by database/prisma/seed.ts. Keep out of the committed seed file.
SEED_KAARTIK_PASSWORD=""
SEED_DEVANSH_PASSWORD=""
SEED_APARNA_PASSWORD=""
