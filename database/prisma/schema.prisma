// =============================================================================
//  RoyalStuffs CRM — relational model
//
//  Module 1 (Product Enquiry) is fully modelled. Customer, Vendor, MediaAsset
//  and User are deliberately built as shared masters so that Sales, Procurement,
//  Packing & Dispatch, Billing, Vendor Invoices and Post-Sales attach by foreign
//  key later without altering anything here.
//
//  Locked decisions:
//    Q1  the customer belongs to the enquiry, not to each product line
//    Q2  the SLA clock stops at the first submit (firstSubmitAt)
//    Q3  Full Submit needs every line RESPONDED or NO_VENDOR (with a reason)
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------------------
//  Identity & access
// ---------------------------------------------------------------------------

enum Role {
  ADMIN
  USER
}

/// The CRM modules permissions are granted against.
///
/// The original seven were pre-declared so the later ones needed no migration.
/// RS_PRODUCTS was decided after that set and therefore does need one: Postgres
/// has no way to add an enum value without ALTER TYPE. Anything added here from
/// now on carries the same cost.
enum AppModule {
  PRODUCT_ENQUIRY
  SALES
  PROCUREMENT
  RS_PRODUCTS
  PACKING_DISPATCH
  CUSTOMER_BILLING
  VENDOR_INVOICE
  POST_SALES
  /// Create Lead / Deal. Decided after the original set, so — like RS_PRODUCTS
  /// — it carries an ALTER TYPE migration of its own.
  LEAD_DEAL

  /// All Customers — the CRM customer directory, with its own ALTER TYPE
  /// migration for the same reason as LEAD_DEAL.
  ///
  /// Not a reuse of PRODUCT_ENQUIRY, which is what gates customer creation
  /// today: the people who may file an enquiry are not necessarily the people
  /// who may read every customer's purchase history, phone number and GSTIN.
  CUSTOMERS

  /// HR & Workforce Management — seven namespaces, not one module.
  ///
  /// HR is the first area where holding one capability must not imply another:
  /// the manager who approves leave has no business reading salaries. A single
  /// HR value would make those the same grant, so the split is the access model
  /// rather than a UI convenience.
  ///
  /// Registered before any HR page exists. An AppModule is a permission
  /// namespace, and a namespace may precede its screen — see
  /// MODULES_WITHOUT_NAVIGATION in shared/src/enums.ts, which records that
  /// deliberately and is asserted by the navigation test.
  HR_EMPLOYEE
  HR_ATTENDANCE
  HR_LEAVE
  HR_PAYROLL
  HR_RECRUITMENT
  HR_PERFORMANCE
  HR_ADMIN

  /// Training & Learning Management, added in Phase 4 with an ALTER TYPE
  /// migration of its own — the same route RS_PRODUCTS and LEAD_DEAL took.
  ///
  /// A separate namespace from HR_PERFORMANCE rather than a reuse of it, and that
  /// is the access model rather than tidiness: a trainer who builds a course and
  /// signs off a practical has no business reading appraisals, and an appraiser
  /// has no reason to edit the catalogue. Folding the two together would recreate
  /// exactly the conflation these seven namespaces exist to prevent.
  HR_TRAINING
}

enum PermissionAction {
  VIEW
  CREATE
  EDIT
  DELETE
  ASSIGN

  /// Deciding somebody else's request. Added with HR, and granted to no
  /// existing module: the nine shipped modules keep exactly the effective
  /// permissions they had before these three values existed.
  APPROVE

  /// Taking data out of the system. Separate from VIEW because reading one
  /// payslip on screen and downloading the payroll register are different
  /// risks, and only the second leaves the building.
  EXPORT

  /// Acting on one's own record only — the narrowest action there is. Lets one
  /// endpoint serve an employee and their manager without a second route.
  SELF
}

/// §6 — created by seed only; there is no public signup in v1.
model User {
  id           String    @id @default(cuid())
  employeeId   String    @unique
  name         String
  email        String    @unique
  mobile       String?
  passwordHash String
  role         Role      @default(USER)
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  permissions       UserModulePermission[]
  createdEnquiries  ProductEnquiry[]       @relation("EnquiryCreatedBy")
  assignedEnquiries ProductEnquiry[]       @relation("EnquiryAssignedTo")
  closedEnquiries   ProductEnquiry[]       @relation("EnquiryClosedBy")
  vendorResponses   VendorResponse[]
  events            EnquiryEvent[]
  delayRecords      DelayRecord[]
  auditLogs         AuditLog[]
  uploadedAssets    MediaAsset[]
  createdSalesOrders SalesOrder[]          @relation("SalesOrderCreatedBy")
  closedSalesOrders  SalesOrder[]          @relation("SalesOrderClosedBy")
  proposedSalesItems SalesOrderItem[]      @relation("SalesItemProposedBy")
  approvedSalesItems SalesOrderItem[]      @relation("SalesItemApprovedBy")
  requestedSalesChanges SalesItemChangeRequest[] @relation("SalesChangeRequestedBy")
  reviewedSalesChanges  SalesItemChangeRequest[] @relation("SalesChangeReviewedBy")
  requestedChargeChanges SalesChargeChangeRequest[] @relation("ChargeChangeRequestedBy")
  reviewedChargeChanges  SalesChargeChangeRequest[] @relation("ChargeChangeReviewedBy")
  cancelledSalesOrders   SalesOrder[]               @relation("SalesOrderCancelledBy")
  recordedSalesPayments  SalesPayment[]             @relation("SalesPaymentRecordedBy")
  requestedSalesRefunds  SalesRefund[]              @relation("SalesRefundRequestedBy")
  settledSalesRefunds    SalesRefund[]              @relation("SalesRefundSettledBy")
  requestedProductChanges PurchaseItemProductChange[] @relation("ProductChangeRequestedBy")
  reviewedProductChanges  PurchaseItemProductChange[] @relation("ProductChangeReviewedBy")
  reviewedPurchaseBills   PurchaseBill[]              @relation("PurchaseBillReviewedBy")
  createdPurchaseBills  PurchaseBill[]           @relation("PurchaseBillCreatedBy")
  purchaseAllocations   PurchaseAllocation[]     @relation("AllocationBy")
  requestedPurchaseDelays    PurchaseDelayReason[]    @relation("PurchaseDelayRequestedBy")
  reviewedPurchaseDelays     PurchaseDelayReason[]    @relation("PurchaseDelayReviewedBy")
  requestedProcurementDelays ProcurementDelayReason[] @relation("ProcurementDelayRequestedBy")
  reviewedProcurementDelays  ProcurementDelayReason[] @relation("ProcurementDelayReviewedBy")
  createdDispatches          Dispatch[]               @relation("DispatchCreatedBy")
  createdLeads               Lead[]                   @relation("LeadCreatedBy")
  ownedLeads                 Lead[]                   @relation("LeadAssociate")
  allocatedLeads             Lead[]                   @relation("LeadAllocatedBy")
  leadActivities             LeadActivity[]           @relation("LeadActivityPerformedBy")
  packedDispatches           Dispatch[]               @relation("DispatchPackedBy")
  dispatchedDispatches       Dispatch[]               @relation("DispatchDispatchedBy")
  requestedPartialDispatches PartialDispatchRequest[] @relation("PartialDispatchRequestedBy")
  decidedPartialDispatches   PartialDispatchRequest[] @relation("PartialDispatchDecidedBy")
  /// Post-sales work: cases this person owns, raised, acted on, or attached a
  /// photo to. Reverse sides only — the case and its children hold every key.
  assignedPostSalesCases     PostSalesCase[]          @relation("PostSalesAssignedTo")
  raisedPostSalesCases       PostSalesCase[]          @relation("PostSalesRaisedBy")
  postSalesActivities        PostSalesActivity[]      @relation("PostSalesActivityBy")
  postSalesAttachments       PostSalesAttachment[]    @relation("PostSalesAttachmentBy")
  notifications         Notification[]
  /// Cross-cutting foundation. Reverse sides only; every key lives on the other
  /// table. Both approval sides are named because one person can appear on a
  /// request twice over its life — as requester on one and decider on another.
  requestedApprovals    ApprovalRequest[]        @relation("ApprovalRequestedBy")
  decidedApprovals      ApprovalRequest[]        @relation("ApprovalDecidedBy")
  updatedHRSettings     HRSetting[]              @relation("HRSettingUpdatedBy")
  uploadedSecureDocuments SecureDocument[]       @relation("SecureDocumentUploadedBy")
  /// HR Phase 1. `employee` is the optional 1:1 — this account's HR record, where
  /// the person holding it is an employee. Reverse side only: Employee.userId
  /// holds the key and its @unique is what keeps the mapping one-to-one in both
  /// directions. No credential, role or permission lives on the HR record.
  employee                  Employee?          @relation("EmployeeAccount")
  employeeHistoryEntries    EmployeeHistory[]  @relation("EmployeeHistoryBy")
  verifiedEmployeeDocuments EmployeeDocument[] @relation("EmployeeDocumentVerifiedBy")
  uploadedEmployeeDocuments EmployeeDocument[] @relation("EmployeeDocumentUploadedBy")
  /// HR Phase 2 decision trails. Named relations because one person can appear on
  /// several of these over time.
  decidedAttendanceCorrections AttendanceCorrectionRequest[] @relation("AttendanceCorrectionDecidedBy")
  decidedOvertime              OvertimeRecord[]              @relation("OvertimeDecidedBy")
  decidedLeaveRequests         LeaveRequest[]                @relation("LeaveDecidedBy")
  leaveLedgerActions           LeaveLedgerEntry[]            @relation("LeaveLedgerBy")
  /// HR Phase 3 — recruitment, onboarding and probation. Every one of these is a
  /// record of an action an *account* took, which is why they point here rather
  /// than at Employee: the audit question is "who clicked this", and a recruiter
  /// without an HR record still has a login.
  createdJobRequisitions    JobRequisition[]          @relation("JobCreatedBy")
  createdCandidates         Candidate[]               @relation("CandidateCreatedBy")
  selectedApplications      Application[]             @relation("ApplicationSelectedBy")
  applicationStageChanges   ApplicationStageHistory[] @relation("StageHistoryBy")
  createdInterviews         Interview[]               @relation("InterviewCreatedBy")
  createdOffers             Offer[]                   @relation("OfferCreatedBy")
  verifiedBackgroundChecks  BackgroundCheck[]         @relation("BackgroundVerifiedBy")
  uploadedCandidateDocuments CandidateDocument[]      @relation("CandidateDocumentUploadedBy")
  verifiedCandidateDocuments CandidateDocument[]      @relation("CandidateDocumentVerifiedBy")
  createdOnboardingRecords  OnboardingRecord[]        @relation("OnboardingCreatedBy")
  completedOnboardingTasks  OnboardingTask[]          @relation("OnboardingTaskCompletedBy")
  decidedProbations         ProbationRecord[]         @relation("ProbationDecidedBy")
  /// HR Phase 4 — training. Each records an action an *account* took, which is why
  /// they point here rather than at Employee: the audit question is "who did this",
  /// and an HR administrator may hold no HR record at all.
  createdTrainingCategories TrainingCategory[]       @relation("TrainingCategoryCreatedBy")
  createdTrainingPrograms   TrainingProgram[]        @relation("TrainingProgramCreatedBy")
  createdTrainingAssessments TrainingAssessment[]    @relation("TrainingAssessmentCreatedBy")
  trainingAssignmentsMade   TrainingEnrollment[]     @relation("TrainingAssignedBy")
  trainingExemptionsGranted TrainingEnrollment[]     @relation("TrainingExemptedBy")
  qualificationsGranted     TrainingQualification[]  @relation("TrainingQualificationGrantedBy")
  qualificationsRevoked     TrainingQualification[]  @relation("TrainingQualificationRevokedBy")
  /// HR Phase 5 — performance. Same reasoning: each records what an *account* did.
  /// `finalizedPerformanceReviews` matters most — approving an appraisal is the act
  /// the separation-of-duties rule turns on, and the approver is identified by
  /// their account because HR approvers do not all have an Employee record.
  createdReviewCycles         ReviewCycle[]         @relation("ReviewCycleCreatedBy")
  createdPerformanceGoals     PerformanceGoal[]     @relation("GoalCreatedBy")
  closedPerformanceGoals      PerformanceGoal[]     @relation("GoalClosedBy")
  kpisLastUpdated             PerformanceKpi[]      @relation("KpiLastUpdatedBy")
  kpiProgressRecorded         KpiProgressRecord[]   @relation("KpiProgressRecordedBy")
  finalizedPerformanceReviews PerformanceReview[]   @relation("PerformanceReviewFinalizedBy")
  managerAssessmentsSubmitted ManagerAssessment[]   @relation("ManagerAssessmentSubmittedBy")
  competencyRatingsGiven      CompetencyRating[]    @relation("CompetencyRatedBy")
  createdDevelopmentPlans     DevelopmentPlan[]     @relation("DevelopmentPlanCreatedBy")
  closedDevelopmentPlans      DevelopmentPlan[]     @relation("DevelopmentPlanClosedBy")
  completedDevelopmentActions DevelopmentAction[]   @relation("DevelopmentActionCompletedBy")

  /// Phase 6 — payroll. Four separate actor relations on PayrollPeriod because
  /// who costed a run, who approved it and who locked it are different facts that
  /// an audit has to be able to distinguish — and because the separation-of-duties
  /// rule is checked against them.
  createdSalaryComponents SalaryComponent[]   @relation("SalaryComponentCreatedBy")
  createdSalaryStructures SalaryStructure[]   @relation("SalaryStructureCreatedBy")
  createdSalaryAssignments EmployeeSalary[]   @relation("EmployeeSalaryCreatedBy")
  createdPayrollPeriods   PayrollPeriod[]     @relation("PayrollCreatedBy")
  calculatedPayrollPeriods PayrollPeriod[]    @relation("PayrollCalculatedBy")
  approvedPayrollPeriods  PayrollPeriod[]     @relation("PayrollApprovedBy")
  finalizedPayrollPeriods PayrollPeriod[]     @relation("PayrollFinalizedBy")
  createdPayrollAdjustments PayrollAdjustment[] @relation("PayrollAdjustmentCreatedBy")

  /// Inventory Alerts — who chose to watch a variant, and who last changed it.
  createdMonitoredVariants MonitoredVariant[] @relation("MonitoredVariantCreatedBy")
  updatedMonitoredVariants MonitoredVariant[] @relation("MonitoredVariantUpdatedBy")

  /// Duplicate-review decisions this person made. Reverse side only.
  decidedDuplicateCandidates CustomerDuplicateCandidate[] @relation("DuplicateCandidateDecidedBy")

  @@index([role, isActive])
}

/// Absent rows mean "use the role default"; present rows override it.
/// v1 needs no rows at all while the mechanism is already in place.
model UserModulePermission {
  id      String           @id @default(cuid())
  userId  String
  module  AppModule
  action  PermissionAction
  allowed Boolean          @default(true)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, module, action])
}

// ---------------------------------------------------------------------------
//  Shared masters
// ---------------------------------------------------------------------------

enum CustomerType {
  RETAIL
  BULK
  WEDDING_GIFTING
  CORPORATE_GIFTING
}

/// Where a duplicate-candidate pair stands.
///
/// SUGGESTED is where every pair starts and the only state a scan writes.
/// CONFIRMED means a human agreed these are one customer — a label, not a
/// merge. DISMISSED means they are different people, and the scan honours that
/// until the matched identifiers themselves change.
enum CustomerDuplicateStatus {
  SUGGESTED
  CONFIRMED
  DISMISSED
}

/// Q1 — one enquiry belongs to one customer. Sales and Billing will reference
/// this same row rather than duplicating the name.
model Customer {
  id        String       @id @default(cuid())
  name      String
  /// The trading or registered name, where the customer bills under one.
  ///
  /// Separate from `name` rather than folded into it: `name` is who is dealt
  /// with and appears on every list row, while this is who the invoice is made
  /// out to. A retail buyer has the first and not the second, so it is
  /// optional and every existing row predates it.
  companyName String?
  type      CustomerType
  phone     String?
  email     String?
  /// Where to deliver or invoice. Optional and free-text: an address is written
  /// the way the customer gives it, and every existing row predates this field.
  address   String?
  /// One of the States or Union Territories of India, by official name.
  ///
  /// Plain text rather than a Postgres enum: the list is a fixed reference list
  /// that @rs/shared already owns (INDIA_STATES) and validates at the edge, and
  /// an enum would only make correcting that list expensive — a value cannot be
  /// dropped from a Postgres enum. Optional; every existing row predates it.
  state     String?
  /// One of COUNTRIES in @rs/shared, stored as the country's common name.
  ///
  /// Plain text for the same reason as `state`: a fixed reference list that
  /// @rs/shared owns and validates at the edge. Optional, because every
  /// existing row predates it — a blank one is read as India by nothing, and
  /// is simply blank.
  country   String?
  /// The customer's GSTIN, where they are registered.
  ///
  /// Optional by business rule — a retail customer has none — and stored
  /// uppercase. Not unique: the same GSTIN can legitimately appear on more
  /// than one row. Structure is checked at the edge; the database enforces no
  /// checksum and no cross-check against `state`.
  gstNumber String?
  /// `phone` with every non-digit removed, maintained alongside it.
  ///
  /// Stored rather than derived per query because the directory searches on it
  /// and duplicate detection compares it across the whole table: the existing
  /// `lookupCustomersByPhone` reads every phone-bearing customer and filters in
  /// memory, which is acceptable for one lead form and not for either of those.
  ///
  /// Nullable, because `phone` is — and because every existing row predates
  /// this column. Not unique: two real people legitimately share a landline,
  /// and enforcing otherwise would refuse honest data. The value is the
  /// digits-only fold from `normalizePhone` in @rs/shared, so the column and
  /// the matcher cannot disagree about what "the same number" means.
  phoneNormalized String?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  enquiries   ProductEnquiry[]
  salesOrders SalesOrder[]
  leads       Lead[]
  /// Duplicate-review pairs this customer appears in, on either side.
  duplicateCandidatesAsA CustomerDuplicateCandidate[] @relation("DuplicateCandidateA")
  duplicateCandidatesAsB CustomerDuplicateCandidate[] @relation("DuplicateCandidateB")
  /// Post-sales cases raised against this customer. Reverse side only; the case
  /// holds the foreign key and no customer field is copied onto it.
  postSalesCases PostSalesCase[]

  /// Not unique: two real firms can legitimately share a name.
  @@index([name])
  /// The directory searches on these, and duplicate detection scans them.
  @@index([phoneNormalized])
  @@index([email])
}

/// Where a duplicate-review decision is recorded.
///
/// Two customer rows can describe one real customer: `Customer` enforces no
/// uniqueness on phone, email or GSTIN — deliberately, because two real people
/// share a landline and the same GSTIN legitimately appears on more than one
/// row — and `createCustomer` has never deduplicated. So duplicates exist, and
/// `lookupCustomersByPhone` already hands the caller every match rather than
/// silently picking one.
///
/// This table records what a human decided about a pair. It does NOT merge
/// anything: confirming a candidate marks it confirmed and changes no customer
/// row, no enquiry, no lead and no order. Merging is a separate decision with
/// its own rules, and nothing here presumes it.
///
/// ## Why the pair is stored in a fixed order
///
/// (A, B) and (B, A) are the same pair. Storing both would let one be dismissed
/// while the other stayed suggested, so the service writes them with
/// `customerAId < customerBId` by string comparison and the unique index below
/// makes a second spelling impossible. That is also what makes a rescan
/// idempotent: it upserts the pair it already wrote instead of adding a twin.
model CustomerDuplicateCandidate {
  id String @id @default(cuid())

  /// The lower customer id of the pair, by string comparison. See the note above.
  customerAId String
  /// The higher customer id of the pair.
  customerBId String

  /// How strong the match is, 0-100, from the scoring rules in @rs/shared.
  ///
  /// Stored rather than recomputed on read so a reviewer sees the score the
  /// suggestion was made on, and so `identifierFingerprint` below has something
  /// to be compared against.
  score Int

  /// Which identifiers matched, as the scorer named them — "phone", "email",
  /// "gstNumber", "companyAndState". Plain text in input order: this is shown to
  /// a reviewer to explain the suggestion, never parsed to make a decision.
  matchedOn String

  /// A digest of the identifier VALUES the match was based on.
  ///
  /// This is what makes the reopening rule work. A dismissed pair stays
  /// dismissed — but only while it is the same pair of facts. If somebody
  /// corrects a phone number or adds an email, the fingerprint changes, and the
  /// scan reopens the pair as SUGGESTED rather than honouring a dismissal that
  /// was made about different data.
  identifierFingerprint String

  status CustomerDuplicateStatus @default(SUGGESTED)

  /// Who decided, and when. Null while the pair is still SUGGESTED.
  ///
  /// SetNull rather than Cascade: the decision is the record, and it outlives
  /// the reviewer's account. Losing who decided is a smaller loss than losing
  /// that a decision was made at all.
  decidedById String?
  decidedBy   User?     @relation("DuplicateCandidateDecidedBy", fields: [decidedById], references: [id], onDelete: SetNull)
  decidedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Restrict on both sides, matching `Lead.customerId`: a customer named by a
  /// review decision is referenced history, and deleting one should fail loudly
  /// rather than quietly discard the decision.
  customerA Customer @relation("DuplicateCandidateA", fields: [customerAId], references: [id], onDelete: Restrict)
  customerB Customer @relation("DuplicateCandidateB", fields: [customerBId], references: [id], onDelete: Restrict)

  /// One row per pair, which is what makes a rescan an upsert rather than a
  /// duplicate. Relies on the ordering rule above.
  @@unique([customerAId, customerBId])
  /// The review queue reads by status, newest suggestion first.
  @@index([status, score])
}

/// §37 — a reusable entity, never re-created per enquiry.
model Vendor {
  id            String   @id @default(cuid())
  /// The supplier's own name, and the one thing always required.
  ///
  /// Unique, deliberately: Procurement resolves a vendor by name when a bill is
  /// typed up, and two suppliers sharing a name would make that ambiguous. Two
  /// real firms with the same name are distinguished in the name itself —
  /// "Devansh (Moradabad)" — which is what the existing module already assumes.
  name          String   @unique
  contactPerson String?
  phone         String?
  email         String?
  city          String?

  /// The trading name, where it differs from the person dealt with.
  companyName String?
  /// The full postal address. `city` above predates it and is kept: existing
  /// rows use it, and Product Enquiry reads it.
  address     String?
  /// A second contact number. `phone` remains the primary/WhatsApp one.
  altPhone    String?

  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  responses      VendorResponse[]
  purchaseBills  PurchaseBill[]
  productMappings VendorProductMapping[]

  @@index([isActive, name])
}

/// Which vendor supplies which product, and at what rate today.
///
/// Deliberately points at RsProduct rather than the legacy Product master: RS
/// Products is the canonical catalogue going forward, and this module is new
/// enough to have no history tying it to the old one.
///
/// The rate here is the *current* agreed price — what a buyer would expect to
/// pay now. It is not history: what a purchase actually cost lives on
/// PurchaseBillItem.rate and is never rewritten when this changes. The two
/// answer different questions, and conflating them would silently rewrite the
/// past every time a supplier quoted a new price.
///
/// Many-to-many in both directions: one product may have several suppliers, and
/// one supplier several products.
model VendorProductMapping {
  id          String @id @default(cuid())
  vendorId    String
  rsProductId String

  /// Per unit, NUMERIC so no floating point touches money — matching how every
  /// other rate in this CRM is stored.
  currentRate Decimal @db.Decimal(12, 2)

  /// Retired mappings stay for reference; they simply stop being offered.
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  vendor    Vendor    @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  rsProduct RsProduct @relation(fields: [rsProductId], references: [id], onDelete: Cascade)

  /// One row per pair, regardless of state. A pair is one relationship whose
  /// rate and status change over time, so re-mapping an archived pair
  /// reactivates that row and keeps its history rather than creating a second.
  @@unique([vendorId, rsProductId])
  /// The mapping table's own queries: by vendor, and by product.
  @@index([vendorId, isActive])
  @@index([rsProductId, isActive])
}

/// §5 / §6 — one Cloudinary object. URL and public ID only; never binary data.
/// Detailed Cloudinary behaviour is deferred until those requirements arrive.
model MediaAsset {
  id           String   @id @default(cuid())
  publicId     String   @unique
  secureUrl    String
  format       String?
  width        Int?
  height       Int?
  bytes        Int?
  uploadedById String
  createdAt    DateTime @default(now())

  uploadedBy      User             @relation(fields: [uploadedById], references: [id])
  enquiryProducts EnquiryProduct[]
  vendorResponses VendorResponse[]
  salesOrderItems SalesOrderItem[] @relation("SalesItemImage")
  salesChangeRequests SalesItemChangeRequest[] @relation("SalesChangeImage")
  purchaseBills       PurchaseBill[]           @relation("PurchaseBillImage")
  purchaseBillItems   PurchaseBillItem[]       @relation("PurchaseItemImage")
  leadRequirements    LeadProductRequirement[] @relation("LeadRequirementImage")
  postSalesAttachments PostSalesAttachment[]    @relation("PostSalesAttachmentMedia")

  @@index([uploadedById, createdAt])
}

// ---------------------------------------------------------------------------
//  Product Enquiry
// ---------------------------------------------------------------------------

enum EnquirySource {
  WHATSAPP
  EMAIL
  CALL
  WEBSITE
  INDIAMART
  OTHERS
}

/// §27 — coverage status only. Time state lives in the SLA columns below.
enum EnquiryStatus {
  OPEN
  PARTIAL_CLOSED
  CLOSED
}

enum EnquiryEfficiency {
  ON_TIME
  DELAYED
}

/// Q3 — NO_VENDOR is what makes Full Submit reachable when nobody stocks a line.
enum EnquiryProductStatus {
  PENDING
  RESPONDED
  NO_VENDOR
}

enum WeightUnit {
  G
  KG
  LB
}

enum DimensionUnit {
  MM
  CM
  IN
  FT
}

/// §38 — how a vendor's offering relates to the product the customer asked for.
/// SIMILAR_PRODUCT keeps its original position so existing rows are unaffected.
enum ProductMatchType {
  SIMILAR_PRODUCT
  EXACT_PRODUCT
}

model ProductEnquiry {
  /// Used in URLs — not guessable, unlike a sequential integer.
  id        String @id @default(cuid())
  /// §23 — human-facing only: ENQ-2026-000001.
  enquiryNo String @unique

  customerId   String
  source       EnquirySource
  /// §17 — required when source is OTHERS; also a CHECK constraint.
  sourceDetail String?

  status       EnquiryStatus @default(OPEN)
  createdById  String
  /// §28 — "Towards": whose SLA clock is running.
  assignedToId String

  // --- the clock -----------------------------------------------------------
  // Every timestamp comes from one Postgres now() taken inside the creation
  // transaction. Node's clock is never consulted for business time.

  /// §24 — snapshot of the policy in force, so a later change to the SLA
  /// cannot retroactively rewrite whether this enquiry was on time.
  slaMinutes    Int      @default(15)
  createdAt     DateTime
  slaDeadlineAt DateTime

  /// Q2 — the clock stops at the first submit, partial or full.
  firstSubmitAt   DateTime?
  /// createdAt → firstSubmitAt, frozen at the same moment. Powers average
  /// response time without recomputing it from the event log.
  responseSeconds Int?
  /// §29 — written exactly once, never recalculated.
  efficiency      EnquiryEfficiency?

  partialSubmittedAt DateTime?
  closedAt           DateTime?
  closedById         String?
  updatedAt          DateTime  @updatedAt

  customer   Customer @relation(fields: [customerId], references: [id])
  createdBy  User     @relation("EnquiryCreatedBy", fields: [createdById], references: [id])
  assignedTo User     @relation("EnquiryAssignedTo", fields: [assignedToId], references: [id])
  closedBy   User?    @relation("EnquiryClosedBy", fields: [closedById], references: [id])

  products EnquiryProduct[]
  events   EnquiryEvent[]
  delays   DelayRecord[]

  @@index([status, slaDeadlineAt])
  @@index([assignedToId, status])
  @@index([customerId])
  @@index([createdAt])
  @@index([efficiency, createdAt])
  @@index([firstSubmitAt])
}

/// §11 — one of up to twenty requested items.
/// The cap is guaranteed by @@unique([enquiryId, lineNo]) plus a CHECK
/// constraint, so two concurrent requests cannot produce a 21st row.
model EnquiryProduct {
  id        String @id @default(cuid())
  enquiryId String
  lineNo    Int

  name     String
  /*
   * There is deliberately no catalogue link here.
   *
   * `productId -> Product` was added with Purchase & Procurement and never
   * written: no schema accepted it, no service set it, and it stood at NULL on
   * every row. It was removed with the legacy Product master rather than
   * repointed at RsProduct — an enquiry is a question about goods a customer
   * described, which is exactly why `name` is free text, and nothing in this
   * module has ever needed a catalogue identity to answer it.
   */
  imageId  String?
  quantity Int

  // §19 — stored as entered, plus a normalised column so mixed units still
  // sort and filter together.
  weightValue   Decimal?    @db.Decimal(10, 3)
  weightUnit    WeightUnit?
  weightInGrams Decimal?    @db.Decimal(12, 3)

  // §20 — structured, never a free-text string.
  lengthValue   Decimal?       @db.Decimal(10, 2)
  widthValue    Decimal?       @db.Decimal(10, 2)
  heightValue   Decimal?       @db.Decimal(10, 2)
  dimensionUnit DimensionUnit?
  lengthMm      Decimal?       @db.Decimal(12, 2)
  widthMm       Decimal?       @db.Decimal(12, 2)
  heightMm      Decimal?       @db.Decimal(12, 2)

  /// §21 — the customer will accept alternatives for this line.
  similarOptionNeeded Boolean              @default(false)
  status              EnquiryProductStatus @default(PENDING)
  /// Q3 — mandatory when status is NO_VENDOR; also a CHECK constraint.
  noVendorReason      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  enquiry         ProductEnquiry   @relation(fields: [enquiryId], references: [id], onDelete: Cascade)
  image           MediaAsset?      @relation(fields: [imageId], references: [id], onDelete: SetNull)
  vendorResponses VendorResponse[]

  @@unique([enquiryId, lineNo])
  @@index([enquiryId, status])
}

/// §39 — many of these per line. That is the heart of the module.
model VendorResponse {
  id               String @id @default(cuid())
  enquiryProductId String
  vendorId         String

  /// §32 — a separate relation from the customer's image, so a vendor upload
  /// can never overwrite what the customer sent.
  imageId   String?
  /// §38 — always a similar/alternative option for the requested product.
  matchType ProductMatchType

  /// §35 / Q8 — NUMERIC, per unit. The line total is derived, never stored.
  ratePerUnit Decimal @db.Decimal(12, 2)
  currency    String  @default("INR")

  /// §36 — structured days rather than free text.
  deliveryWithinDays Int
  /// The vendor can deliver on the day of order.
  ///
  /// A separate flag rather than deliveryWithinDays = 0, which the
  /// delivery_positive CHECK forbids, or = 1, which already means "tomorrow".
  /// Nullable so vendor responses recorded before this field existed remain
  /// valid and read as "not stated" rather than a false denial.
  sameDay            Boolean?
  deliveryNote       String?

  weightValue   Decimal?       @db.Decimal(10, 3)
  weightUnit    WeightUnit?
  weightInGrams Decimal?       @db.Decimal(12, 3)
  lengthValue   Decimal?       @db.Decimal(10, 2)
  widthValue    Decimal?       @db.Decimal(10, 2)
  heightValue   Decimal?       @db.Decimal(10, 2)
  dimensionUnit DimensionUnit?

  notes       String?
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  enquiryProduct EnquiryProduct @relation(fields: [enquiryProductId], references: [id], onDelete: Cascade)
  vendor         Vendor         @relation(fields: [vendorId], references: [id])
  image          MediaAsset?    @relation(fields: [imageId], references: [id], onDelete: SetNull)
  createdBy      User           @relation(fields: [createdById], references: [id])

  @@index([enquiryProductId])
  @@index([vendorId, createdAt])
}

// ---------------------------------------------------------------------------
//  History, delays, numbering
// ---------------------------------------------------------------------------

enum EnquiryEventType {
  CREATED
  ASSIGNED
  REASSIGNED
  PRODUCT_ADDED
  PRODUCT_UPDATED
  PRODUCT_REMOVED
  VENDOR_RESPONSE_ADDED
  VENDOR_RESPONSE_UPDATED
  DEADLINE_BREACHED
  DELAY_REASON_SUBMITTED
  PARTIAL_SUBMITTED
  FULL_SUBMITTED
  CLOSED
  REOPENED
}

/// §44 — the Efficiency History. Append-only: the service layer exposes no
/// update path, and nothing here is ever rewritten.
model EnquiryEvent {
  id         String           @id @default(cuid())
  enquiryId  String
  type       EnquiryEventType
  /// Null means the system acted — the SLA breach sweeper, typically.
  actorId    String?
  field      String?
  oldValue   String?
  newValue   String?
  /// Shape-varying diff payload; never queried relationally.
  metadata   Json?
  occurredAt DateTime         @default(now())

  enquiry ProductEnquiry @relation(fields: [enquiryId], references: [id], onDelete: Cascade)
  actor   User?          @relation(fields: [actorId], references: [id])

  @@index([enquiryId, occurredAt])
  @@index([type, occurredAt])
}

/// §43 — one row per breach, many rows allowed. Never overwritten, because
/// management analytics depend on the full history.
model DelayRecord {
  id            String   @id @default(cuid())
  enquiryId     String
  reason        String
  /// Snapshot of the deadline that was missed.
  deadlineAt    DateTime
  /// When the breach was detected.
  detectedAt    DateTime
  minutesLate   Int
  submittedById String
  submittedAt   DateTime @default(now())

  enquiry     ProductEnquiry @relation(fields: [enquiryId], references: [id], onDelete: Cascade)
  submittedBy User           @relation(fields: [submittedById], references: [id])

  @@index([enquiryId, submittedAt])
}

/// §23 — row-locked inside the creation transaction so two employees creating
/// enquiries at the same instant cannot be handed the same number.
model EnquiryCounter {
  /// "2026" for a calendar year, "2026-27" for an Indian financial year (Q5).
  period    String @id
  lastValue Int    @default(0)
}

// ---------------------------------------------------------------------------
//  Sales
// ---------------------------------------------------------------------------

/// A deliberately linear lifecycle. There is no reopen: leaving CLOSED is not a
/// sanctioned move, and every closed order therefore carries a frozen verdict.
enum SalesOrderStatus {
  OPEN
  DISPATCHED
  CLOSED
  /// Called off. A terminal state reached from OPEN or DISPATCHED, and never
  /// from CLOSED — a settled order is history. Deliberately NOT a deletion:
  /// the order, its lines, its payments and its customer all stay exactly as
  /// they were, and the status is what distinguishes it from a live one.
  ///
  /// It moves no money by itself. The payable the money guard computes is
  /// unchanged by cancelling, so what was paid stays paid and becomes
  /// refundable through SalesRefund rather than silently disappearing.
  CANCELLED
}

/// Where a refund has got to.
///
/// PENDING is a decision recorded, not money moved — there is no payment
/// gateway behind this, so COMPLETED means somebody says they have sent the
/// money and names how. The distinction is the point: an order can be
/// cancelled, its refund agreed, and the customer still be owed.
enum SalesRefundStatus {
  PENDING
  COMPLETED
  REJECTED
}

/// The dispatch verdict. Mirrors EnquiryEfficiency in shape but is its own type,
/// because the two are frozen by different events and must stay free to diverge.
enum SalesEfficiency {
  ON_TIME
  DELAYED
}

/// Whether a line counts toward the order.
///
/// A line added during editing by someone without approval rights waits here
/// until an approver acts. PENDING_APPROVAL lines are excluded from every total,
/// so a proposal cannot move money on its own.
/// Every item row that exists is part of the order. PENDING_APPROVAL is kept so
/// no column has to be dropped, but nothing writes it any more: proposals live
/// in SalesItemChangeRequest, so there is one mechanism rather than two.
enum SalesItemStatus {
  ACTIVE
  PENDING_APPROVAL
}

/// What a change request is asking for.
enum SalesChangeType {
  ADD
  EDIT
  REMOVE
}

/// A request is decided exactly once. The decision is kept rather than deleted,
/// so an order can show what was asked for and refused, not only what survived.
enum SalesChangeStatus {
  PENDING
  APPROVED
  REJECTED
}

/// A proposed change to an order's products, held apart from the products
/// themselves.
///
/// This is the only way an order's lines change after creation. The separation
/// is the whole point: an EDIT has to hold proposed values *beside* the
/// untouched original, and a REMOVE has to record intent while the line keeps
/// counting. Neither is expressible on the item row itself, which has exactly
/// one quantity and one price.
///
/// Nothing here is visible to any total. Order value sums SalesOrderItem rows,
/// so a pending request cannot move money however long it sits.
model SalesItemChangeRequest {
  id      String @id @default(cuid())
  orderId String
  /// Null for ADD — there is no line yet. Required for EDIT and REMOVE.
  itemId  String?

  type   SalesChangeType
  status SalesChangeStatus @default(PENDING)

  // Proposed values: required for ADD and EDIT, unused by REMOVE.
  productName    String?
  /// The RS Product carried through a change request, so an approved ADD or
  /// EDIT can set SalesOrderItem.rsProductId. Nullable like every other field
  /// here: a REMOVE request carries none of them.
  rsProductId    String?
  productImageId String?
  quantity       Int?
  price          Decimal? @db.Decimal(12, 2)

  requestedById String
  requestedAt   DateTime @default(now())

  /// Written together with reviewedAt when the request is decided.
  reviewedById String?
  reviewedAt   DateTime?
  reviewNote   String?

  order        SalesOrder      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  /// Cascade: if the line is ever removed, its request history goes with it.
  item         SalesOrderItem? @relation(fields: [itemId], references: [id], onDelete: Cascade)
  rsProduct    RsProduct?      @relation(fields: [rsProductId], references: [id], onDelete: SetNull)
  productImage MediaAsset?     @relation("SalesChangeImage", fields: [productImageId], references: [id], onDelete: SetNull)
  requestedBy  User            @relation("SalesChangeRequestedBy", fields: [requestedById], references: [id])
  reviewedBy   User?           @relation("SalesChangeReviewedBy", fields: [reviewedById], references: [id])

  @@index([orderId, status])
  @@index([itemId, status])
}

/// One sales order, holding one or more product lines.
///
/// Money invariant: the only figure stored on the order itself is paidAmount.
/// The total is the sum of its ACTIVE lines and pending is total − paid; neither
/// has a column anywhere, so there is exactly one definition of each and nothing
/// to drift. A read-only field with no column cannot be edited by a hand-crafted
/// request, only by one that does not exist.
///
/// Because the total now spans two tables, a row-local CHECK can no longer
/// express the payment ceiling or the settlement rule. Deferred constraint
/// triggers do that instead — see the sales_order_multi_item migration.
model SalesOrder {
  /// Used in URLs — not guessable, and stable even if the order id is corrected.
  id      String @id @default(cuid())
  /// Manually entered, never generated: orders arrive from Shopify as often as
  /// they are keyed in by hand, so the CRM records the number rather than
  /// inventing a competing one.
  orderId String @unique

  customerId String

  /// Partial payments accumulate here. The ceiling is the sum of the order's
  /// ACTIVE lines, enforced by trigger rather than written down a second time.
  paidAmount Decimal @db.Decimal(14, 2) @default(0)

  /**
   * How the order's money is being collected: one of PAYMENT_METHODS in
   * @rs/shared — 'PREPAID' | 'COD' | 'PARTIAL_COD'.
   *
   * A plain nullable String rather than a Prisma enum, following gstMode,
   * gstRate and Customer.state: these are business lists that get revised, and
   * a Postgres enum charges an ALTER TYPE for every revision while never
   * letting a value be dropped. The shared z.enum restricts it on both tiers.
   *
   * Nullable, and that is a real third answer rather than a gap: every order
   * recorded before this column existed has none, and an order on which no
   * payment has been taken has nothing to say either. The service requires one
   * exactly when money is recorded — never merely because an order exists.
   *
   * Deliberately NOT a term in any total. It says how the paidAmount arrived,
   * not how much; sales_order_money_guard does not read it and no arithmetic
   * depends on it.
   */
  paymentMethod String?

  orderDate        DateTime
  /// The dispatch deadline. A date, so the verdict below compares against the
  /// end of this day rather than its midnight.
  toBeDispatchedBy DateTime

  status SalesOrderStatus @default(OPEN)

  /// Written exactly once, together with efficiency, at dispatch.
  dispatchedAt DateTime?
  /// Frozen at dispatch and never recalculated — a later edit to the deadline
  /// cannot retroactively rewrite whether this order went out on time.
  efficiency   SalesEfficiency?

  closedAt   DateTime?
  closedById String?

  /// Who called the order off, when, and why. Columns rather than a separate
  /// record, exactly as closedAt/closedById already are: the three facts
  /// belong to the order, are read every time it is, and a reader should not
  /// have to join to learn that an order is cancelled.
  ///
  /// The reason is required whenever the order is cancelled, enforced by
  /// sales_cancelled_recorded_together.
  cancelledAt        DateTime?
  cancelledById      String?
  cancellationReason String?

  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  customer  Customer         @relation(fields: [customerId], references: [id])
  createdBy User             @relation("SalesOrderCreatedBy", fields: [createdById], references: [id])
  closedBy  User?            @relation("SalesOrderClosedBy", fields: [closedById], references: [id])
  cancelledBy User?          @relation("SalesOrderCancelledBy", fields: [cancelledById], references: [id])
  items          SalesOrderItem[]
  charges        SalesOrderCharge[]
  changeRequests SalesItemChangeRequest[]
  chargeChangeRequests SalesChargeChangeRequest[]
  payments       SalesPayment[]
  refunds        SalesRefund[]
  /// The procurement clock for this order. Created with the order, and holding
  /// only a deadline and a completion result — never a copy of anything here.
  procurementClock ProcurementClock?
  /// Shipments of this order, and any request to send part of it early.
  /// Virtual — both foreign keys live on the other side.
  dispatches              Dispatch[]
  partialDispatchRequests PartialDispatchRequest[]
  /// Post-sales cases about this order. Reverse side only; Restrict on the case's
  /// foreign key, so a case can never delete an order.
  postSalesCases          PostSalesCase[]
  /// The lead this order came from, if it came from one. One-to-one, because the
  /// FK on Lead is unique: one order is the result of at most one lead.
  lead                    Lead?

  @@index([status, toBeDispatchedBy])
  @@index([customerId])
  @@index([orderDate])
  @@index([efficiency, orderDate])
}

/// One product line on an order.
///
/// A line proposed by someone without approval rights is created
/// PENDING_APPROVAL and contributes nothing to the order's total until an
/// approver moves it to ACTIVE. That is the whole of the approval mechanism:
/// totals only ever sum ACTIVE rows, so a pending line cannot move money.
model SalesOrderItem {
  id      String @id @default(cuid())
  orderId String
  /// Position on the order. Unique per order, so two concurrent adds cannot
  /// collide on the same line number.
  lineNo  Int

  productName    String
  /**
   * The RS Product this line is for — the CRM's one product identity.
   *
   * Replaced `productId`, which pointed at the legacy Product master. That
   * column is gone: two product identities meant Sales and Procurement could
   * not reconcile a requirement against purchased stock without a bridge
   * between them, and the bridge was never populated. Allocation now compares
   * this against `PurchaseBillItem.rsProductId` and nothing else.
   *
   * Product level, never variant. Nullable, because `productName` remains the
   * authoritative label on the order and a line may legitimately name
   * something nobody has mapped to the catalogue yet — such a line simply
   * cannot take purchased stock until it is mapped.
   */
  rsProductId    String?
  productImageId String?
  quantity       Int
  /**
   * Units already supplied to the customer *outside* procurement — from a
   * previous despatch, a counter sale, whatever happened before this system
   * saw the order.
   *
   * Deliberately not derived from InventoryItem.onHand. Warehouse stock is
   * shared: ten on the shelf would otherwise appear to satisfy every order
   * needing that product at once, so three customers each wanting ten would
   * all read as fulfilled by the same ten units. A per-line count cannot make
   * that mistake.
   *
   * Fulfilment through procurement is *not* recorded here — that is the sum of
   * this line's PurchaseAllocation rows. Keeping the two apart is what stops a
   * second, drifting copy of the same total:
   *
   *     totalFulfilled = alreadyFulfilled + Σ allocations
   *     unfulfilled    = max(0, quantity - totalFulfilled)
   */
  alreadyFulfilled Int @default(0)

  /**
   * How many of this line's units the customer has called off.
   *
   * `quantity` is left alone deliberately and always means what was ORDERED —
   * overwriting it would destroy the only record of what was agreed, and the
   * remaining quantity is a subtraction anyone can do:
   *
   *     ordered   = quantity
   *     cancelled = cancelledQty
   *     remaining = quantity - cancelledQty
   *
   * It is also why nothing here reaches sales_order_money_guard. That trigger
   * computes the payable from `quantity * price`, so leaving `quantity` intact
   * means cancelling never drops the payable below what has already been paid
   * — which it would refuse. The order's ACTIVE value is derived in the
   * application from the remaining quantities, through the same
   * computeSalesTotals every other figure goes through, so there is no second
   * arithmetic anywhere.
   *
   * Bounded by sales_item_cancelled_within_quantity: several partial
   * cancellations can never sum past what was ordered.
   */
  cancelledQty Int @default(0)

  price          Decimal @db.Decimal(12, 2)

  /**
   * The HSN code as the seller records it, per line.
   *
   * TEXT, never a numeric type: codes carry leading zeros and alphanumeric
   * forms ("7418AB"), both of which an integer column would silently destroy.
   *
   * Nullable with no default, so "never recorded" stays distinguishable from
   * any recorded value. It lives on the line rather than on a product because
   * the same product can be billed under a different code on a different
   * order, and because the order is the document that must stay true to what
   * was issued.
   */
  hsnCode String?

  /**
   * The GST rate chosen for this line, as one of GST_RATES in @rs/shared:
   * 'NONE' | '0' | '5' | '12' | '18' | '28'.
   *
   * A plain nullable String rather than a Prisma enum, following
   * Customer.state: GST rates are set by policy and change, and an enum would
   * charge an ALTER TYPE migration for every revision. The shared z.enum is
   * what restricts the value, on both tiers.
   *
   * 'NONE' and '0' are deliberately different values and are never conflated:
   * "no GST decision recorded on this line" is not the same statement as "this
   * line is taxed at zero percent". Both are distinct again from NULL, which
   * means the line predates this field.
   *
   * Stored and displayed only. Nothing here enters a total: the order's money
   * is sum(quantity * price), enforced by the sales_order_money_guard trigger,
   * and this field does not appear in it.
   */
  gstRate String?

  /**
   * How THIS line's price is to be read: 'EXCLUSIVE' or 'INCLUSIVE', one of
   * GST_MODES in @rs/shared.
   *
   * Line level, not order level, and that is the point. One order routinely
   * carries goods bought on different terms — a product quoted at 5% plus tax
   * beside one quoted at 18% all-in — and they are still one document. An
   * order-level setting forced a quotation to be re-typed to say what it
   * already said.
   *
   * A plain String rather than a Prisma enum, following gstRate and state.
   * NOT NULL with a default, unlike gstRate: there is no honest 'not recorded'
   * answer, because no total can be worked out until a price is read one way
   * or the other. Rows that predate this column were backfilled from the
   * order-level setting they were created under, so no existing order's
   * arithmetic moved.
   */
  gstMode String @default("EXCLUSIVE")

  status SalesItemStatus @default(ACTIVE)

  /// Who put this line forward. Always set, including for lines created with
  /// the order itself.
  proposedById String
  /// Written together with approvedAt when the line is accepted.
  approvedById String?
  approvedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  order        SalesOrder  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  rsProduct    RsProduct?  @relation(fields: [rsProductId], references: [id], onDelete: SetNull)
  productImage MediaAsset? @relation("SalesItemImage", fields: [productImageId], references: [id], onDelete: SetNull)
  proposedBy   User        @relation("SalesItemProposedBy", fields: [proposedById], references: [id])
  approvedBy   User?       @relation("SalesItemApprovedBy", fields: [approvedById], references: [id])
  changeRequests SalesItemChangeRequest[]
  allocations    PurchaseAllocation[]
  /// Explanations the purchase person submitted for not covering this line.
  purchaseDelayReasons PurchaseDelayReason[]
  /// Which shipments carried this line, and how many units each took.
  dispatchItems DispatchItem[]
  /// Post-sales case lines naming this order line. Reverse side only; Restrict on
  /// the case item's foreign key, so no case can delete sales history.
  postSalesCaseItems PostSalesCaseItem[]

  @@unique([orderId, lineNo])
  @@index([orderId, status])
  @@index([rsProductId])
}

/// An order-level charge or adjustment: duty, packing, shipping, a discount.
///
/// A table rather than a column per kind, and deliberately. These are not six
/// fixed fields — an order can carry two different shipping legs, or none at
/// all, and the list of kinds is policy that will change. Six nullable columns
/// would answer 'how many shipping charges' with 'one, always', which is the
/// wrong shape for the question.
///
/// Each row is a positive amount. Whether it adds or subtracts follows from
/// `type` alone: DISCOUNT subtracts and every other kind adds. Storing a
/// negative amount for a discount was the alternative, and it makes every
/// report that sums this table depend on remembering the convention.
/// A proposed replacement for an order's charges, held apart from the charges
/// themselves until an approver acts.
///
/// Deliberately the same shape as SalesItemChangeRequest — same status enum,
/// same requestedBy/reviewedBy/reviewedAt/reviewNote pairing, same SALES ASSIGN
/// review capability — so the CRM has one approval idea rather than two. It is
/// a separate table only because what is proposed is a different thing: a line
/// request names one line, while charges are replaced as a whole set.
///
/// Nothing here is part of any total. A PENDING request moves no money, which is
/// the entire point: the order keeps charging what it already charged until
/// somebody with the authority to say otherwise says so.
model SalesChargeChangeRequest {
  id      String @id @default(cuid())
  orderId String

  status SalesChangeStatus @default(PENDING)

  /**
   * The complete proposed set, exactly as PUT /api/sales/:id/charges takes it:
   * an array of { type, label?, amount }.
   *
   * Json rather than child rows because it is a proposal, not a record — never
   * joined, never aggregated, never summed by the money guard. Child rows would
   * put rows that look exactly like real charges one foreign key away from the
   * real ones, which is the mistake this table exists to prevent. It is
   * re-validated against the shared schema before it is applied, so a
   * hand-edited row cannot become an approved charge.
   */
  proposedCharges Json

  requestedById String
  requestedAt   DateTime @default(now())

  /// Written together with reviewedAt when the request is decided, the same
  /// pairing SalesItemChangeRequest and PurchaseItemProductChange both use.
  reviewedById String?
  reviewedAt   DateTime?
  reviewNote   String?

  order       SalesOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  requestedBy User       @relation("ChargeChangeRequestedBy", fields: [requestedById], references: [id])
  reviewedBy  User?      @relation("ChargeChangeReviewedBy", fields: [reviewedById], references: [id])

  @@index([orderId, status])
}

/// One payment actually taken against an order.
///
/// A ledger beside `SalesOrder.paidAmount` rather than a replacement for it.
/// That column is what sales_order_money_guard reads, so it stays the figure
/// the database enforces; these rows are what the figure is made of, and the
/// service writes both in one transaction. Their sum equals it.
///
/// It exists because partial payments do: an order collected in three
/// instalments has three references, three dates and possibly three methods,
/// and a single column on the order can hold one of each at most. Rows that
/// predate this table were backfilled as one payment carrying the order's own
/// total, so the sum holds for history too — the amount is real, only the
/// instalment breakdown was never recorded.
model SalesPayment {
  id      String @id @default(cuid())
  orderId String

  /// Positive, always. A refund is a SalesRefund, never a negative payment —
  /// money going out is a different event with a different approver and its own
  /// state, and folding it in here would make `sum(amount)` stop meaning
  /// "what the customer has paid".
  amount Decimal @db.Decimal(14, 2)

  /// How this instalment arrived: one of PAYMENT_METHODS in @rs/shared. A
  /// plain String for the same reason SalesOrder.paymentMethod is one.
  /// Nullable: a payment recorded without stating a method is still a payment.
  method String?

  /**
   * The transaction reference — a UTR for UPI or a bank transfer, a cheque
   * number, whatever names this payment in somebody else's system.
   *
   * Free text, deliberately: the format differs per method and per bank, and a
   * pattern that rejected a valid reference would stop a real payment being
   * recorded. Nullable because cash has none.
   */
  reference String?

  /// Anything else worth saying about this instalment.
  note String?

  recordedById String
  recordedAt   DateTime @default(now())

  order      SalesOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  recordedBy User       @relation("SalesPaymentRecordedBy", fields: [recordedById], references: [id])

  @@index([orderId, recordedAt])
}

/// Money owed back to the customer, and whether it has actually gone.
///
/// Recording one does not move money and does not pretend to: there is no
/// payment gateway behind this CRM, so a refund is an internal record of a
/// decision and then of a settlement. PENDING says the customer is owed;
/// COMPLETED says somebody sent it and named the reference.
///
/// Deliberately NOT derived from cancellation. Cancelling an order says the
/// goods are not coming; whether money goes back, how much and when are
/// separate facts that somebody has to state — which is why a cancelled order
/// shows an amount refundable rather than an amount refunded.
model SalesRefund {
  id      String @id @default(cuid())
  orderId String

  amount Decimal @db.Decimal(14, 2)
  status SalesRefundStatus @default(PENDING)

  /// Why the money is owed back. Required, because a refund with no stated
  /// reason is unauditable.
  reason String

  /// How the money went back — a UTR, a cheque number, a cash receipt. Written
  /// with the settlement, and required by sales_refund_settled_recorded_together.
  reference String?
  note      String?

  requestedById String
  requestedAt   DateTime @default(now())

  /// Written together when the refund is settled or refused, the same pairing
  /// every other decision in this schema uses.
  settledById String?
  settledAt   DateTime?

  order       SalesOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  requestedBy User       @relation("SalesRefundRequestedBy", fields: [requestedById], references: [id])
  settledBy   User?      @relation("SalesRefundSettledBy", fields: [settledById], references: [id])

  @@index([orderId, status])
}

model SalesOrderCharge {
  id      String @id @default(cuid())
  orderId String

  /// One of SALES_CHARGE_TYPES in @rs/shared.
  type   String
  /// What this charge was for, in the seller's words. Optional.
  label  String?
  /// Always positive. The sign is carried by `type`, never by this column.
  amount Decimal @db.Decimal(12, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  order SalesOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

/// §45 — generic trail for everything without an enquiry parent: logins, user
/// management, vendor edits, permission changes.
model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  action     String
  entityType String
  entityId   String?
  oldValue   Json?
  newValue   Json?
  ip         String?
  userAgent  String?
  createdAt  DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id])

  @@index([entityType, entityId, createdAt])
  @@index([actorId, createdAt])
}

// ---------------------------------------------------------------------------
//  Product master & inventory
// ---------------------------------------------------------------------------

// ---------------------------------------------------------------------------
//  Purchase & Procurement
// ---------------------------------------------------------------------------

/// Credit or settled at purchase.
enum PurchaseBillType {
  CREDIT
  PAID_UP
}

/// A bill's progress. Deliberately linear, like the Sales lifecycle.
enum PurchaseBillStatus {
  OPEN
  RECEIVED
  CLOSED
}

/// Whether a recorded purchase bill has been signed off by an administrator.
///
/// A SEPARATE AXIS from PurchaseBillStatus above, deliberately, and not a value
/// added to it. That enum tracks how much of the goods have arrived — it is
/// derived from the lines by `receiveItem`, which recomputes it on every
/// receipt. A PENDING_APPROVAL member there would be overwritten by the next
/// receipt, and would also be unable to express the ordinary combination "fully
/// received, still awaiting sign-off". Arrival and authorisation are
/// independent facts about a bill and are stored independently.
///
/// Also distinct from ProductChangeStatus, which decides one proposed edit to
/// one line. This decides whether the bill itself is trusted.
enum BillApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

/// One bill from one vendor.
///
/// A procurement run that spans several vendors is several bills, which is how
/// the paperwork actually arrives: a vendor issues one bill for the goods they
/// supplied. "Multiple vendors" is therefore satisfied by multiple bills
/// against the same shortage, not by a vendor column on every line — that
/// would model one document as though it came from several suppliers.
model PurchaseBill {
  id String @id @default(cuid())

  /// As printed on the vendor's bill. Unique per vendor, not globally: two
  /// vendors can each have a bill numbered "001".
  billNumber String
  vendorId   String

  billType PurchaseBillType
  /// How much of the goods have arrived. Derived from the lines, never set by
  /// hand — see `receiveItem`.
  status   PurchaseBillStatus @default(OPEN)

  /// Whether an administrator has signed this bill off.
  ///
  /// Every newly recorded bill starts PENDING: recording one is procurement
  /// work, trusting it is not. Until it is APPROVED the bill exists, keeps all
  /// its figures and can be received against, but its stock cannot be allocated
  /// to a customer order — allocation is the point at which a bill starts
  /// committing goods to people, and that is what sign-off gates.
  ///
  /// Bills that predate this rule were backfilled to APPROVED by the migration
  /// that added the column, so nothing that was already usable stopped being
  /// usable. A `PENDING` default would otherwise have retro-suspended history.
  approvalStatus BillApprovalStatus @default(PENDING)

  /// Written together with reviewedAt when the bill is decided, the same
  /// pairing SalesItemChangeRequest and PurchaseItemProductChange both use.
  reviewedById String?
  reviewedAt   DateTime?
  /// Optional on approval; the only thing telling the recorder what to fix on a
  /// rejection.
  reviewNote   String?

  billDate DateTime
  /// When the goods were promised. A delay is measured against this.
  expectedBy DateTime?

  /// The photographed bill, through the existing Cloudinary/MediaAsset path.
  billImageId String?

  /// Set when the goods arrive later than expectedBy. The reason is mandatory
  /// whenever the flag is set — enforced by a CHECK, as elsewhere in the CRM.
  isDelayed   Boolean @default(false)
  delayReason String?

  notes String?

  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  vendor    Vendor             @relation(fields: [vendorId], references: [id])
  billImage MediaAsset?        @relation("PurchaseBillImage", fields: [billImageId], references: [id], onDelete: SetNull)
  createdBy User               @relation("PurchaseBillCreatedBy", fields: [createdById], references: [id])
  reviewedBy User?             @relation("PurchaseBillReviewedBy", fields: [reviewedById], references: [id])
  items     PurchaseBillItem[]
  productChanges PurchaseItemProductChange[]

  @@unique([vendorId, billNumber])
  @@index([status, billDate])
  /// The approval queue: pending bills, oldest first.
  @@index([approvalStatus, billDate])
  @@index([vendorId])
  @@index([isDelayed, billDate])
}

/// One product line on a purchase bill.
///
/// `receivedQty` is what actually arrived and is the only quantity that can be
/// allocated — ordering ten and receiving four must not let four become ten of
/// available stock. Standing quantity is `receivedQty` minus everything
/// allocated from this line.
model PurchaseBillItem {
  id     String @id @default(cuid())
  billId String
  /// Position on the bill; unique per bill, so concurrent adds cannot collide.
  lineNo Int

  /**
   * What the vendor's bill actually calls it.
   *
   * A purchase bill is a record of a document someone was handed, so the line
   * keeps the supplier's own description rather than a tidied catalogue name.
   * That is what makes the recorded bill checkable against the paper.
   */
  productName String

  /**
   * The RS Product this line is for — the CRM's one product identity.
   *
   * Replaced `productId`, which pointed at the legacy Product master and is
   * gone. Allocation compares this against `SalesOrderItem.rsProductId`; with
   * two identities it could compare neither without a bridge, and the bridge
   * was never populated.
   *
   * Product level, never variant: the Procurement-facing RS Products API
   * exposes stock as a product-level aggregate over the variants, so a variant
   * key would name something Procurement neither sees nor needs. SKU is not an
   * alternative either — nullable and legitimately duplicated across variants,
   * it identifies nothing.
   *
   * Optional at bill entry. A bill is typed up from a piece of paper, often
   * before anyone has decided what a line refers to, and forcing the decision
   * then would make recording a bill impossible until the catalogue was
   * curated. An unmapped line can be recorded and received; it cannot be
   * allocated until somebody maps it.
   */
  rsProductId String?

  /// What was ordered, and what turned up. received <= ordered (CHECK).
  orderedQty Int
  receivedQty Int @default(0)

  /// Per unit, NUMERIC so no floating point touches money.
  rate Decimal @db.Decimal(12, 2)

  /// How much of this line currently stands to the product's CRM stock.
  ///
  /// The whole of the stock model's idempotence lives in this one number. It is
  /// not a quantity anyone enters or reads; it is a record of what this line has
  /// already contributed, so every mutation can be expressed as a delta against
  /// a recomputed target rather than as a repeated addition:
  ///
  ///   target = approved && mapped ? receivedQty − Σ allocations : 0
  ///   delta  = target − stockedQty
  ///
  /// Receiving more, allocating, releasing an allocation, approving the bill and
  /// re-sending the same request all reduce to that subtraction, so none of them
  /// can double-count and a repeated call moves nothing. `receivedQty` alone
  /// could not do this: adding it on every receipt would credit the cumulative
  /// total again each time.
  ///
  /// Subtracting allocations is the business rule: stock already committed to a
  /// customer requirement never enters free CRM stock, so a bill receiving 5
  /// against a requirement of 1 contributes 4.
  ///
  /// Lines on bills that predate this column were backfilled to their current
  /// target, so nothing was retroactively credited or withdrawn.
  stockedQty Int @default(0)

  productImageId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bill         PurchaseBill         @relation(fields: [billId], references: [id], onDelete: Cascade)
  rsProduct    RsProduct?           @relation(fields: [rsProductId], references: [id], onDelete: SetNull)
  productImage MediaAsset?          @relation("PurchaseItemImage", fields: [productImageId], references: [id], onDelete: SetNull)
  allocations  PurchaseAllocation[]
  /// Requests to move this line from one RS Product to another. Only an
  /// approved one ever changes `rsProductId` above.
  productChanges PurchaseItemProductChange[]

  @@unique([billId, lineNo])
  @@index([rsProductId])
}

/// Where a mapped purchase line's RS Product may go, and who decided.
///
/// Three states and no way back: a decided request is a historical fact, so it
/// is never reopened. A second attempt is a second request, which keeps the
/// audit trail a list of what was actually asked rather than one row rewritten
/// until it was approved.
enum ProductChangeStatus {
  PENDING
  APPROVED
  REJECTED
}

/// A request to re-map an already-mapped purchase line to a different RS Product.
///
/// The asymmetry this model exists to express: giving an unmapped line its first
/// RS Product is ordinary Procurement work and happens immediately, but *moving*
/// a line that already names a product is not. By then the mapping has been read
/// by the shortage board, may have been allocated against, and is what allocation
/// compares identity on — so changing it silently would move stock between
/// products behind everyone's back. An administrator decides instead.
///
/// Like SalesItemChangeRequest, which this deliberately mirrors rather than
/// reinventing, a request is only ever a record of what somebody asked for. It
/// creates nothing and edits nothing; it cannot move a mapping however long it
/// sits pending. Only approval writes `PurchaseBillItem.rsProductId`, inside the
/// same transaction and row lock every other procurement mutation uses.
///
/// Both ends of the move are stored, not just the destination. `fromRsProductId`
/// is what the line said when the request was filed, and re-reading the line at
/// approval time would answer a different question — if someone released the
/// allocations and remapped in between, the request on file is no longer the one
/// being approved, and the stored value is what makes that visible.
model PurchaseItemProductChange {
  id     String @id @default(cuid())
  /// Denormalised from the item so pending requests can be listed for a bill
  /// without joining through every line.
  billId String
  itemId String

  /// The mapping as it stood when the request was filed. Never null: a line
  /// with no RS Product is mapped directly and needs no approval at all.
  fromRsProductId String
  /// What the requester wants it to become. Checked against RsProduct at both
  /// request and approval time — never a variant id, never a SKU.
  toRsProductId   String

  /// Why. Mandatory: an approver deciding whether goods were misidentified
  /// cannot do it from two product titles alone.
  reason String

  status ProductChangeStatus @default(PENDING)

  requestedById String
  requestedAt   DateTime @default(now())

  /// Written together with reviewedAt when the request is decided, the same
  /// pairing SalesItemChangeRequest uses.
  reviewedById String?
  reviewedAt   DateTime?
  reviewNote   String?

  bill          PurchaseBill     @relation(fields: [billId], references: [id], onDelete: Cascade)
  item          PurchaseBillItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  fromRsProduct RsProduct        @relation("ProductChangeFrom", fields: [fromRsProductId], references: [id])
  toRsProduct   RsProduct        @relation("ProductChangeTo", fields: [toRsProductId], references: [id])
  requestedBy   User             @relation("ProductChangeRequestedBy", fields: [requestedById], references: [id])
  reviewedBy    User?            @relation("ProductChangeReviewedBy", fields: [reviewedById], references: [id])

  @@index([status, requestedAt])
  @@index([itemId, status])
  @@index([billId, status])
}

/// Purchased stock assigned to one order line.
///
/// This is the join that makes one purchase serve many customers: a bill item
/// can carry several allocations to different orders, and an order line can be
/// filled from several bills. Both quantities it is checked against — the
/// line's remaining requirement and the bill item's standing quantity — are
/// read under a row lock before the row is written, so two people cannot spend
/// the same stock.
model PurchaseAllocation {
  id                 String @id @default(cuid())
  purchaseBillItemId String
  /// The order line being filled. Identity comes from the line, not a product
  /// name, so an allocation cannot drift onto the wrong requirement.
  salesOrderItemId   String

  quantity Int

  allocatedById String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  purchaseBillItem PurchaseBillItem @relation(fields: [purchaseBillItemId], references: [id], onDelete: Cascade)
  salesOrderItem   SalesOrderItem   @relation(fields: [salesOrderItemId], references: [id], onDelete: Cascade)
  allocatedBy      User             @relation("AllocationBy", fields: [allocatedById], references: [id])

  /// One row per (bill item, order line): a second allocation of the same
  /// stock to the same line is an edit, not a new row.
  @@unique([purchaseBillItemId, salesOrderItemId])
  @@index([salesOrderItemId])
}

// ---------------------------------------------------------------------------
//  Procurement Clock — a submodule of Purchase & Procurement
// ---------------------------------------------------------------------------

/// The factual result of procuring one order, measured against its deadline.
///
/// Its own type rather than SalesEfficiency: that one is decided by dispatch and
/// this one by coverage, and SalesEfficiency's own comment says such verdicts
/// "must stay free to diverge".
///
/// NOT immutable, and deliberately not called frozen. It states what happened
/// while the order is covered; if coverage is later lost — an allocation
/// released, an active line added — reconcileClock invalidates it rather than
/// leaving a claim standing that is no longer true. Only `deadline` never moves.
enum ProcurementVerdict {
  ON_TIME
  DELAYED
}

/// A delay reason somebody submitted and somebody else decided.
///
/// One vocabulary shared by both chains — the purchase person's item-level
/// reason and procurement's order-level one — exactly as SalesChangeStatus is
/// shared across two Sales tables. Three states and no way back: a decided
/// reason is a historical fact, and a second attempt is a second reason.
enum DelayReasonStatus {
  PENDING
  APPROVED
  REJECTED
}

/// The procurement clock for one sales order.
///
/// Holds a deadline and a completion result and NOTHING ELSE. Every quantity the
/// board shows — what is required, what is covered, what is still outstanding —
/// is computed at read time from the order's own lines, their `alreadyFulfilled`
/// and their PurchaseAllocation rows. There is no copy of the order, its
/// products, its quantities or its stock here, because a copy is how two screens
/// start disagreeing about what a customer bought.
///
/// The four states a reader sees are derived, which is why none of them is a
/// column: two of them are a comparison against the clock right now, and storing
/// those would need a sweep to flip them — an automatic action nobody asked for,
/// on a codebase with no scheduler.
model ProcurementClock {
  id      String @id @default(cuid())
  /// One clock per order, created inside the same transaction as the order.
  orderId String @unique

  /// T+2: the last instant of the IST day two days after the order's own
  /// orderDate. Written once at creation and never recomputed — a later edit to
  /// the order must not move the bar procurement was measured against.
  deadline DateTime

  /// When every remaining unit became covered. Null while anything is
  /// outstanding, and cleared again if coverage is lost.
  completedAt DateTime?
  verdict     ProcurementVerdict?

  /// True only on a row the migration backfilled from an order whose real
  /// completion instant was never recorded — one covered partly through
  /// `alreadyFulfilled`, which carries no timestamp of its own. The API and the
  /// UI label such a result as estimated, so a guess is never shown as a fact.
  /// Set false the first time reconcileClock writes a real completion.
  completionEstimated Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  order        SalesOrder               @relation(fields: [orderId], references: [id], onDelete: Cascade)
  delayReasons ProcurementDelayReason[]

  /// The board: outstanding orders by deadline, and completed ones by result.
  @@index([completedAt, deadline])
}

/// The purchase person's explanation for one order line they could not cover.
///
/// Per LINE, not per order: the person is late on specific goods, and an
/// order-level reason could not say which. Decided by PROCUREMENT ASSIGN and
/// never routed to an administrator.
model PurchaseDelayReason {
  id               String @id @default(cuid())
  salesOrderItemId String

  /// Why. Mandatory — an approver is accepting an explanation, and "late" is not
  /// one. Enforced by purchase_delay_reason_present as well as by Zod.
  reason String
  status DelayReasonStatus @default(PENDING)

  requestedById String
  requestedAt   DateTime @default(now())
  reviewedById  String?
  reviewedAt    DateTime?
  reviewNote    String?

  salesOrderItem SalesOrderItem @relation(fields: [salesOrderItemId], references: [id], onDelete: Cascade)
  requestedBy    User           @relation("PurchaseDelayRequestedBy", fields: [requestedById], references: [id])
  reviewedBy     User?          @relation("PurchaseDelayReviewedBy", fields: [reviewedById], references: [id])

  /// The queue: undecided reasons, oldest first.
  @@index([status, requestedAt])
  @@index([salesOrderItemId, status])
}

/// Procurement's own explanation for an order that was covered late.
///
/// Per ORDER, because the thing being explained is the order's outcome:
/// required only once the verdict is DELAYED. Decided by an administrator.
///
/// Held in its own table rather than beside the purchase reasons because the two
/// attach to different things and are decided by different people; folding them
/// together would make one row mean two workflows.
///
/// Nothing about deciding one writes `completedAt`, `verdict` or `deadline`. The
/// reason is an audit record that sits beside the result, and an approval cannot
/// turn DELAYED into ON_TIME.
model ProcurementDelayReason {
  id      String @id @default(cuid())
  clockId String

  reason String
  status DelayReasonStatus @default(PENDING)

  requestedById String
  requestedAt   DateTime @default(now())
  reviewedById  String?
  reviewedAt    DateTime?
  reviewNote    String?

  clock       ProcurementClock @relation(fields: [clockId], references: [id], onDelete: Cascade)
  requestedBy User             @relation("ProcurementDelayRequestedBy", fields: [requestedById], references: [id])
  reviewedBy  User?            @relation("ProcurementDelayReviewedBy", fields: [reviewedById], references: [id])

  @@index([status, requestedAt])
  @@index([clockId, status])
}

// ---------------------------------------------------------------------------
//  Notifications
// ---------------------------------------------------------------------------

/// What happened. One shared type rather than a per-module enum: a
/// notification is the same kind of thing whichever module raised it, and the
/// recipient's bell does not care where it came from.
enum NotificationType {
  ENQUIRY_ASSIGNED
  SALES_ORDER_CREATED
  /// Packing & Dispatch asking Procurement whether part of an order may go,
  /// and the ways that question is answered. AUTO_ALLOWED is its own member
  /// rather than a flag: permitted-by-deadline and agreed-by-a-person are
  /// different events, and the notice has to say which.
  PARTIAL_DISPATCH_REQUESTED
  PARTIAL_DISPATCH_ALLOWED
  PARTIAL_DISPATCH_DISALLOWED
  PARTIAL_DISPATCH_AUTO_ALLOWED

  /// Post Sales & Grievance. Three rather than one per event: the bell groups by
  /// type, and "a case needs you" is a different message from "a critical case
  /// was raised". Deliberately few — a notice per field edit would be spam.
  /// HR Phase 1 — three events, each telling somebody something they must act on
  /// or could not otherwise know. Creating an employee raises nothing: the HR team
  /// just did it, and a notice nobody needs is how a bell stops being read.
  HR_EMPLOYEE_ASSIGNED_TO_MANAGER
  HR_EMPLOYEE_ACCOUNT_LINKED
  HR_EMPLOYEE_STATUS_CHANGED

  POST_SALES_CASE_ASSIGNED
  POST_SALES_CASE_CRITICAL
  POST_SALES_CASE_REOPENED

  /// HR Phase 3 — five events, on the same test the Phase 1 three had to pass:
  /// does this tell somebody something they must act on and could not otherwise
  /// know? Each has a named recipient with a deadline attached.
  ///
  /// The larger half of the recruitment pipeline raises nothing, deliberately: a
  /// notice per stage change would put a dozen behind every hire and teach
  /// everybody to ignore the bell.
  HR_INTERVIEW_SCHEDULED
  HR_APPLICATION_DECISION_REQUIRED
  HR_ONBOARDING_TASK_ASSIGNED
  HR_PROBATION_REVIEW_DUE
  HR_PROBATION_ENDING

  /// HR Phase 4 — training. Five events, each with a named recipient who owes an
  /// action. Completing a lesson or failing a test raises nothing: the learner
  /// knows, and a notice nobody needs is how a bell stops being read.
  HR_TRAINING_ASSIGNED
  HR_TRAINING_OVERDUE
  HR_TRAINING_PRACTICAL_REVIEW_DUE
  HR_TRAINING_SHADOWING_SIGNOFF_DUE
  HR_TRAINING_QUALIFIED

  /// HR Phase 5 — performance. Five events, on the same test the earlier phases
  /// had to pass: does this tell somebody something they must act on and could
  /// not otherwise know?
  ///
  /// Saving a draft assessment raises nothing — the author knows. Finalisation
  /// does notify the employee, because a locked appraisal of them is exactly the
  /// thing they must be told about and can no longer influence.
  HR_REVIEW_CYCLE_OPENED
  HR_SELF_ASSESSMENT_DUE
  HR_MANAGER_REVIEW_DUE
  HR_REVIEW_FINALIZED
  HR_IMPROVEMENT_PLAN_OPENED

  /// HR Phase 6 — payroll. Four events, and the restraint matters more here than
  /// in any earlier phase: salary is the most sensitive data in the system and a
  /// notification is the one part of it that arrives unasked.
  ///
  /// **None of these ever carries an amount.** A notice lands in a bell a
  /// colleague may glance at, is often mirrored to email, and is retained in a
  /// table more people can read than can read a payslip. `payroll.notify.ts`
  /// enforces this with `assertNoAmount` and throws rather than sending.
  ///
  /// Deliberately absent: a notice per calculation or per employee line. The HR
  /// user running the payroll is watching the screen that reports it.
  HR_PAYROLL_APPROVAL_REQUIRED
  HR_PAYSLIP_AVAILABLE
  HR_PAYROLL_FINALIZED
  HR_PAYROLL_ADJUSTMENT_RECORDED

  /// Inventory Alerts. A notice carries the product, the SKU and the two
  /// numbers that matter; it never carries a cost price, because a bell is read
  /// by more people than may read what stock cost.
  INVENTORY_LOW_STOCK
  INVENTORY_STOCK_RECOVERED
}

/// One thing somebody should know about, addressed to one person.
///
/// The row is the record; the WebSocket is only how it arrives quickly. A
/// notification that was never delivered because the recipient was offline is
/// still here when they return, which is why persistence happens inside the
/// business transaction and delivery happens after it commits.
model Notification {
  id          String           @id @default(cuid())
  recipientId String
  type        NotificationType

  title String
  body  String
  /// Where clicking it goes. Stored rather than derived from type+entityId, so
  /// an old notification keeps working if routing later changes.
  href  String

  /// What it is about. Plain strings, not a relation: Prisma cannot model a
  /// polymorphic foreign key, and a real column per entity type would grow
  /// with every future notification kind.
  entityType String
  entityId   String

  /// Seen and cleared are different states, and neither implies the other:
  /// reading a notification does not remove it, and Clear All does not
  /// pretend the person read what it hides.
  readAt      DateTime?
  dismissedAt DateTime?

  createdAt DateTime @default(now())

  recipient User @relation(fields: [recipientId], references: [id], onDelete: Cascade)

  /// A retried request cannot raise the same notice twice for one person. The
  /// service treats the resulting P2002 as success rather than an error.
  @@unique([recipientId, type, entityId])
  /// The bell's own query: this person's undismissed notices, newest first.
  @@index([recipientId, dismissedAt, createdAt])
  /// Retention sweeps by age across every recipient.
  @@index([createdAt])
}

// ---------------------------------------------------------------------------
//  RS Products
// ---------------------------------------------------------------------------

/// Where a product came from, and therefore who owns its fields.
///
/// Sync writes only SHOPIFY rows. A MANUAL row is never updated or archived by
/// a sync pass, which is what stops Shopify overwriting a product somebody
/// created by hand in the CRM.
enum ProductSource {
  SHOPIFY
  MANUAL
}

/// Mirrors Shopify's own product status. ARCHIVED is how a deleted Shopify
/// product is recorded — see the note on RsProduct.
enum ShopifyProductStatus {
  ACTIVE
  ARCHIVED
  DRAFT
  /// Visible by direct link but hidden from collections and search. Shopify
  /// added it after this enum was first written, and the live catalogue holds
  /// 23 of them — without this value those products cannot be stored at all.
  /// Deliberately not folded into ACTIVE or DRAFT: it is neither, and
  /// collapsing it would lose the distinction the storefront actually makes.
  UNLISTED
}

/// The RS Products catalogue — intended to become the central Product Master.
///
/// Deliberately a separate table from `Product` rather than an extension of it.
/// `Product.name` and `Product.normalizedName` are both globally unique, and a
/// Shopify catalogue violates that on contact: variants routinely share a
/// product title, and any Shopify title matching an existing CRM product would
/// raise P2002 on the first sync. Relaxing those constraints would break the
/// identity design Procurement's resolver depends on, so the replacement is
/// built alongside and migrated onto deliberately, later.
///
/// Nothing here is written by a sync yet. Phase 2 is the data model only.
model RsProduct {
  id String @id @default(cuid())

  source ProductSource @default(SHOPIFY)

  /// Null for CRM-only products, which is why this cannot be the primary key.
  /// Unique so one Shopify product maps to exactly one row — identity is the
  /// Shopify id, never the title.
  shopifyProductId String? @unique

  /// Not unique, and that is the point: Shopify titles legitimately repeat, and
  /// enforcing uniqueness here would make sync fail on a real catalogue.
  title       String
  description String?

  status      ShopifyProductStatus @default(ACTIVE)
  productType String?
  vendor      String?

  /*
   * The bridge to the legacy Product Master is gone.
   *
   * It existed so a controlled migration would have somewhere to land, and it
   * was never populated — nought of five hundred and two rows. The migration
   * happened without it: Sales, Procurement and allocation were moved onto
   * RsProduct.id directly, so there is no second identity left to bridge to.
   * Keeping the column would have been a foreign key to a table this schema no
   * longer has any active reference to.
   */

  /// Shopify's own updatedAt, kept apart from ours: `updatedAt` says when this
  /// row changed, this says when the upstream product did. Sync compares the
  /// latter and cannot use the former.
  shopifyUpdatedAt DateTime?
  /// When a sync pass last wrote this row. Null for MANUAL products.
  syncedAt         DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  variants ShopifyVariant[]
  images   RsProductImage[]
  /// Which vendors supply this product, and at what current rate. Virtual —
  /// the foreign key lives on VendorProductMapping.
  vendorMappings VendorProductMapping[]
  /*
   * The three places the rest of the CRM names a product. All virtual: each
   * foreign key lives on the other table, and nothing on this one changes.
   *
   * These are what make RsProduct the single product identity — a purchase
   * line, an order line and a proposed change all point here, so allocation
   * can compare two of them directly instead of through a translation.
   */
  purchaseBillItems   PurchaseBillItem[]
  salesOrderItems     SalesOrderItem[]
  leadRequirements    LeadProductRequirement[]
  salesChangeRequests SalesItemChangeRequest[]
  /// Purchase-line re-mapping requests naming this product as the current
  /// mapping, and as the proposed one. Two relations because a single request
  /// references the product twice and Prisma cannot tell the ends apart.
  productChangesFrom  PurchaseItemProductChange[] @relation("ProductChangeFrom")
  productChangesTo    PurchaseItemProductChange[] @relation("ProductChangeTo")

  /// The catalogue list: live products of one origin.
  @@index([source, status])
  /// Search by name, which is a filter here rather than a unique constraint.
  @@index([title])
}

/// One sellable variant of an RsProduct.
///
/// A product is not one variant: SKU, price and inventory are all variant-level
/// in Shopify, so a product-level row could not carry them. CRM-only products
/// get a single variant rather than a special case.
model ShopifyVariant {
  id          String @id @default(cuid())
  rsProductId String

  /// Null for a CRM-only variant. Unique because it is the webhook lookup key.
  shopifyVariantId String? @unique

  /// The only key `inventory_levels/update` carries — that webhook names no
  /// product and no variant — so it is stored and uniquely indexed to make
  /// that message resolvable at all.
  shopifyInventoryItemId String? @unique

  /// Indexed, never unique: Shopify does not guarantee SKU uniqueness, and
  /// blank SKUs are ordinary. Several variants may hold null here.
  sku   String?
  title String?

  price Decimal @db.Decimal(12, 2)
  /// Shopify exposes cost on the inventory item rather than the variant, so
  /// this is fetched separately under read_inventory. Stored here because it
  /// describes the variant.
  costPrice Decimal? @db.Decimal(12, 2)

  // Weight as Shopify reports it, plus a normalised column so mixed units
  // still sort and filter together — matching EnquiryProduct's convention.
  weightValue   Decimal?    @db.Decimal(10, 3)
  weightUnit    WeightUnit?
  weightInGrams Decimal?    @db.Decimal(12, 3)

  // Structured, never a free-text string. Shopify's REST product API carries no
  // dimensions, so for a synced variant these arrive from metafields in a later
  // phase; a CRM-only product may record them immediately. Volume derives from
  // these rather than being stored.
  lengthValue   Decimal?       @db.Decimal(10, 2)
  widthValue    Decimal?       @db.Decimal(10, 2)
  heightValue   Decimal?       @db.Decimal(10, 2)
  dimensionUnit DimensionUnit?
  lengthMm      Decimal?       @db.Decimal(12, 2)
  widthMm       Decimal?       @db.Decimal(12, 2)
  heightMm      Decimal?       @db.Decimal(12, 2)

  /// Shopify's sellable quantity. Deliberately NOT InventoryItem.onHand, which
  /// is Procurement's manually maintained warehouse count feeding
  /// `received − allocated`. The two numbers mean different things, and writing
  /// one into the other would silently change Requirement-vs-Stock arithmetic
  /// in a shipped module.
  inventoryQty Int @default(0)

  /// When Shopify last changed this variant's inventory, as Shopify dated it.
  ///
  /// The guard against out-of-order webhooks. Shopify retries for up to four
  /// hours and does not guarantee delivery order, so two inventory events can
  /// arrive reversed — and without this the older quantity would win and stay
  /// wrong until the next change.
  ///
  /// Deliberately Shopify's clock, not ours: `updatedAt` records when this row
  /// changed, which says nothing about which event is newer. Null means no
  /// inventory webhook has been seen yet, so the first one always applies.
  inventoryUpdatedAt DateTime?

  /// Stock as the CRM counts it, maintained by hand.
  ///
  /// Deliberately separate from `inventoryQty` above, which is Shopify's and is
  /// overwritten by every sync pass and every inventory webhook. A manually
  /// entered count kept in that column would be destroyed by the next delivery,
  /// so it lives here where no Shopify writer ever reaches.
  ///
  /// Not null, defaulting to zero: every existing variant therefore starts at
  /// zero without a backfill, which is exactly the intended starting point.
  /// Never negative — the service refuses a negative value rather than
  /// clamping it, matching how InventoryItem.onHand is guarded.
  crmStockQty Int @default(0)

  position Int @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  rsProduct RsProduct @relation(fields: [rsProductId], references: [id], onDelete: Cascade)

  /*
   * Inventory Alerts. Both virtual — the foreign key lives on the other table,
   * and nothing on this one changes.
   *
   * `monitoring` cascades from here: a configuration for a variant that no
   * longer exists has nothing to monitor. `alerts` deliberately does NOT —
   * see the note on InventoryAlert. History outlives its subject.
   */
  monitoring MonitoredVariant?
  alerts     InventoryAlert[]

  @@index([rsProductId, position])
  @@index([sku])
}

/// A product image, referenced rather than stored.
///
/// Holds a Shopify CDN URL directly. MediaAsset is the wrong home for one: it
/// requires a unique Cloudinary publicId and an uploading CRM user, and a
/// Shopify URL has neither. Mirroring every image into Cloudinary would add
/// cost, latency and a failure mode while Shopify remains the source of truth.
///
/// This is not a second upload mechanism — it stores no uploads. Images a
/// person uploads for a CRM-only product go through the existing
/// /api/uploads → MediaAsset path.
model RsProductImage {
  id          String @id @default(cuid())
  rsProductId String

  /// Null for an image that did not come from Shopify.
  shopifyImageId String? @unique

  url      String
  altText  String?
  position Int     @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  rsProduct RsProduct @relation(fields: [rsProductId], references: [id], onDelete: Cascade)

  @@index([rsProductId, position])
}

/// Webhook idempotency, and nothing more.
///
/// Shopify retries a webhook for up to 48 hours, so duplicate delivery is
/// expected rather than exceptional. The unique webhookId makes a replay a
/// no-op: the second insert raises P2002, which the handler treats as "already
/// handled" and acknowledges.
///
/// processedAt and error record the outcome so a failure is visible without a
/// log search. Deliberately not a queue or a retry engine.
model ShopifyWebhookEvent {
  id String @id @default(cuid())

  /// The X-Shopify-Webhook-Id header. The whole point of the table.
  webhookId String @unique
  topic     String

  receivedAt  DateTime  @default(now())
  processedAt DateTime?
  /// Null when the event succeeded or is still in flight.
  error       String?

  /// When a worker took this event to process it.
  ///
  /// Without it, a row with `processedAt` and `error` both null is ambiguous:
  /// it could be a delivery being handled right now, or one whose process died
  /// mid-handler. Treating both as "somebody has it" loses the second kind
  /// permanently once Shopify stops retrying.
  ///
  /// Stamped when the claim is taken and re-stamped on each reclaim, so age is
  /// measured from the last attempt rather than from first arrival. A claim
  /// older than the stale threshold is assumed abandoned and may be taken over;
  /// a recent one is left alone.
  claimedAt DateTime?

  /// How many times processing has been attempted, for diagnosis and to stop a
  /// permanently failing event being retried without limit.
  attempts Int @default(0)

  /// Recent deliveries of one topic, for diagnosis.
  @@index([topic, receivedAt])
  /// The recovery sweep's own query: unfinished events, oldest claim first.
  @@index([processedAt, claimedAt])
}

// ===========================================================================
//  Packing & Dispatch
//
//  What this module owns: the physical movement of goods a customer has
//  already been committed. It records who packed an order, who sent it, by
//  which carrier and under which airway bill.
//
//  What it deliberately does NOT own is stock. `ShopifyVariant.crmStockQty`
//  has exactly one writer — reconcileLineStock in Procurement — and dispatch
//  is not it. Allocation already removed those goods from free stock when they
//  were committed to the order, so decrementing again here would count the same
//  units twice. Dispatch moves goods that are already spoken for.
//
//  Readiness is likewise not stored. Whether an order can be dispatched is
//  derived on read from the order's own lines through the same pendingQty and
//  fulfillmentStatus that Procurement's shortage board uses, so the two screens
//  cannot disagree about what a customer is still owed.
// ===========================================================================

/// Where a dispatch has reached.
///
/// DISPATCHED is terminal: goods that have left cannot be un-sent, and the
/// record of what was sent must stay true. CANCELLED is reachable only before
/// that point, for a pack that was started and abandoned.
enum DispatchStatus {
  DRAFT
  PACKING
  PACKED
  DISPATCHED
  CANCELLED
}

/// The life of a request to ship part of an order.
///
/// MOOT is the state that keeps the record honest. If the rest of the order
/// becomes ready while the request is still waiting, nobody needs to decide it
/// any more — but the request was really made, so it is resolved rather than
/// deleted, and never silently auto-allowed for a question that no longer
/// applies.
enum PartialDispatchStatus {
  PENDING
  ALLOWED
  DISALLOWED
  MOOT
}

/// One shipment of one order. An order may have several, each carrying part of
/// what was bought — which is what `isPartial` records.
model Dispatch {
  id           String @id @default(cuid())
  salesOrderId String

  status    DispatchStatus @default(DRAFT)
  /// True when this shipment deliberately carries less than the whole order.
  isPartial Boolean        @default(false)

  /// How it was booked. One of DISPATCH_CHANNELS in @rs/shared, with
  /// `channelOther` carrying the name when the answer is OTHER.
  ///
  /// A plain nullable String rather than a Prisma enum, following
  /// Customer.state and SalesOrderItem.gstRate: courier channels are a
  /// commercial list that changes, and an enum would charge an ALTER TYPE for
  /// every revision. The shared z.enum is what restricts the value.
  channel      String?
  channelOther String?

  /// Who is carrying it. One of DISPATCH_CARRIERS, same reasoning as above.
  carrier      String?
  carrierOther String?

  /// The airway bill. Optional while packing, required before the goods leave:
  /// a shipment nobody can trace is not dispatched, it is lost.
  awb String?

  packedById     String?
  packedAt       DateTime?
  dispatchedById String?
  dispatchedAt   DateTime?

  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  salesOrder   SalesOrder @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)
  packedBy     User?      @relation("DispatchPackedBy", fields: [packedById], references: [id])
  dispatchedBy User?      @relation("DispatchDispatchedBy", fields: [dispatchedById], references: [id])
  createdBy    User       @relation("DispatchCreatedBy", fields: [createdById], references: [id])
  items        DispatchItem[]
  /// Delivery-related post-sales cases referencing this shipment. Reverse side
  /// only, and read-only: Phase 1 creates and modifies no shipment.
  postSalesCases PostSalesCase[]

  /// One order's shipments, and the dispatch board's own queue.
  @@index([salesOrderId, status])
  @@index([status, createdAt])
}

/// What one shipment actually carries, line by line.
///
/// Quantities live here rather than on the order line because an order line can
/// be split across several shipments — five of a thing today and two next week
/// — and the order line must keep saying what was bought.
model DispatchItem {
  id               String @id @default(cuid())
  dispatchId       String
  salesOrderItemId String

  quantity Int

  dispatch       Dispatch       @relation(fields: [dispatchId], references: [id], onDelete: Cascade)
  salesOrderItem SalesOrderItem @relation(fields: [salesOrderItemId], references: [id], onDelete: Cascade)

  /// One line appears at most once in one shipment; splitting means a second
  /// shipment, not a second row here.
  @@unique([dispatchId, salesOrderItemId])
  @@index([salesOrderItemId])
}

/// Dispatch asking Procurement whether part of an order may go now.
///
/// Raised when some lines are ready and others are not. Procurement answers
/// within a deadline; if they do not, the request allows itself — see
/// `autoDecided`, which is what stops an unanswered question stalling goods
/// that are sitting packed.
model PartialDispatchRequest {
  id           String @id @default(cuid())
  salesOrderId String

  status PartialDispatchStatus @default(PENDING)

  requestedById String
  requestedAt   DateTime @default(now())

  /// When the answer stops being awaited, stored as an absolute instant.
  ///
  /// A column rather than a timer on purpose: a timer dies with the process,
  /// and a deadline that survives a restart is the whole point. The sweep runs
  /// at boot and periodically, so a process that was down across the deadline
  /// still catches up — the same design the notification retention sweep uses.
  deadline DateTime

  /// Null on an automatic decision, deliberately: nobody decided it, and
  /// naming somebody would be a fabrication.
  decidedById String?
  /// Set on every terminal state, including MOOT and the automatic allow.
  decidedAt   DateTime?

  /// Why. Required of a person either way; null when the deadline decided it.
  reason String?
  /// Plan of action. Required only when refusing — a refusal has to say what
  /// happens instead. Optional when allowing.
  poa String?

  /// True only for the deadline's own decision. What makes the dashboard able
  /// to say "allowed because Procurement did not respond", rather than
  /// implying somebody agreed.
  autoDecided Boolean @default(false)

  salesOrder  SalesOrder @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)
  requestedBy User       @relation("PartialDispatchRequestedBy", fields: [requestedById], references: [id])
  decidedBy   User?      @relation("PartialDispatchDecidedBy", fields: [decidedById], references: [id])

  /// The sweep's own query: still pending, deadline first.
  @@index([status, deadline])
  @@index([salesOrderId, status])
}

// ---------------------------------------------------------------------------
//  Create Lead / Deal
// ---------------------------------------------------------------------------

/// Where a lead came to us from.
///
/// A Prisma enum rather than a plain String because this is a fixed, small
/// vocabulary the business named in full, and it is paired with LEAD_SOURCES in
/// @rs/shared — add a member here and there together, never in one alone.
enum LeadSource {
  CALL
  WHATSAPP
  EMAIL
  ABANDONED_CART
  SOCIAL_MEDIA
  OTHER
}

/// What kind of business the lead is asking for.
///
/// Deliberately NOT CustomerType. The two vocabularies overlap in wording and
/// mean different things: CustomerType describes who somebody is on the
/// Customer master, while this describes what this particular enquiry is for —
/// the same retail customer can raise a corporate gifting lead.
enum RequirementType {
  RETAIL
  WHOLESALE
  EXPORT_RETAIL
  EXPORT_WHOLESALE
  CORPORATE_GIFTING
  PERSONAL_GIFTING
}

/// Where a lead ended up.
///
/// INPROCESS is the default and the only state a lead is born in — a deal that
/// has not been decided has not been lost. WON and LOST are terminal as far as
/// this phase is concerned; nothing here reopens one.
enum DealStatus {
  WON
  LOST
  INPROCESS
}

/// What kind of action one LeadActivity row records.
///
/// The three stages of the workflow the business described: the first time
/// somebody reaches the customer, each follow-up after that, and the final
/// conversation that produced a result. Kept as a vocabulary rather than three
/// tables because they differ only in meaning, never in shape — all three are
/// "an action that was due at one moment and happened at another".
enum LeadActivityKind {
  FIRST_CONTACT
  FOLLOW_UP
  RESULT
}

/// How closely a catalogue product answers what the customer asked for.
///
/// Null when no product has been matched yet, which is why the column is
/// nullable and paired with `rsProductId` by a CHECK constraint: a match kind
/// without a product would describe nothing, and a product without a kind would
/// not say whether it is what the customer wanted or merely the nearest thing.
enum ProductMatchKind {
  EXACT
  SIMILAR
}

/// A lead or deal, as first captured.
///
/// Phase 1 records where the enquiry came from, what kind of business it is,
/// who it is from, and which channel carried it. That is deliberately all:
/// there is no status, no owner, no follow-up, no products and no pipeline
/// stage, because those rules have not been specified and guessing at them
/// would put fields in the database that the business then has to work around.
///
/// The record is extensible without redesign — every future workflow field is
/// an additive column or a new related model, and none of them changes what is
/// written here.
model Lead {
  id String @id @default(cuid())

  /// How it reached us, with `leadSourceOther` carrying the written name when
  /// the answer is OTHER. The pairing is enforced by the shared schema in both
  /// directions, exactly as Dispatch does for channel and carrier.
  leadSource      LeadSource
  leadSourceOther String?

  /// A free-text reference for the source — a call note, a thread subject, an
  /// order number from an abandoned cart.
  ///
  /// Deliberately generic and optional. The team has not settled what this
  /// field means per source, so it is one neutral column rather than six
  /// speculative ones; naming it later costs a rename, not a redesign.
  sourceDetails String?

  /// When the enquiry actually happened, which is not when the row was made:
  /// a lead is often entered hours after the call. Stored as an absolute
  /// instant like every other DateTime in this schema.
  sourceAt DateTime

  requirementType RequirementType

  /// The existing Customer master, never a second copy of it. Restrict rather
  /// than Cascade: a customer with leads against them is referenced history,
  /// and deleting one should fail loudly rather than take the leads with it.
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)

  /// Which storefront or marketplace carried it. A plain String validated by
  /// the shared z.enum, following Dispatch's channel/carrier precedent: a
  /// commercial list that changes should not charge an ALTER TYPE per revision.
  channel      String
  channelOther String?

  createdById String
  createdBy   User   @relation("LeadCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  /// Where the deal ended up. Defaulted, so every existing row stays valid
  /// without a backfill: a lead captured before this column existed was, and
  /// still is, undecided.
  dealStatus DealStatus @default(INPROCESS)

  /// The associate who owns the lead, and whose promptness it counts toward.
  ///
  /// Nullable because an unassigned lead is a real state — and because every row
  /// that predates this column has no owner to name. Promptness stays NOT_RATED
  /// while this is null: a score has to be attributable to somebody.
  associateId String?
  associate   User?   @relation("LeadAssociate", fields: [associateId], references: [id], onDelete: Restrict)

  /// Who allocated it. With `associateId`, this is the whole of SELF vs OTHER
  /// USER — equal means somebody took their own lead, different means it was
  /// handed to them. Deliberately NOT a stored SELF/OTHER column: that would be
  /// a second copy of a fact these two already hold, free to disagree with them.
  allocatedById String?
  allocatedBy   User?   @relation("LeadAllocatedBy", fields: [allocatedById], references: [id], onDelete: Restrict)

  /// The order this lead became, once it became one.
  ///
  /// Unique: one order is the result of at most one lead. Order Value is read
  /// through this relation and never copied onto the lead — a stored figure
  /// would start disagreeing with the order the first time a charge changed.
  salesOrderId String?     @unique
  salesOrder   SalesOrder? @relation(fields: [salesOrderId], references: [id], onDelete: SetNull)

  activities   LeadActivity[]
  requirements LeadProductRequirement[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// One customer's leads, newest first — the only two reads Phase 1 has.
  @@index([customerId, createdAt])
  @@index([createdAt])
  /// The analytics table's own reads: one associate's work, and the board by
  /// status.
  @@index([associateId, createdAt])
  @@index([dealStatus, createdAt])
}

/// One expected action on a lead, and whether it happened on time.
///
/// THE SOURCE OF TRUTH FOR PROMPTNESS, and the reason no score is stored
/// anywhere. Two columns carry the whole rule:
///
///   `dueAt`       when the action was expected.
///   `completedAt` when it actually happened; null while it is outstanding.
///
/// From those, promptness is arithmetic over rows rather than a column that has
/// to be kept true:
///
///   expected = rows whose dueAt has passed
///   onTime   = those of them with completedAt <= dueAt
///
/// An action still in the future is not counted either way — it has not been
/// missed yet. One that is overdue and never completed stays in the denominator
/// and fails the numerator, which is what stops ignoring a lead from improving
/// its score.
///
/// The same deadline-and-actual shape as ProcurementClock, deliberately: that
/// model already proved it, and `procurementVerdict` already compares the pair.
model LeadActivity {
  id     String @id @default(cuid())
  leadId String

  kind LeadActivityKind

  /// What was expected, and when.
  dueAt DateTime
  /// Null while outstanding. Never defaulted to `now()` — "not done" and "done
  /// the moment the row was made" are different facts.
  completedAt DateTime?

  /// Who did it. Nullable: an action can be recorded as done before anybody
  /// says who closed it, and a user who leaves must not take the history.
  performedById String?
  performedBy   User?   @relation("LeadActivityPerformedBy", fields: [performedById], references: [id], onDelete: SetNull)

  note String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  /// One lead's timeline in order, and the promptness query's own shape.
  @@index([leadId, dueAt])
  @@index([completedAt, dueAt])
}

/// What the customer actually wants, line by line.
///
/// Borrows EnquiryProduct's field vocabulary exactly — same names, same
/// Decimal precisions, same raw-plus-normalised pairs — but NOT its table:
/// EnquiryProduct is keyed to ProductEnquiry, and attaching leads to it would
/// conflate two modules that happen to describe goods the same way.
///
/// `productName` is a snapshot and `rsProductId` a reference, both at once, on
/// the precedent SalesOrderItem already sets. That is not redundancy: a
/// requirement legitimately differs from the master — twelve of a ten-piece set,
/// 2.5 kg where the variant is 2 kg — so the snapshot preserves what was asked
/// for while the reference records what it was matched to.
///
/// Volume is deliberately absent. It is lengthMm × widthMm × heightMm, null if
/// any of the three is, and a stored copy would be a fourth number free to
/// disagree with the three it came from.
model LeadProductRequirement {
  id     String @id @default(cuid())
  leadId String
  lineNo Int

  /// What the customer asked for, in their words. Kept even when a catalogue
  /// product is matched, because the two are different facts.
  productName String

  imageId String?
  image   MediaAsset? @relation("LeadRequirementImage", fields: [imageId], references: [id], onDelete: SetNull)

  /// The catalogue product this was matched to, if one was. Product level like
  /// every other reference in the CRM, never variant. SetNull so retiring a
  /// product leaves the requirement readable rather than deleting it.
  rsProductId String?
  rsProduct   RsProduct? @relation(fields: [rsProductId], references: [id], onDelete: SetNull)

  /// EXACT or SIMILAR — one column, not two foreign keys. Two would permit a
  /// row that is both at once, and a boolean could not express "unmatched".
  /// Paired with `rsProductId` by a CHECK constraint in both directions.
  matchKind ProductMatchKind?

  quantity Int

  weightValue   Decimal?    @db.Decimal(10, 3)
  weightUnit    WeightUnit?
  weightInGrams Decimal?    @db.Decimal(12, 3)

  lengthValue   Decimal?       @db.Decimal(10, 2)
  widthValue    Decimal?       @db.Decimal(10, 2)
  heightValue   Decimal?       @db.Decimal(10, 2)
  dimensionUnit DimensionUnit?
  lengthMm      Decimal?       @db.Decimal(12, 2)
  widthMm       Decimal?       @db.Decimal(12, 2)
  heightMm      Decimal?       @db.Decimal(12, 2)

  /// What the customer's requirement is worth. Separate from the product's own
  /// price, which is the catalogue's figure and not necessarily this quote's.
  productValue Decimal? @db.Decimal(12, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  /// Line numbers are per lead, exactly as EnquiryProduct does per enquiry.
  @@unique([leadId, lineNo])
  @@index([rsProductId])
}

// ---------------------------------------------------------------------------
//  Post Sales & Grievance
// ---------------------------------------------------------------------------

/// What a case is about. Classification only — see POST_SALES_CASE_TYPES in
/// @rs/shared: REFUND means "this case concerns a refund", never "process one".
enum PostSalesCaseType {
  COMPLAINT
  RETURN
  REPLACEMENT
  REFUND
  EXCHANGE
  WARRANTY
  DELIVERY_ISSUE
  PRODUCT_QUESTION
  BILLING_ISSUE
  PAYMENT_ISSUE
  FEEDBACK
  SUGGESTION
  REVIEW_ISSUE
  OTHER
}

/// What went wrong. One flat enum rather than a category/subcategory pair: the
/// grouping is the UI's, and a second stored column could disagree with this one.
enum PostSalesIssueCategory {
  DAMAGED_PRODUCT
  MANUFACTURING_DEFECT
  FINISH_POLISH_ISSUE
  SIZE_ISSUE
  WRONG_SIZE
  WRONG_PRODUCT
  MISSING_PRODUCT
  MISSING_PART
  QUALITY_CONCERN
  LEAKAGE
  BREAKAGE
  DENT
  SCRATCH
  COATING_ISSUE
  COLOUR_DIFFERENCE
  PRODUCT_PERFORMANCE
  PRODUCT_USAGE_QUESTION
  PRODUCT_CARE_QUESTION
  DELAYED_DELIVERY
  DELIVERY_FAILED
  WRONG_ADDRESS
  COURIER_DAMAGE
  PACKAGE_DAMAGED
  PACKAGE_MISSING
  WRONG_PACKAGE
  PARTIAL_DELIVERY
  TRACKING_ISSUE
  WRONG_ITEM
  MISSING_ITEM
  QUANTITY_ISSUE
  ORDER_MODIFICATION
  CANCELLATION
  BILLING_ISSUE
  INVOICE_ISSUE
  PAYMENT_ISSUE
  RETURN_REQUEST
  REPLACEMENT_REQUEST
  REFUND_REQUEST
  EXCHANGE_REQUEST
  WARRANTY_REQUEST
  SERVICE_REQUEST
  DISSATISFACTION
  NEGATIVE_FEEDBACK
  SUGGESTION
  PRODUCT_FEEDBACK
  SERVICE_FEEDBACK
  OTHER
}

enum PostSalesPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

/// Where a case stands. The four AWAITING_* states name who it is blocked on,
/// which is what a board reader needs. None of them carries a timer: "overdue" is
/// deliberately not a status, because it is a fact about a clock and not about the
/// case. REOPENED is its own state so a case that came back is distinguishable
/// from one that never closed.
enum PostSalesCaseStatus {
  NEW
  ASSIGNED
  IN_PROGRESS
  AWAITING_CUSTOMER
  AWAITING_INTERNAL
  AWAITING_VENDOR
  AWAITING_COURIER
  RESOLUTION_IN_PROGRESS
  RESOLVED
  CLOSED
  REOPENED
}

/// One kind of timeline entry. SYSTEM, STATUS_CHANGE and ASSIGNMENT_CHANGE are
/// written by the service, which is why `performedById` below is nullable.
enum PostSalesActivityKind {
  SYSTEM
  NOTE
  INTERNAL_NOTE
  CUSTOMER_COMMUNICATION
  FOLLOW_UP
  STATUS_CHANGE
  ASSIGNMENT_CHANGE
}

/// How a logged conversation happened. A record, never a sending mechanism — no
/// WhatsApp, email or SMS integration exists, and this module does not pretend one
/// does.
enum PostSalesCommunicationChannel {
  PHONE
  WHATSAPP
  EMAIL
  SMS
  WEBSITE
  INSTAGRAM
  FACEBOOK
  MARKETPLACE
  IN_PERSON
  INTERNAL
}

enum PostSalesCommunicationDirection {
  INCOMING
  OUTGOING
}

enum PostSalesAttachmentKind {
  PRODUCT_PHOTO
  PACKAGING_PHOTO
  SCREENSHOT
  PAYMENT_PROOF
  DELIVERY_PROOF
  OTHER
}

/// Per-period counter for human-facing case numbers, exactly as EnquiryCounter
/// serves ENQ-. Its own row per period, bumped by an atomic upsert inside the
/// creating transaction — never COUNT(*) + 1, which two concurrent creates would
/// both read as the same value.
model PostSalesCaseCounter {
  period    String @id
  lastValue Int    @default(0)
}

/// One grievance, question or request raised after a sale.
///
/// The spine of the module. It copies nothing: the customer, the order, the lines
/// and the shipment are all references, so a case can never disagree with the
/// canonical record about who somebody is or what they bought.
///
/// ### What this deliberately does not store
///
///   * No order total, payment status, address or order date. All are read
///     through `salesOrder`, so a charge changing there cannot leave a stale
///     figure here — the same rule Lead follows for Order Value.
///   * No customer name, phone or email. `customer` is the canonical record.
///   * No product identity. That comes through `items` to SalesOrderItem and on
///     to RsProduct, which is the one product identity in this CRM.
///   * No SLA deadline, no breach flag, no CSAT score. Those are later phases,
///     and a column added on a guess is one the business has to work around.
model PostSalesCase {
  id String @id @default(cuid())

  /// `PS-2026-000001` — what people read out. The cuid above stays the key.
  caseNumber String @unique

  customerId String

  /// Optional, and that is the point: a product-care question or a piece of
  /// feedback may arrive with no order behind it, and requiring one would force
  /// somebody to attach an unrelated order to file a real case.
  salesOrderId String?

  /// Only for delivery-shaped cases. Read-only here — Phase 1 creates and
  /// modifies no shipment.
  dispatchId String?

  caseType      PostSalesCaseType
  issueCategory PostSalesIssueCategory
  priority      PostSalesPriority      @default(MEDIUM)
  status        PostSalesCaseStatus    @default(NEW)

  subject     String
  description String

  /// Who owns it now. History of who owned it before lives in AuditLog, which is
  /// why there is no assignment table — see `lead.assigned` for the precedent.
  assignedToId String?
  /// The authenticated actor who raised it. Never accepted from a client.
  raisedById   String

  /// Stamped by the service when the status actually reaches these states, so a
  /// timestamp cannot disagree with the status it describes.
  resolvedAt DateTime?
  closedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  customer   Customer    @relation(fields: [customerId], references: [id], onDelete: Restrict)
  salesOrder SalesOrder? @relation(fields: [salesOrderId], references: [id], onDelete: Restrict)
  dispatch   Dispatch?   @relation(fields: [dispatchId], references: [id], onDelete: SetNull)
  assignedTo User?       @relation("PostSalesAssignedTo", fields: [assignedToId], references: [id], onDelete: SetNull)
  raisedBy   User        @relation("PostSalesRaisedBy", fields: [raisedById], references: [id], onDelete: Restrict)

  items       PostSalesCaseItem[]
  activities  PostSalesActivity[]
  attachments PostSalesAttachment[]

  /// The board's own queries: the open queue, one person's workload, and a
  /// customer's history.
  @@index([status, createdAt])
  @@index([assignedToId, status])
  @@index([customerId, createdAt])
  @@index([salesOrderId])
  @@index([priority, status])
  @@index([createdAt])
}

/// Which order lines a case is about.
///
/// A join, carrying only the affected quantity. The product, SKU, price and image
/// all come from the line itself — duplicating them here would create a second
/// product identity, and the line must keep saying what was actually bought.
model PostSalesCaseItem {
  id     String @id @default(cuid())
  caseId String

  salesOrderItemId String

  /// How many of that line are affected. A subset of the line's own quantity: a
  /// complaint is usually about some of what arrived, not all of it.
  affectedQty Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Cascade from the case, Restrict toward the order line: removing a case must
  /// never reach sales history.
  case          PostSalesCase  @relation(fields: [caseId], references: [id], onDelete: Cascade)
  salesOrderItem SalesOrderItem @relation(fields: [salesOrderItemId], references: [id], onDelete: Restrict)

  /// One line at most once per case. A second entry for the same line is an edit
  /// of the quantity, not another affected line.
  @@unique([caseId, salesOrderItemId])
  @@index([salesOrderItemId])
}

/// One entry on a case's timeline.
///
/// Notes, internal notes, customer communications, follow-ups and the system's own
/// records, in one table discriminated by `kind`. They share every field that
/// matters and differ only in who may read them and whether they carry a deadline;
/// five tables would mean five queries to draw one timeline.
///
/// Patterned on LeadActivity but deliberately not that table: LeadActivity is
/// bound to `leadId` with a Lead-specific vocabulary, and sharing it would make
/// one module's semantics the other's constraint.
model PostSalesActivity {
  id     String @id @default(cuid())
  caseId String

  kind PostSalesActivityKind

  /// What happened, in the employee's words. Required: an entry that says nothing
  /// is not a record.
  note String

  /// Populated only for a CUSTOMER_COMMUNICATION; null on every other kind, which
  /// a CHECK constraint enforces.
  channel   PostSalesCommunicationChannel?
  direction PostSalesCommunicationDirection?

  /// Only meaningful on a FOLLOW_UP, which must carry one.
  dueAt       DateTime?
  /// When it was done. Null while outstanding — never defaulted to now, because
  /// "due" and "done" are different facts.
  completedAt DateTime?

  /// Null for the three kinds the service writes itself. A system record has no
  /// author, and naming one would be a fabrication.
  performedById String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  case        PostSalesCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  performedBy User?         @relation("PostSalesActivityBy", fields: [performedById], references: [id], onDelete: SetNull)

  /// One case's timeline in order, and the follow-up queue.
  @@index([caseId, createdAt])
  @@index([caseId, kind])
  @@index([completedAt, dueAt])
}

/// A case's link to an uploaded image.
///
/// A join to MediaAsset, which is the one upload store in this CRM. A separate
/// table rather than a column on the case, because a case carries several photos;
/// and a join rather than a new store, because Cloudinary already holds the bytes.
///
/// `mediaAssetId` is SetNull so a retired asset leaves the link readable as
/// history rather than deleting the record of what was attached. Removing an
/// attachment from a case deletes this row and never the asset — several tables
/// may reference the same one.
model PostSalesAttachment {
  id     String @id @default(cuid())
  caseId String

  mediaAssetId String?

  kind PostSalesAttachmentKind @default(OTHER)

  /// The authenticated uploader. SetNull so a departed employee's attachment
  /// stays attached.
  uploadedById String?

  createdAt DateTime @default(now())

  case       PostSalesCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  media      MediaAsset?   @relation("PostSalesAttachmentMedia", fields: [mediaAssetId], references: [id], onDelete: SetNull)
  uploadedBy User?         @relation("PostSalesAttachmentBy", fields: [uploadedById], references: [id], onDelete: SetNull)

  /// One asset at most once per case.
  @@unique([caseId, mediaAssetId])
  @@index([caseId, createdAt])
  @@index([mediaAssetId])
}

// ---------------------------------------------------------------------------
//  Cross-cutting foundation — approvals, settings, secure documents
// ---------------------------------------------------------------------------
//
// Three concerns that are not HR's alone and therefore do not live in an HR
// module. Each replaces something the codebase was doing by assumption:
//
//   ApprovalRequest  the whole approval "engine" was policies/approval.ts —
//                    `requiresApproval = actor.role !== 'ADMIN'`, four lines,
//                    with no record of who decided what or why.
//   HRSetting        working hours, leave quotas and payroll cycles were going
//                    to be constants in code, so changing one meant a deploy.
//   SecureDocument   MediaAsset has no access control of any kind and its
//                    Cloudinary URLs are publicly fetchable. Fine for product
//                    photos; unacceptable for a payslip.

/// Where one approval request stands. PENDING is the only state that can change.
///
/// CANCELLED exists so a requester can withdraw: deleting the row would destroy
/// the evidence that the request was ever made, and a withdrawn request is a
/// historical fact like any other decision.
enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

/// A request for somebody with authority to decide something.
///
/// Polymorphic on `entityType`/`entityId`, exactly as Notification and AuditLog
/// already are — the third use of a pattern this codebase has settled on, not a
/// new idea. A typed foreign key per approvable thing would mean a migration
/// and a nullable column for every future one.
///
/// What this is NOT: a workflow engine. There are no stages, no routing rules
/// and no delegation chains. One request, one decision, recorded. Multi-step
/// approval is a later decision that this table does not foreclose — a stage
/// column can be added additively — but inventing it now would mean guessing.
///
/// `module` and `action` are the existing AppModule and PermissionAction, so
/// "who may decide this" is answered by the RBAC resolver every other request
/// already obeys, rather than by a second authority model living here.
model ApprovalRequest {
  id String @id @default(cuid())

  /// What needs deciding. `entityType` is the model name as the service writes
  /// it ("LeaveRequest"), `entityId` that row's id. Unenforced by the database
  /// by necessity — the price of polymorphism, and the same price Notification
  /// and AuditLog already pay.
  entityType String
  entityId   String

  /// The permission that decides this request. A would-be approver needs
  /// `module` + APPROVE, resolved by permission.service.ts.
  module AppModule
  action PermissionAction @default(APPROVE)

  status ApprovalStatus @default(PENDING)

  /// Who asked. Not nullable: a request nobody made is not a request. Restrict
  /// rather than SetNull so the trail cannot be orphaned by a user delete — and
  /// users are deactivated rather than deleted in this system.
  requestedById String
  requestedAt   DateTime @default(now())

  /// Why it is being asked, in the requester's words. Optional: some requests
  /// are self-explanatory and a forced field would collect "n/a".
  reason String?

  /// What is being proposed, for requests that change values. Json because the
  /// shape differs per entity type, and because this is evidence to display
  /// rather than data to query.
  payload Json?

  /// Who decided, when, and what they said. All null while PENDING or CANCELLED
  /// and all present once APPROVED or REJECTED — the approval_decision_consistency
  /// CHECK enforces exactly that pairing, so there is no such thing as a decided
  /// request that cannot say who decided it. approval_decided_after_requested
  /// also forbids a decision that predates its own request.
  decidedById String?
  decidedAt   DateTime?
  decisionNote String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  requestedBy User  @relation("ApprovalRequestedBy", fields: [requestedById], references: [id], onDelete: Restrict)
  decidedBy   User? @relation("ApprovalDecidedBy", fields: [decidedById], references: [id], onDelete: Restrict)

  /// The approver's queue: everything still pending, oldest first.
  @@index([status, module, requestedAt])
  /// Every request against one thing, which is how a detail page shows history.
  @@index([entityType, entityId, requestedAt])
  @@index([requestedById, requestedAt])
  @@index([decidedById, decidedAt])
}

/// A configurable value, namespaced by module.
///
/// Key/value rather than a column per setting: HR alone needs working hours,
/// week-off patterns, leave quotas, probation lengths and payroll cycles, and a
/// column each would mean a migration per policy change. `value` is Json so a
/// setting can be a number, a string, a list of week-off days or a nested
/// object without five typed columns that are null four times out of five.
///
/// Deliberately not a generic AppSetting for the whole CRM: every existing
/// module's constants live in shared/src/constants and are contract values that
/// the database enforces again as CHECK constraints. Making those editable at
/// runtime would let somebody change a value the schema still enforces. This
/// table is for policy the business owns, not for contracts the code owns.
model HRSetting {
  id String @id @default(cuid())

  /// The namespace. An AppModule rather than a free string so a setting cannot
  /// be filed under a module that does not exist, and so reading "every setting
  /// this module owns" is a typed query.
  module AppModule

  /// Dotted within its module: "working_hours.start", "leave.annual_quota".
  key   String
  value Json

  /// What this controls, for whoever opens the settings screen in six months.
  description String?

  /// Who last changed it. SetNull so a departed administrator's change stays
  /// readable as history — the AuditLog carries the full before/after.
  updatedById String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  updatedBy User? @relation("HRSettingUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  /// One row per key per module. This is what makes a setting a setting rather
  /// than an append-only log of attempts to set it.
  @@unique([module, key])
  @@index([module])
}

/// What a secure document is, so access can be decided by kind.
///
/// Every member is something that must not be publicly fetchable. The list is
/// deliberately short and HR-shaped; it is not a general file taxonomy.
enum SecureDocumentKind {
  IDENTITY_PROOF
  ADDRESS_PROOF
  EDUCATION_CERTIFICATE
  EXPERIENCE_LETTER
  OFFER_LETTER
  APPOINTMENT_LETTER
  CONTRACT
  PAYSLIP
  TAX_DOCUMENT
  BANK_DETAIL
  MEDICAL_RECORD
  DISCIPLINARY_RECORD
  APPRAISAL
  RESUME
  OTHER
}

/// A file that must never be reachable without an authorised request.
///
/// ### Why this is not MediaAsset
///
/// MediaAsset carries no access control whatsoever: no owner beyond the
/// uploader, no kind, no notion of who may read it, and its `secureUrl` is a
/// plain Cloudinary delivery URL that anybody holding the link can fetch with no
/// CRM session. That is correct for a product photo, which is public anyway, and
/// it is why seven tables reference it happily.
///
/// A payslip or an Aadhaar scan cannot live there. Adding access control to
/// MediaAsset would change the delivery behaviour of product, enquiry, sales,
/// purchase, lead and post-sales images all at once — six shipped modules —
/// which is explicitly out of scope. So this is a second *table*, using the
/// same Cloudinary account and the same credentials, with `type: authenticated`
/// uploads and short-lived signed URLs. One storage provider, two access models.
///
/// ### What is deferred
///
/// There is no `employeeId` column and no relation to an Employee model, because
/// Employee does not exist until Phase 1 and inventing a placeholder would
/// create exactly the duplicate identity this phase forbids. Ownership is
/// therefore recorded polymorphically for now — `ownerType`/`ownerId`, the same
/// pattern as ApprovalRequest above — and Phase 1 adds the typed
/// EmployeeDocument relation additively, against an abstraction that already
/// works and is already tested.
model SecureDocument {
  id String @id @default(cuid())

  /// Cloudinary's identifier, which is what a signed URL is minted from. Unique
  /// because one stored object is one row.
  publicId String @unique

  /// Cloudinary's `type` — "authenticated" for everything this table stores.
  /// Recorded rather than assumed so a row that somehow arrived as a public
  /// upload is detectable instead of silently served. The
  /// secure_document_delivery_type CHECK restricts it to Cloudinary's two
  /// non-public types, so a caller that forgot to pass one — or passed 'upload',
  /// the public default — is refused by the database rather than producing a row
  /// this table promises is confidential and that is in fact world-readable.
  deliveryType String @default("authenticated")

  /// NOTE: there is deliberately no `secureUrl` column. Storing a URL is how
  /// MediaAsset became publicly fetchable — a stored link outlives every access
  /// check and cannot be revoked. URLs here are minted per request, signed, and
  /// expire; the only durable identifier is publicId above.

  kind SecureDocumentKind

  /// Which namespace governs this document. HR_PAYROLL on a payslip means
  /// reading it needs HR_PAYROLL + VIEW, so access is the existing RBAC
  /// resolver's answer rather than a rule invented in this module.
  module AppModule

  /// Whose document this is, polymorphically until Employee exists (see above).
  /// "User" + a user id is the only pair Phase 0.5 writes; Phase 1 adds
  /// "Employee".
  ownerType String
  ownerId   String

  /// Original filename as the uploader's machine had it, for display. Never
  /// used to build a path — publicId is the only thing that addresses the file.
  fileName String?
  mimeType String?
  bytes    Int?

  uploadedById String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  uploadedBy User @relation("SecureDocumentUploadedBy", fields: [uploadedById], references: [id], onDelete: Restrict)

  /// The HR metadata for this file, where it is an employee document.
  ///
  /// The reverse of a 1:1. Phase 0.5 anticipated exactly this: ownership here is
  /// polymorphic (`ownerType`/`ownerId`) precisely so a typed relation could be
  /// added once Employee existed, without this table learning what an employee is.
  /// Nothing about the storage or delivery model changes.
  employeeDocument EmployeeDocument?

  /// HR Phase 3, and the same extension point used twice more. A candidate's file
  /// and an offer letter are both stored objects with HR metadata beside them;
  /// neither teaches this table what a candidate or an offer is.
  candidateDocument CandidateDocument? @relation("CandidateDocumentFile")
  offer             Offer?             @relation("OfferLetter")

  /// HR Phase 4, and the same extension point again. Training material and a
  /// learner's practical artefact are both stored objects with metadata beside
  /// them; neither teaches this table what a course is, and neither gets a URL.
  trainingModules      TrainingModule[]      @relation("TrainingModuleMaterial")
  practicalSubmissions PracticalSubmission[] @relation("PracticalArtefact")

  @@index([ownerType, ownerId, createdAt])
  @@index([module, kind])
  @@index([uploadedById, createdAt])
}

// ---------------------------------------------------------------------------
//  HR & Workforce — Phase 1: Employee & Organization
// ---------------------------------------------------------------------------
//
// The first HR business module. It sits on the Phase 0.5 foundation — the seven
// HR_* AppModule namespaces, the APPROVE/EXPORT/SELF actions, SecureDocument,
// ApprovalRequest and HRSetting — and adds no second authentication, RBAC,
// notification, audit or storage system.
//
// ### Employee is not User
//
// `User` is the authenticated application account: an email, a password hash, a
// role, and the permission rows that decide what it may do. `Employee` is the
// HR record of a person the business employs. Most of the business's employees
// will never hold a CRM login, and a few logins (a shared operations account)
// belong to no single person, so the two are deliberately separate tables joined
// by an optional 1:1.
//
// No credential is duplicated into Employee. There is no password, no session,
// no role here — asking "may this person do X" always means asking the User and
// the existing permission resolver.

/// Whether an organizational record is still in use.
///
/// Shared by Department and Designation rather than one enum each: they are the
/// same question about the same kind of record, and two identical enums would
/// only mean two migrations the next time the answer changes. Neither is ever
/// deleted once employees reference it — ARCHIVED is how a department stops being
/// offered to new employees while its history stays readable.
enum OrgUnitStatus {
  ACTIVE
  ARCHIVED
}

/// Where an employee stands in their employment.
///
/// Deliberately short. The full offboarding lifecycle — notice periods, exit
/// interviews, clearance, final settlement — is Phase 7, and inventing its states
/// now would mean guessing at a process the business has not described.
///
/// ON_NOTICE is its own state rather than a flag on ACTIVE because the two read
/// differently to anybody planning work: somebody serving notice is still
/// employed and still assignable, but not for anything that outlives their
/// leaving date.
///
/// Nothing is ever deleted. An employee who leaves becomes EXITED and keeps every
/// row that references them — a departed person's history is the business's
/// record, not theirs.
enum EmployeeStatus {
  /// Offer accepted, start date in the future. Not yet countable as headcount.
  PROBATION
  ACTIVE
  ON_NOTICE
  /// Left, whatever the reason. Why is deliberately not modelled in Phase 1:
  /// resignation, termination and redundancy carry different process and
  /// different confidentiality, and conflating them in one enum value is more
  /// honest than pretending a single field captures the difference.
  EXITED
  /// Employed but not working — extended leave, sabbatical, suspension.
  INACTIVE
}

/// The contractual basis of employment.
enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERN
  CONSULTANT
}

/// Where the work happens.
enum WorkMode {
  ON_SITE
  REMOTE
  HYBRID
}

/// What one EmployeeHistory row records.
///
/// A fixed vocabulary rather than free text, so the timeline can be filtered and
/// so a reader can tell a transfer from a promotion without parsing prose. Each
/// member names something an HR person would recognise as an event in somebody's
/// employment — which is why there is no generic PROFILE_UPDATED: a changed phone
/// number is not an event, and recording it as one would bury the ones that matter.
enum EmployeeEventType {
  JOINED
  DEPARTMENT_CHANGED
  DESIGNATION_CHANGED
  MANAGER_CHANGED
  STATUS_CHANGED
  EMPLOYMENT_TYPE_CHANGED
  WORK_MODE_CHANGED
  USER_LINKED
  USER_UNLINKED
}

/// What an employee document is.
///
/// Narrower than SecureDocumentKind, which covers every confidential file the CRM
/// might hold. These are the ones an employee record carries, and the split keeps
/// an HR document picker from offering a payslip category Phase 1 does not produce.
enum EmployeeDocumentType {
  IDENTITY_PROOF
  ADDRESS_PROOF
  EDUCATION_CERTIFICATE
  EXPERIENCE_LETTER
  OFFER_LETTER
  APPOINTMENT_LETTER
  CONTRACT
  RESUME
  OTHER
}

/// Whether somebody has checked a document against the original.
enum DocumentVerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

/// A unit of the organization.
///
/// Self-referencing through `parentId` so a department can sit under another, with
/// SetNull rather than Cascade: dissolving a parent must not silently delete every
/// team inside it. Depth is not constrained by the database — the service refuses a
/// cycle, which is the failure that actually matters.
model Department {
  id   String @id @default(cuid())
  /// Human-facing name. Not unique: two companies' worth of history can contain
  /// two "Operations", and `code` is the identifier that must not collide.
  name String
  /// The stable business identifier, uppercase. Unique, and what a human quotes.
  code String @unique

  description String?
  status      OrgUnitStatus @default(ACTIVE)

  /// The department this one sits inside, if any.
  parentId String?

  /// The employee who heads it.
  ///
  /// SetNull, and deliberately nullable: a department between heads still exists.
  /// The relation is named because Employee points back at Department twice — once
  /// as the department it belongs to, once as the department it heads.
  headId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  parent   Department?  @relation("DepartmentHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children Department[] @relation("DepartmentHierarchy")
  head     Employee?    @relation("DepartmentHead", fields: [headId], references: [id], onDelete: SetNull)

  employees    Employee[]    @relation("EmployeeDepartment")
  designations Designation[]
  /// HR Phase 2 scoping: a holiday or policy may apply to one department.
  holidays          Holiday[]
  attendancePolicy  AttendancePolicy?
  leavePolicies     LeavePolicy[]
  /// HR Phase 3 — recruitment and onboarding. Reverse sides only.
  jobRequisitions   JobRequisition[]
  offers            Offer[]
  onboardingRecords OnboardingRecord[]
  /// HR Phase 4 — programs targeted at this department. Reverse side only.
  trainingPrograms  TrainingProgram[]  @relation("TrainingTargetDepartment")
  /// HR Phase 5 — performance. A cycle may cover one department, and a department
  /// may own goals of its own. Reverse sides only.
  reviewCycles      ReviewCycle[]      @relation("ReviewCycleDepartment")
  performanceGoals  PerformanceGoal[]  @relation("GoalDepartment")

  @@index([status, name])
  @@index([parentId])
  @@index([headId])
}

/// A job title, optionally scoped to a department.
model Designation {
  id   String @id @default(cuid())
  name String
  code String @unique

  description String?
  status      OrgUnitStatus @default(ACTIVE)

  /// The department this title belongs to, where it is department-specific.
  /// Nullable because titles like "Managing Director" belong to no one
  /// department. SetNull so archiving a department does not delete its titles.
  departmentId String?

  /// Seniority, for ordering a list and for nothing else.
  ///
  /// Explicitly NOT an authority model: a lower number does not grant anybody
  /// rights over a higher one. Reporting lines are `Employee.managerId`, and
  /// permissions are the existing RBAC. Conflating rank with access is how an org
  /// chart quietly becomes a permission system.
  level Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  department Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  employees  Employee[]  @relation("EmployeeDesignation")
  /// HR Phase 3 — recruitment and onboarding. Reverse sides only.
  jobRequisitions   JobRequisition[]
  offers            Offer[]
  onboardingRecords OnboardingRecord[]
  /// HR Phase 4 — programs targeted at this designation. Reverse side only.
  trainingPrograms  TrainingProgram[]  @relation("TrainingTargetDesignation")

  @@index([status, level, name])
  @@index([departmentId])
}

/// A person the business employs.
model Employee {
  id String @id @default(cuid())

  /// The HR business identifier — "RS001". Allocated from an atomic counter
  /// inside the creating transaction, never by reading the maximum and adding
  /// one: two simultaneous creates would both read the same maximum.
  employeeId String @unique

  /// The CRM login this person uses, if they have one.
  ///
  /// Unique, which is the whole safety property: one User maps to at most one
  /// Employee and one Employee to at most one User, enforced by the database
  /// rather than by a service remembering to check. Nullable because most
  /// employees never need a login, and SetNull so deactivating an account does
  /// not delete the person's HR record.
  userId String? @unique

  firstName  String
  middleName String?
  lastName   String

  /// Work contact. `workEmail` is unique — it is how colleagues address somebody
  /// and two people cannot share one. Personal contact details are kept to the
  /// minimum the business needs to reach somebody, and nothing more: no date of
  /// birth, no gender, no home address, no emergency contact in Phase 1. Each of
  /// those needs a stated purpose, a retention rule and a narrower read scope
  /// than "anybody with HR_EMPLOYEE:VIEW", and inventing them now would collect
  /// sensitive data before the rules that protect it exist.
  workEmail String  @unique
  phone     String?

  departmentId  String?
  designationId String?

  /// Who this person reports to.
  ///
  /// SetNull: a manager leaving must not delete their reports. Self-reference and
  /// cycles are refused by the service — Postgres cannot express "not an ancestor
  /// of itself" as a constraint, so that check lives where it can be tested.
  managerId String?

  employmentType EmploymentType @default(FULL_TIME)
  workMode       WorkMode       @default(ON_SITE)
  status         EmployeeStatus @default(ACTIVE)

  /// Where this person works from. Free text, like Customer.state: the list of
  /// offices is small, changes by business decision, and belongs in HRSetting
  /// rather than in a Postgres enum that cannot drop a value.
  location String?

  joiningDate DateTime
  /// The last working day. Null while employed; required once EXITED, which a
  /// CHECK enforces so a departed employee cannot lack a leaving date.
  exitDate    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user        User?        @relation("EmployeeAccount", fields: [userId], references: [id], onDelete: SetNull)
  department  Department?  @relation("EmployeeDepartment", fields: [departmentId], references: [id], onDelete: SetNull)
  designation Designation? @relation("EmployeeDesignation", fields: [designationId], references: [id], onDelete: SetNull)
  manager     Employee?    @relation("EmployeeHierarchy", fields: [managerId], references: [id], onDelete: SetNull)
  reports     Employee[]   @relation("EmployeeHierarchy")

  headedDepartments Department[]        @relation("DepartmentHead")
  history           EmployeeHistory[]
  documents         EmployeeDocument[]
  /// HR Phase 2 — attendance and leave. Reverse sides only; every key lives on
  /// the other table, and all of them reference this one Employee identity.
  attendanceRecords   AttendanceRecord[]
  attendanceCorrections AttendanceCorrectionRequest[]
  overtimeRecords     OvertimeRecord[]
  leaveBalances       LeaveBalance[]
  leaveRequests       LeaveRequest[]
  leaveLedgerEntries  LeaveLedgerEntry[]
  /// HR Phase 3 — recruitment, onboarding and probation. Reverse sides only.
  /// Every one of these points back at this single Employee identity: recruitment
  /// introduces a Candidate, never a second kind of employee.
  hiringManagerFor       JobRequisition[]       @relation("JobHiringManager")
  recruiterFor           JobRequisition[]       @relation("JobRecruiter")
  applicationsRecruiting Application[]          @relation("ApplicationRecruiter")
  applicationsHiring     Application[]          @relation("ApplicationHiringManager")
  interviewsLeading      Interview[]            @relation("InterviewLead")
  interviewsAttending    InterviewParticipant[] @relation("InterviewParticipant")
  interviewFeedback      InterviewFeedback[]    @relation("FeedbackBy")
  assessmentsReviewing   Assessment[]           @relation("AssessmentReviewer")
  onboardingRecord       OnboardingRecord?      @relation("OnboardingEmployee")
  onboardingManagerFor   OnboardingRecord[]     @relation("OnboardingManager")
  onboardingTasks        OnboardingTask[]       @relation("OnboardingTaskAssignee")
  probation              ProbationRecord?       @relation("ProbationEmployee")
  probationManagerFor    ProbationRecord[]      @relation("ProbationManager")
  probationReviews       ProbationReview[]      @relation("ProbationReviewer")
  /// HR Phase 4 — training. Reverse sides only. A learner, a practical reviewer and
  /// a shadowing mentor are all this same Employee identity: training introduces no
  /// mentor or trainer model of its own.
  trainingEnrollments    TrainingEnrollment[]   @relation("TrainingLearner")
  practicalsToReview     PracticalSubmission[]  @relation("PracticalReviewer")
  practicalsReviewed     PracticalSubmission[]  @relation("PracticalReviewedBy")
  shadowingAsMentor      ShadowingRecord[]      @relation("ShadowingMentor")
  shadowingSignedOff     ShadowingRecord[]      @relation("ShadowingSignedOffBy")
  /// HR Phase 5 — performance. Reverse sides only. The person appraised, the
  /// manager who appraises and the owner of a goal are all this same Employee
  /// identity: performance introduces no reviewer or appraisee model of its own.
  performanceReviews     PerformanceReview[]    @relation("PerformanceReviewEmployee")
  reviewsToWrite         PerformanceReview[]    @relation("PerformanceReviewReviewer")
  performanceGoals       PerformanceGoal[]      @relation("GoalEmployee")
  developmentPlans       DevelopmentPlan[]      @relation("DevelopmentPlanEmployee")

  /// Phase 6 — payroll. Salary assignments are append-only, so this relation is a
  /// history rather than a current value; `payrollItems` is every run this person
  /// has appeared in.
  salaryAssignments  EmployeeSalary[]     @relation("EmployeeSalaryEmployee")
  payrollItems       PayrollItem[]        @relation("PayrollItemEmployee")
  payrollAdjustments PayrollAdjustment[]  @relation("PayrollAdjustmentEmployee")

  /// The directory's default ordering and its commonest filters.
  @@index([status, lastName, firstName])
  @@index([departmentId, status])
  @@index([designationId])
  @@index([managerId])
}

/// One allocated employee-id sequence.
///
/// A counter table rather than a scan of Employee, for the reason the Post Sales
/// case counter exists: `SELECT max(...) + 1` read by two concurrent creates
/// returns the same number to both. `INSERT … ON CONFLICT DO UPDATE … RETURNING`
/// inside the creating transaction cannot.
///
/// `prefix` is the key so the scheme can change — a second prefix is a second row,
/// not a migration.
model EmployeeIdCounter {
  prefix    String   @id
  lastValue Int
  updatedAt DateTime @updatedAt
}

/// One recorded change in somebody's employment.
///
/// Append-only by intent: rows are written, never updated or deleted, so the
/// timeline is what actually happened rather than what the record currently says.
/// There is no `updatedAt` for that reason.
///
/// `fromValue`/`toValue` are display strings, not ids — "Sales" rather than a cuid
/// — so the timeline stays readable after a department is renamed or archived, and
/// so reading it needs no joins. Never any salary, bank detail, token or secret:
/// Phase 1 holds none of those, and history is the wrong place for them regardless.
model EmployeeHistory {
  id         String            @id @default(cuid())
  employeeId String
  eventType  EmployeeEventType

  fromValue String?
  toValue   String?
  /// Why, where somebody gave a reason.
  note      String?

  /// Who made the change. SetNull so a departed administrator's entry stays
  /// readable — the AuditLog carries the full before/after either way.
  performedById String?

  /// When the change happened, which is not always when the row was written.
  effectiveAt DateTime @default(now())
  createdAt   DateTime @default(now())

  employee    Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  performedBy User?    @relation("EmployeeHistoryBy", fields: [performedById], references: [id], onDelete: SetNull)

  @@index([employeeId, effectiveAt])
  @@index([eventType])
}

/// Metadata for one confidential file belonging to an employee.
///
/// The bytes are NOT here. They are in SecureDocument, which Phase 0.5 built:
/// authenticated Cloudinary delivery, no stored URL, short-lived signed links.
/// This table adds only what HR needs that a generic document store should not
/// know — which employee, what kind, issued when, expiring when, verified by whom.
///
/// `secureDocumentId` is unique: one stored file is one employee document. Cascade
/// on delete, because metadata about a file that no longer exists is debris.
model EmployeeDocument {
  id         String @id @default(cuid())
  employeeId String

  /// The stored file. Required — an employee document with no document is a row
  /// with nothing in it.
  secureDocumentId String @unique

  documentType EmployeeDocumentType
  /// What to call it in a list, where the file name is unhelpful.
  title        String

  issuedOn  DateTime?
  /// When this document stops being valid, for the ones that expire — a visa, a
  /// certification. Null means "does not expire", not "unknown".
  expiresOn DateTime?

  verificationStatus DocumentVerificationStatus @default(PENDING)
  verifiedById       String?
  verifiedAt         DateTime?

  uploadedById String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  employee       Employee       @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  secureDocument SecureDocument @relation(fields: [secureDocumentId], references: [id], onDelete: Cascade)
  verifiedBy     User?          @relation("EmployeeDocumentVerifiedBy", fields: [verifiedById], references: [id], onDelete: SetNull)
  uploadedBy     User           @relation("EmployeeDocumentUploadedBy", fields: [uploadedById], references: [id], onDelete: Restrict)

  @@index([employeeId, documentType])
  @@index([verificationStatus])
  @@index([expiresOn])
}

// ---------------------------------------------------------------------------
//  HR Phase 2 — Attendance & Leave
// ---------------------------------------------------------------------------
//
// Built on the Phase 1 Employee. Every record here references that one identity;
// there is no second employee, department or manager hierarchy.
//
// ### Time, which attendance lives or dies by
//
// Two different kinds of value, deliberately typed and named differently:
//
//   *instants*  — clockInAt, clockOutAt, startedAt. Real moments, stored as
//                 timestamps, always taken from Postgres `now()` via
//                 databaseNow(). A client-supplied time is never authoritative:
//                 a browser clock can be wrong by hours or be deliberately set.
//
//   *dates*     — attendanceDate, startDate, holidayDate. Calendar days, not
//                 moments. Stored at midnight UTC and *interpreted in IST*,
//                 the fixed +5:30 the business works in, exactly as
//                 sales-efficiency.ts already treats dispatch deadlines and
//                 frontend/lib/format.ts already renders every timestamp.
//
// Conflating the two is the classic attendance bug: somebody clocking in at
// 00:30 IST is on today's date, but 19:00 UTC yesterday.
//
// ### What Phase 2 deliberately does not do
//
// No payroll, salary, payout or encashment. Overtime and leave balances are
// recorded so a future Payroll phase can consume them, and nothing here turns a
// minute or a day into money.

/// What an employee's day was, as a fact about attendance.
///
/// Deliberately separate from WorkMode below. "Present" and "worked from home"
/// are different questions — somebody can be PRESENT and REMOTE, or ABSENT with
/// no work mode at all — and one enum carrying both would make "present in the
/// office" and "present at home" different statuses, so every query about
/// presence would have to enumerate work modes.
enum AttendanceStatus {
  PRESENT
  ABSENT
  HALF_DAY
  /// Covered by an approved leave. Set by resolution, never by a clock-in.
  LEAVE
  HOLIDAY
  WEEK_OFF
}

/// Where the work actually happened on one particular day.
///
/// Deliberately NOT the Phase 1 `WorkMode`, which is the employee's contractual
/// arrangement (ON_SITE / REMOTE / HYBRID). A HYBRID employee works some days in
/// the office and some at home, so "what is their arrangement" and "where were
/// they today" are different questions and one enum cannot answer both — a
/// HYBRID value on an attendance row would say nothing about that day.
enum AttendanceWorkMode {
  OFFICE
  WFH
  REMOTE
}

/// Where an attendance record is in its day.
///
/// Distinct from AttendanceStatus: this is about the *session* — has the person
/// clocked in, are they on a break, have they finished — while the status is the
/// verdict on the day. A record is OPEN between clock-in and clock-out, and the
/// state machine below is what makes a double clock-in impossible.
enum AttendanceSessionState {
  /// Clocked in, working.
  OPEN
  /// Clocked in, currently on a break.
  ON_BREAK
  /// Clocked out. Terminal for the day unless a correction reopens it.
  CLOSED
  /// No session — a holiday, week-off, leave or absence record.
  NONE
}

/// Why an attendance record says what it says.
///
/// Matters because an auto-resolved ABSENT and a manually corrected one are very
/// different claims, and a later Payroll phase must be able to tell them apart.
enum AttendanceSource {
  /// The employee clocked in and out themselves.
  SELF
  /// Written by the resolution service — holiday, week-off, leave or absence.
  SYSTEM
  /// Written or amended by HR.
  MANUAL
  /// Amended through an approved correction request.
  CORRECTION
}

enum AttendanceCorrectionStatus {
  PENDING
  APPROVED
  REJECTED
  /// Withdrawn by the requester before anybody decided.
  CANCELLED
}

enum OvertimeStatus {
  PENDING
  APPROVED
  REJECTED
}

enum LeaveRequestStatus {
  PENDING
  APPROVED
  REJECTED
  /// Withdrawn by the requester, or cancelled after approval by policy.
  CANCELLED
}

/// Which half of the day a half-day leave covers.
///
/// Required whenever a request is a half day, which a CHECK enforces: "half a
/// day off" without saying which half cannot be rostered against.
enum HalfDayPeriod {
  FIRST_HALF
  SECOND_HALF
}

/// What moved a leave balance.
///
/// The ledger's vocabulary. Every balance change is one of these, so a balance is
/// always explainable by replaying its rows rather than being a number somebody
/// edited.
enum LeaveLedgerReason {
  /// Opening entitlement for a period.
  ALLOCATION
  /// Periodic accrual.
  ACCRUAL
  /// Brought in from the previous period.
  CARRY_FORWARD
  /// Held while a request awaits a decision.
  RESERVATION
  /// A reservation released — the request was rejected or cancelled.
  RESERVATION_RELEASE
  /// Consumed by an approved leave.
  CONSUMPTION
  /// Returned because an approved leave was cancelled.
  CONSUMPTION_REVERSAL
  /// A deliberate HR correction.
  ADJUSTMENT
  /// Expired at period end rather than carried.
  LAPSE
}

/// One employee's day.
///
/// Exactly one row per employee per date — enforced by a unique index, not by an
/// application check, because two concurrent clock-ins would otherwise both read
/// "no record" and both insert.
model AttendanceRecord {
  id         String @id @default(cuid())
  employeeId String

  /// The calendar day in IST, stored at midnight UTC. Not an instant.
  attendanceDate DateTime @db.Date

  status       AttendanceStatus
  workMode     AttendanceWorkMode?
  sessionState AttendanceSessionState @default(NONE)
  source       AttendanceSource       @default(SYSTEM)

  /// Real moments, always from Postgres `now()`.
  clockInAt  DateTime?
  clockOutAt DateTime?

  /// Derived at clock-out and stored, which is the one deliberate exception to
  /// this codebase's derive-don't-store rule. The inputs are the policy's
  /// expected hours and grace period, and a policy legitimately changes over
  /// time — recomputing a 2024 day against a 2026 policy would silently rewrite
  /// history. These are frozen facts about what happened under the rules then.
  workedMinutes    Int @default(0)
  breakMinutes     Int @default(0)
  lateMinutes      Int @default(0)
  earlyExitMinutes Int @default(0)
  overtimeMinutes  Int @default(0)

  /// The leave that covers this day, where one does. SetNull so cancelling a
  /// leave leaves the day resolvable rather than deleting the attendance row.
  leaveRequestId String?

  remarks String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  employee     Employee       @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveRequest LeaveRequest?  @relation(fields: [leaveRequestId], references: [id], onDelete: SetNull)
  breaks       AttendanceBreak[]
  corrections  AttendanceCorrectionRequest[]

  /// One day, one record. The constraint that makes clock-in safe.
  @@unique([employeeId, attendanceDate])
  /// The directory's commonest query: one employee over a date range.
  @@index([employeeId, attendanceDate])
  /// And the team view: everybody on one date.
  @@index([attendanceDate, status])
  @@index([leaveRequestId])
}

/// One break within a day.
///
/// A table rather than a running total on the record, because "how long were the
/// breaks" and "when were they" are different questions and the second cannot be
/// answered by a number. The partial unique index in the migration allows at most
/// one open break per record, so a double break-start is refused by the database.
model AttendanceBreak {
  id                 String @id @default(cuid())
  attendanceRecordId String

  startedAt DateTime
  endedAt   DateTime?

  /// Frozen at break end, for the same reason the record's minutes are.
  minutes Int?

  createdAt DateTime @default(now())

  attendanceRecord AttendanceRecord @relation(fields: [attendanceRecordId], references: [id], onDelete: Cascade)

  @@index([attendanceRecordId, startedAt])
}

/// "I forgot to clock out."
///
/// Holds what was there and what is asked for, so a reviewer sees both without
/// the record having to be mutated first. The decision writes the attendance and
/// the status in one transaction — a request that said APPROVED while the record
/// was unchanged would be worse than no workflow at all.
model AttendanceCorrectionRequest {
  id                 String  @id @default(cuid())
  attendanceRecordId String?
  employeeId         String

  /// The day being corrected. Kept even when the record is absent, because the
  /// commonest correction is for a day with no record at all.
  attendanceDate DateTime @db.Date

  /// What the record held when the request was raised, for the reviewer's
  /// benefit and as evidence afterwards. Null where there was no record.
  currentClockInAt  DateTime?
  currentClockOutAt DateTime?

  requestedClockInAt  DateTime?
  requestedClockOutAt DateTime?
  requestedWorkMode   AttendanceWorkMode?

  /// Required — a correction nobody explained is one nobody can review.
  reason String

  status AttendanceCorrectionStatus @default(PENDING)

  /// Who decided and what they said. All null while PENDING, all present once
  /// decided — paired by a CHECK, as the Phase 0.5 approval trail is.
  decidedById    String?
  decidedAt      DateTime?
  decisionNote   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  attendanceRecord AttendanceRecord? @relation(fields: [attendanceRecordId], references: [id], onDelete: SetNull)
  employee         Employee          @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  decidedBy        User?             @relation("AttendanceCorrectionDecidedBy", fields: [decidedById], references: [id], onDelete: SetNull)

  @@index([employeeId, attendanceDate])
  @@index([status, createdAt])
}

/// Extra hours worked, recorded for a future Payroll phase to consume.
///
/// Phase 2 records and approves; it computes no money. The hours come from the
/// attendance record's overtimeMinutes, so this is a decision about hours already
/// measured rather than a second measurement.
model OvertimeRecord {
  id         String @id @default(cuid())
  employeeId String

  overtimeDate DateTime @db.Date
  minutes      Int

  status OvertimeStatus @default(PENDING)
  source AttendanceSource @default(SYSTEM)

  remarks String?

  decidedById String?
  decidedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  employee  Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  decidedBy User?    @relation("OvertimeDecidedBy", fields: [decidedById], references: [id], onDelete: SetNull)

  @@unique([employeeId, overtimeDate])
  @@index([status, overtimeDate])
}

/// A company holiday.
///
/// Configurable rather than a hard-coded national calendar: the business decides
/// which days it closes, and those differ by company, year and location. Scope is
/// deliberately simple — an optional department — rather than a full location and
/// calendar model nobody has asked for yet.
model Holiday {
  id   String @id @default(cuid())
  name String

  holidayDate DateTime @db.Date

  description String?
  isActive    Boolean @default(true)

  /// Null means "the whole company". A department-scoped holiday applies only to
  /// that department's employees.
  departmentId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  department Department? @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  /// One holiday per date per scope. A partial unique index in the migration
  /// handles the company-wide (null department) case, which a plain composite
  /// unique cannot because NULLs never collide in Postgres.
  @@index([holidayDate, isActive])
  @@index([departmentId])
}

/// When the company expects people to work.
///
/// A focused model rather than rules scattered in code or a general policy
/// engine: expected hours, grace and thresholds are exactly the values that
/// change by business decision, and hard-coding "09:30 to 18:30" would mean a
/// deploy to change an office's hours.
///
/// Times are minutes from midnight IST, not timestamps — "09:30" is a wall-clock
/// rule that applies every day, and storing it as a Date would attach it to one.
model AttendancePolicy {
  id   String @id @default(cuid())
  name String
  code String @unique

  /// Minutes from midnight IST. 570 = 09:30, 1110 = 18:30.
  expectedStartMinute Int @default(570)
  expectedEndMinute   Int @default(1110)

  /// How late somebody may be before it counts as late.
  graceMinutes Int @default(15)

  /// Minimum worked minutes for a full day, and for a half day. Below the half
  /// threshold the day is ABSENT; between the two it is HALF_DAY.
  fullDayMinutes Int @default(480)
  halfDayMinutes Int @default(240)

  /// Worked minutes beyond this count as overtime.
  overtimeThresholdMinutes Int @default(540)

  /// Which weekdays are off, as ISO numbers (1 = Monday … 7 = Sunday).
  ///
  /// An array rather than seven booleans or a separate table: a week-off pattern
  /// is read as a whole, never queried by individual day, and "Saturday and
  /// Sunday" is one value rather than seven rows. Deliberately not assumed —
  /// plenty of businesses work Saturdays.
  weekOffDays Int[] @default([6, 7])

  isActive Boolean @default(true)
  /// Exactly one policy is the company default, enforced by a partial unique
  /// index. An employee with no department policy falls back to it.
  isDefault Boolean @default(false)

  /// Null means company-wide. A department policy wins over the default.
  departmentId String? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  department Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)

  @@index([isActive])
}

/// A kind of leave.
model LeaveType {
  id   String @id @default(cuid())
  name String
  code String @unique

  description String?

  /// Whether the day is paid. Recorded for a future Payroll phase; Phase 2
  /// computes no money from it.
  isPaid   Boolean @default(true)
  isActive Boolean @default(true)

  halfDayAllowed   Boolean @default(true)
  approvalRequired Boolean @default(true)

  accrualEnabled      Boolean @default(false)
  carryForwardEnabled Boolean @default(false)
  /// Maximum days carried into the next period. Null means unlimited, which is
  /// different from zero.
  carryForwardLimit   Decimal? @db.Decimal(5, 2)

  /// Foundation only — Phase 2 stores the flag and implements no payout.
  encashmentAllowed Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  policies LeavePolicy[]
  balances LeaveBalance[]
  requests LeaveRequest[]
  ledger   LeaveLedgerEntry[]

  @@index([isActive, name])
}

/// The rules for one leave type, optionally narrowed to a department.
model LeavePolicy {
  id          String @id @default(cuid())
  leaveTypeId String

  /// Null means it applies company-wide.
  departmentId String?

  /// Days granted per year. Decimal because half days are real.
  annualEntitlement Decimal @db.Decimal(5, 2) @default(0)

  /// How often accrual runs. Null with accrualEnabled false means the whole
  /// entitlement is allocated up front.
  accrualPerPeriod Decimal? @db.Decimal(5, 2)

  /// Days of notice required before the start date.
  minNoticeDays Int @default(0)
  /// Longest unbroken stretch allowed. Null means no limit.
  maxConsecutiveDays Int?

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  leaveType  LeaveType   @relation(fields: [leaveTypeId], references: [id], onDelete: Cascade)
  department Department? @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  /// One policy per type per scope.
  @@unique([leaveTypeId, departmentId])
  @@index([isActive])
}

/// One employee's balance of one leave type for one period.
///
/// The columns here are a *cache* of the ledger below, maintained in the same
/// transaction as every ledger write. Both exist because each answers a question
/// the other cannot: the balance answers "how much is left" in one indexed read,
/// and the ledger answers "why" — which is the question that actually gets asked
/// when somebody disputes a number.
///
/// `available` is deliberately NOT a column. It is allocated + accrued +
/// carriedForward + adjusted − used − reserved, and a stored copy would be a
/// fifth number free to disagree with the four it comes from.
model LeaveBalance {
  id          String @id @default(cuid())
  employeeId  String
  leaveTypeId String

  /// The leave year, as a plain integer — 2026. A year rather than a date range
  /// because every policy here is annual; a mid-year policy change does not
  /// create a second period.
  periodYear Int

  allocated      Decimal @db.Decimal(6, 2) @default(0)
  accrued        Decimal @db.Decimal(6, 2) @default(0)
  carriedForward Decimal @db.Decimal(6, 2) @default(0)
  /// Consumed by approved leave.
  used           Decimal @db.Decimal(6, 2) @default(0)
  /// Held by requests awaiting a decision, so two pending requests cannot both
  /// be approved into the same remaining day.
  reserved       Decimal @db.Decimal(6, 2) @default(0)
  /// Signed: an HR correction may add or remove.
  adjusted       Decimal @db.Decimal(6, 2) @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  employee  Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveType LeaveType @relation(fields: [leaveTypeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, leaveTypeId, periodYear])
  @@index([employeeId, periodYear])
}

/// Every movement of every balance, append-only.
///
/// The reason a balance can be trusted. A number somebody can edit is a number
/// nobody can defend; a number that is the sum of its ledger can always be
/// explained, and a wrong one can be traced to the row that caused it.
///
/// Never updated and never deleted — a correction is a new row, not an edit.
model LeaveLedgerEntry {
  id          String @id @default(cuid())
  employeeId  String
  leaveTypeId String
  periodYear  Int

  reason LeaveLedgerReason
  /// Signed: positive adds to the balance, negative takes from it.
  days   Decimal @db.Decimal(6, 2)

  /// The request that caused this, where one did. SetNull so the trail survives
  /// a request being removed.
  leaveRequestId String?

  note String?

  /// Who caused it. Null for system accrual.
  performedById String?

  createdAt DateTime @default(now())

  employee     Employee      @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveType    LeaveType     @relation(fields: [leaveTypeId], references: [id], onDelete: Cascade)
  leaveRequest LeaveRequest? @relation(fields: [leaveRequestId], references: [id], onDelete: SetNull)
  performedBy  User?         @relation("LeaveLedgerBy", fields: [performedById], references: [id], onDelete: SetNull)

  @@index([employeeId, leaveTypeId, periodYear])
  @@index([leaveRequestId])
}

/// An application for leave.
model LeaveRequest {
  id          String @id @default(cuid())
  employeeId  String
  leaveTypeId String

  startDate DateTime @db.Date
  endDate   DateTime @db.Date

  /// A half day is a single date by definition, which a CHECK enforces.
  isHalfDay     Boolean        @default(false)
  halfDayPeriod HalfDayPeriod?

  /// Working days, excluding holidays and week-offs. Computed once by the shared
  /// calculator and frozen: recomputing later against a changed holiday calendar
  /// would silently restate how much leave somebody took.
  requestedDays Decimal @db.Decimal(5, 2)

  reason String

  status LeaveRequestStatus @default(PENDING)

  /// Who decided and when. Always both for APPROVED and REJECTED, never either
  /// for PENDING — the leave_decision_consistency CHECK enforces that pairing.
  ///
  /// CANCELLED is deliberately unconstrained on these: a request withdrawn before
  /// a decision has no decider, while an approved leave later called off KEEPS the
  /// approver's name. Erasing it would destroy the record of who approved the
  /// leave, which 20261008090000 corrected after the first version forced exactly
  /// that choice.
  decidedById  String?
  decidedAt    DateTime?
  decisionNote String?

  /// What marks a cancellation, whichever path it took. Required whenever the
  /// status is CANCELLED (leave_cancelled_stamped).
  cancelledAt     DateTime?
  cancellationNote String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  employee   Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveType  LeaveType @relation(fields: [leaveTypeId], references: [id], onDelete: Restrict)
  decidedBy  User?     @relation("LeaveDecidedBy", fields: [decidedById], references: [id], onDelete: SetNull)

  attendance AttendanceRecord[]
  ledger     LeaveLedgerEntry[]

  @@index([employeeId, startDate])
  @@index([employeeId, status])
  @@index([status, startDate])
  @@index([leaveTypeId])
}

// ---------------------------------------------------------------------------
//  HR Phase 3 — Recruitment / ATS, Onboarding & Probation
// ---------------------------------------------------------------------------
//
// ### A candidate is not an employee
//
// The architectural decision this whole phase rests on. `Candidate` holds
// somebody the business is considering; `Employee` holds somebody it employs.
// They are separate tables with separate lifecycles, joined only when onboarding
// reaches the point of creating the employment record — and even then the
// candidate and application survive as history rather than being transformed.
//
// So there is no CandidateEmployee, no RecruitmentEmployee, and no second
// employee-id scheme: `allocateEmployeeId` from Phase 1 is the only generator.
//
// ### A candidate may apply more than once
//
// `Candidate` and `Application` are separate for that reason. Somebody rejected
// for one role may be right for the next, and folding the application into the
// candidate would mean either losing that history or duplicating the person.
//
// ### Time
//
// Calendar days are `@db.Date` interpreted in IST; instants are timestamps taken
// from Postgres `now()`. Identical to Phase 2 — see `utils/hr-time.ts`. No second
// timezone implementation.

/// Where a job requisition stands.
///
/// DRAFT and PENDING_APPROVAL are separate because a half-written requisition is
/// not the same thing as one waiting on a decision — the second has somebody
/// else's queue to appear in. PUBLISHED is distinct from APPROVED so a signed-off
/// role can be held back until the business is ready to take applications.
enum JobRequisitionStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  PUBLISHED
  /// Open but temporarily not accepting applications.
  PAUSED
  /// Filled or abandoned. Terminal, and keeps its applications readable.
  CLOSED
  CANCELLED
}

enum JobPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

/// Where somebody heard about the role.
///
/// A fixed list rather than free text so the business can later ask which source
/// produces hires — the one recruitment figure worth measuring, and impossible to
/// answer from prose typed by five different recruiters.
enum CandidateSource {
  DIRECT
  REFERRAL
  JOB_PORTAL
  WALK_IN
  CAMPUS
  AGENCY
  SOCIAL_MEDIA
  OTHER
}

/// The ATS pipeline, in order.
///
/// The order matters: the transition map in `shared/src/utils/ats-pipeline.ts`
/// is built from it, and "forward" means later in this list. A stage is never
/// skipped except through the explicitly permitted shortcuts documented there.
///
/// JOB_CREATED and PUBLISHED belong to the *requisition* rather than to an
/// application, and are deliberately absent here: an application cannot exist
/// before its job is published, so those two are states of the job and including
/// them would give every application two stages it could never be in.
enum ApplicationStage {
  APPLICATION
  SCREENING
  SHORTLISTED
  HR_INTERVIEW
  DEPARTMENT_INTERVIEW
  ASSESSMENT
  FINAL_INTERVIEW
  SELECTED
  OFFER
  OFFER_ACCEPTED
  BACKGROUND_VERIFICATION
  ONBOARDING
  JOINED
}

/// Whether an application is still live.
///
/// Separate from the stage, which says *where* it is. An application can be
/// WITHDRAWN at any stage, and conflating the two would mean a withdrawal erasing
/// the record of how far somebody got.
enum ApplicationStatus {
  ACTIVE
  /// Rejected by the business. The stage records where it ended.
  REJECTED
  /// Withdrawn by the candidate.
  WITHDRAWN
  /// Reached JOINED. Terminal and successful.
  HIRED
  /// The offer lapsed or the candidate declined.
  DECLINED
}

enum InterviewType {
  HR
  DEPARTMENT
  TECHNICAL
  FINAL
  OTHER
}

enum InterviewStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
  NO_SHOW
}

/// What an interviewer concluded.
///
/// Five points rather than three, because the middle of a three-point scale
/// collects everything anybody is unsure about and tells a hiring manager nothing.
enum InterviewRecommendation {
  STRONG_YES
  YES
  MAYBE
  NO
  STRONG_NO
}

enum AssessmentStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  PASSED
  FAILED
}

enum OfferStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
  WITHDRAWN
}

enum BackgroundCheckType {
  IDENTITY
  EDUCATION
  EMPLOYMENT
  CRIMINAL
  REFERENCE
  ADDRESS
  OTHER
}

enum BackgroundCheckStatus {
  PENDING
  IN_PROGRESS
  CLEAR
  FLAGGED
  FAILED
  /// Deliberately not run. A recorded decision, not an omission.
  WAIVED
}

/// Where an onboarding stands.
///
/// Mirrors the checklist the business actually works through. EMPLOYEE_CREATED is
/// the hinge: before it there is no employment record, after it the Phase 1
/// Employee exists and every later stage is about them.
enum OnboardingStage {
  OFFER_ACCEPTED
  DOCUMENTS
  VERIFICATION
  EMPLOYEE_CREATED
  ACCOUNT
  ASSETS
  POLICIES
  TRAINING
  DEPARTMENT_INTRODUCTION
  MANAGER_ASSIGNED
  FIRST_WEEK
  DAY_30
  DAY_60
  DAY_90
  PROBATION_DECISION
  COMPLETED
}

enum OnboardingTaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  /// Deliberately not done — a recorded decision rather than a silent gap.
  SKIPPED
  /// Waiting on something outside the assignee's control.
  BLOCKED
}

/// Who owns an onboarding task.
///
/// Generic on purpose: ASSETS and TRAINING are foundations in this phase, so the
/// category is how a future Asset or Training module finds its work without this
/// table knowing anything about either.
enum OnboardingTaskCategory {
  DOCUMENTS
  IT
  HR
  MANAGER
  TRAINING
  POLICY
  DEPARTMENT
}

enum ProbationStatus {
  NOT_STARTED
  ACTIVE
  EXTENDED
  CONFIRMED
  TERMINATED
}

enum ProbationReviewType {
  FIRST_WEEK
  DAY_30
  DAY_60
  DAY_90
}

enum ProbationReviewStatus {
  SCHEDULED
  COMPLETED
  MISSED
}

enum ProbationDecision {
  CONFIRM
  EXTEND
  TERMINATE
}

/// A role the business is hiring for.
model JobRequisition {
  id String @id @default(cuid())

  /// The stable reference people quote — "ENG-2026-004". Unique.
  code  String @unique
  title String

  departmentId  String?
  designationId String?

  /// The employee who owns the hire, and the recruiter running it. Both SetNull:
  /// a requisition outlives whoever was handling it.
  hiringManagerId String?
  recruiterId     String?

  employmentType EmploymentType @default(FULL_TIME)
  workMode       WorkMode       @default(ON_SITE)
  location       String?

  /// How many people are being hired. A CHECK keeps it positive.
  openings Int @default(1)

  description    String?
  requirements   String?
  responsibilities String?

  /// Informational only. Phase 3 computes nothing from these and there is no
  /// payroll anywhere in this module — a range exists so a recruiter can state
  /// what was advertised, nothing more.
  salaryRangeMin Decimal? @db.Decimal(12, 2)
  salaryRangeMax Decimal? @db.Decimal(12, 2)
  salaryCurrency String?  @default("INR")

  status   JobRequisitionStatus @default(DRAFT)
  priority JobPriority          @default(NORMAL)

  targetJoinDate DateTime? @db.Date

  /// Publication is recorded rather than inferred from the status, so "when did
  /// this go live" survives a later pause or close.
  publishedAt DateTime?
  closedAt    DateTime?

  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  department    Department?  @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  designation   Designation? @relation(fields: [designationId], references: [id], onDelete: SetNull)
  hiringManager Employee?    @relation("JobHiringManager", fields: [hiringManagerId], references: [id], onDelete: SetNull)
  recruiter     Employee?    @relation("JobRecruiter", fields: [recruiterId], references: [id], onDelete: SetNull)
  createdBy     User         @relation("JobCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  applications Application[]
  offers       Offer[]

  @@index([status, priority, createdAt])
  @@index([departmentId, status])
  @@index([recruiterId])
  @@index([hiringManagerId])
}

/// Somebody the business is considering.
///
/// NOT an employee, and never becomes one: onboarding creates a separate Employee
/// row and this record survives as the history of how that person was found.
model Candidate {
  id String @id @default(cuid())

  firstName String
  lastName  String

  /// Lower-cased on the way in and unique, which is the duplicate guard: one
  /// person is one candidate however many roles they apply for. Email rather than
  /// phone because a shared household phone is real and a shared mailbox is not.
  email String @unique

  /// Not unique, deliberately. Families and agencies share numbers, and a unique
  /// constraint here would refuse a legitimate second candidate.
  phone    String?
  location String?

  source       CandidateSource @default(DIRECT)
  /// Who referred them, for a REFERRAL. Free text: a referrer may not be an
  /// employee, so a foreign key would refuse the commonest case.
  sourceDetail String?

  /// Whole years, as stated. A CHECK keeps it sane.
  totalExperienceYears Decimal? @db.Decimal(4, 1)
  currentEmployer      String?
  currentDesignation   String?

  /// Comma-free list of skills. An array rather than a join table: skills are read
  /// as a whole and never queried individually in this phase.
  skills String[]

  /// Internal notes. Never shown to a candidate — there is no candidate-facing
  /// route in this CRM at all, which is the simplest way to guarantee it.
  notes String?

  isActive Boolean @default(true)

  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  createdBy User @relation("CandidateCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  applications Application[]
  documents    CandidateDocument[]

  @@index([isActive, lastName, firstName])
  @@index([source])
}

/// One candidate's pursuit of one role.
///
/// The join that makes "apply to several jobs" work without duplicating the
/// person. Unique on (candidateId, jobRequisitionId): the same person cannot have
/// two live applications for one role, enforced by the database rather than by a
/// check two concurrent requests could both pass.
model Application {
  id               String @id @default(cuid())
  candidateId      String
  jobRequisitionId String

  appliedAt DateTime @default(now())
  /// How this particular application arrived, which can differ from how the
  /// candidate was first found.
  source    CandidateSource @default(DIRECT)

  currentStage ApplicationStage  @default(APPLICATION)
  status       ApplicationStatus @default(ACTIVE)

  /// Who is handling it. Defaults from the requisition but may differ.
  recruiterId     String?
  hiringManagerId String?

  /// Screening, recorded on the application because it is a judgement about this
  /// application rather than about the candidate.
  screeningScore Int?
  screeningNotes String?

  /// Required whenever the status is REJECTED — a CHECK enforces it. "No" with no
  /// reason is the commonest complaint about every hiring process.
  rejectionReason String?

  selectedById String?
  selectedAt   DateTime?

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  candidate      Candidate      @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  jobRequisition JobRequisition @relation(fields: [jobRequisitionId], references: [id], onDelete: Cascade)
  recruiter      Employee?      @relation("ApplicationRecruiter", fields: [recruiterId], references: [id], onDelete: SetNull)
  hiringManager  Employee?      @relation("ApplicationHiringManager", fields: [hiringManagerId], references: [id], onDelete: SetNull)
  selectedBy     User?          @relation("ApplicationSelectedBy", fields: [selectedById], references: [id], onDelete: SetNull)

  stageHistory ApplicationStageHistory[]
  interviews   Interview[]
  assessments  Assessment[]
  offers       Offer[]
  backgroundChecks BackgroundCheck[]
  onboarding   OnboardingRecord?

  /// One live application per candidate per role.
  @@unique([candidateId, jobRequisitionId])
  @@index([jobRequisitionId, currentStage])
  @@index([currentStage, status])
  @@index([candidateId])
  @@index([recruiterId])
}

/// Every stage an application passed through, append-only.
///
/// No `updatedAt`, deliberately: a row is what happened, not what somebody later
/// decided it should say. The pipeline is auditable by replaying these rather than
/// by trusting the application's current stage.
model ApplicationStageHistory {
  id            String @id @default(cuid())
  applicationId String

  /// Null for the first entry — an application starts somewhere rather than
  /// moving from nowhere.
  fromStage ApplicationStage?
  toStage   ApplicationStage

  reason String?

  /// Who moved it. SetNull so a departed recruiter's decisions stay readable.
  performedById String?
  createdAt     DateTime @default(now())

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  performedBy User?       @relation("StageHistoryBy", fields: [performedById], references: [id], onDelete: SetNull)

  @@index([applicationId, createdAt])
}

/// A scheduled conversation with a candidate.
model Interview {
  id            String @id @default(cuid())
  applicationId String

  interviewType InterviewType
  /// Which round of this type, so two department interviews are distinguishable.
  round         Int           @default(1)

  /// A real moment, not a calendar day: an interview happens at a time.
  scheduledAt     DateTime
  durationMinutes Int      @default(60)

  /// Where, or a meeting link. Plain metadata — Phase 3 integrates no calendar or
  /// video provider, and inventing one would mean inventing its failure modes.
  location   String?
  meetingUrl String?

  status InterviewStatus @default(SCHEDULED)

  /// The lead interviewer. Separate from participants because somebody has to own
  /// the feedback, and "everyone" owns nothing.
  interviewerId String?

  completedAt DateTime?

  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  interviewer Employee?   @relation("InterviewLead", fields: [interviewerId], references: [id], onDelete: SetNull)
  createdBy   User        @relation("InterviewCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  participants InterviewParticipant[]
  feedback     InterviewFeedback[]

  @@index([applicationId, scheduledAt])
  @@index([status, scheduledAt])
  @@index([interviewerId, scheduledAt])
}

/// Somebody attending an interview.
///
/// A table rather than an array so each participant can be identified for
/// access control: an interviewer reaches the interviews they are on, and that
/// question needs rows to join against.
model InterviewParticipant {
  id          String @id @default(cuid())
  interviewId String
  employeeId  String

  createdAt DateTime @default(now())

  interview Interview @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  employee  Employee  @relation("InterviewParticipant", fields: [employeeId], references: [id], onDelete: Cascade)

  /// One person is on an interview once.
  @@unique([interviewId, employeeId])
  @@index([employeeId])
}

/// What one interviewer concluded.
///
/// Separate from the interview so each participant gives their own view: one
/// feedback column on the interview would make the lead's opinion the only one
/// recorded, which is the opposite of why several people attend.
///
/// `strengths`, `concerns` and `notes` are internal. There is no candidate-facing
/// route in this CRM, so they cannot leak to the subject by construction.
model InterviewFeedback {
  id          String @id @default(cuid())
  interviewId String
  /// The employee giving it.
  employeeId  String

  /// 1–5. A CHECK enforces the range.
  rating         Int?
  recommendation InterviewRecommendation

  strengths String?
  concerns  String?
  notes     String?

  submittedAt DateTime @default(now())

  interview Interview @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  employee  Employee  @relation("FeedbackBy", fields: [employeeId], references: [id], onDelete: Cascade)

  /// One person's feedback per interview, amended rather than duplicated.
  @@unique([interviewId, employeeId])
  @@index([employeeId])
}

/// A test or exercise set for a candidate.
///
/// Foundation only: Phase 3 records what was set and what came back. There is no
/// assessment platform, no automatic scoring and no candidate-facing submission —
/// a reviewer enters the result.
model Assessment {
  id            String @id @default(cuid())
  applicationId String

  /// What kind of exercise. Free text because the set of assessments a business
  /// uses is its own, and an enum would need a migration per new test.
  assessmentType String
  title          String

  assignedAt DateTime  @default(now())
  dueAt      DateTime?

  /// Score out of maxScore. Both nullable until the result is entered.
  score    Decimal? @db.Decimal(6, 2)
  maxScore Decimal? @db.Decimal(6, 2)

  status AssessmentStatus @default(PENDING)

  reviewerId String?
  reviewedAt DateTime?
  notes      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  reviewer    Employee?   @relation("AssessmentReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)

  @@index([applicationId, status])
  @@index([status, dueAt])
}

/// What the business offered.
model Offer {
  id               String @id @default(cuid())
  applicationId    String
  /// Denormalised from the application so an offer can be read without it, and so
  /// the role offered survives a requisition being re-scoped.
  jobRequisitionId String

  /// The reference quoted in correspondence. Unique.
  code String @unique

  position      String
  departmentId  String?
  designationId String?

  employmentType EmploymentType @default(FULL_TIME)
  workMode       WorkMode       @default(ON_SITE)
  location       String?

  proposedJoiningDate DateTime @db.Date

  /// Informational, as on the requisition. **No payroll and no bank or tax
  /// detail anywhere in this phase** — an offer records what was communicated so
  /// a later Payroll module has a documented starting point, and nothing else.
  annualPackage   Decimal? @db.Decimal(12, 2)
  packageCurrency String?  @default("INR")
  benefitsSummary String?

  /// When the offer lapses if unanswered. A CHECK keeps it after the offer date.
  expiresOn DateTime? @db.Date

  status OfferStatus @default(DRAFT)

  sentAt     DateTime?
  /// Both stamped together with the status — a CHECK enforces the pairing, so a
  /// decided offer can always say when.
  respondedAt DateTime?
  /// Required when REJECTED or WITHDRAWN.
  responseNote String?

  /// The offer letter itself, where one was stored. SecureDocument, never a
  /// public URL.
  secureDocumentId String? @unique

  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  application    Application     @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  jobRequisition JobRequisition  @relation(fields: [jobRequisitionId], references: [id], onDelete: Cascade)
  department     Department?     @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  designation    Designation?    @relation(fields: [designationId], references: [id], onDelete: SetNull)
  secureDocument SecureDocument? @relation("OfferLetter", fields: [secureDocumentId], references: [id], onDelete: SetNull)
  createdBy      User            @relation("OfferCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([applicationId, status])
  @@index([status, expiresOn])
}

/// One background check on one application.
///
/// Foundation: Phase 3 records that a check was requested and what came back. No
/// verification provider is integrated.
model BackgroundCheck {
  id            String @id @default(cuid())
  applicationId String

  checkType BackgroundCheckType
  status    BackgroundCheckStatus @default(PENDING)

  requestedAt DateTime  @default(now())
  completedAt DateTime?

  /// What the check found. Internal — a FLAGGED result is exactly the kind of
  /// thing that must not reach anybody without HR_RECRUITMENT.
  result String?
  notes  String?

  /// Who ran it. Free text: a verification agency is not an employee.
  verifierName String?
  verifiedById String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  verifiedBy  User?       @relation("BackgroundVerifiedBy", fields: [verifiedById], references: [id], onDelete: SetNull)
  documents   CandidateDocument[]

  /// One check of each type per application, re-run by amending rather than
  /// accumulating rows nobody can order.
  @@unique([applicationId, checkType])
  @@index([status, requestedAt])
}

/// Metadata for one confidential candidate file.
///
/// The bytes are in SecureDocument — authenticated Cloudinary delivery, no stored
/// URL, short-lived signed links. This adds only what recruitment needs: which
/// candidate, what kind, and which background check it supports.
///
/// Deliberately a separate table from `EmployeeDocument` rather than a widened
/// one: a candidate is not an employee, and a shared table would need a nullable
/// owner on both sides plus a CHECK to stop both being set at once.
model CandidateDocument {
  id          String @id @default(cuid())
  candidateId String

  secureDocumentId String @unique

  documentType EmployeeDocumentType
  title        String

  /// Set when the document was supplied for a background check.
  backgroundCheckId String?

  verificationStatus DocumentVerificationStatus @default(PENDING)
  verifiedById       String?
  verifiedAt         DateTime?

  uploadedById String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  candidate       Candidate        @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  secureDocument  SecureDocument   @relation("CandidateDocumentFile", fields: [secureDocumentId], references: [id], onDelete: Cascade)
  backgroundCheck BackgroundCheck? @relation(fields: [backgroundCheckId], references: [id], onDelete: SetNull)
  verifiedBy      User?            @relation("CandidateDocumentVerifiedBy", fields: [verifiedById], references: [id], onDelete: SetNull)
  uploadedBy      User             @relation("CandidateDocumentUploadedBy", fields: [uploadedById], references: [id], onDelete: Restrict)

  @@index([candidateId, documentType])
  @@index([backgroundCheckId])
}

/// Bringing an accepted candidate into the business.
///
/// One per application, which is what stops two onboardings — and therefore two
/// employees — being created for one hire. `employeeId` is unique for the same
/// reason: one onboarding produces at most one employment record, enforced by the
/// database rather than by a service remembering.
model OnboardingRecord {
  id            String @id @default(cuid())
  applicationId String @unique

  /// The employment record this onboarding produced, once it exists. Null until
  /// the EMPLOYEE_CREATED stage. SetNull so removing an employee does not delete
  /// the record of how they were hired.
  employeeId String? @unique

  stage OnboardingStage @default(OFFER_ACCEPTED)

  /// The agreed start. A calendar day, like every other HR date.
  joiningDate DateTime @db.Date
  actualJoiningDate DateTime? @db.Date

  /// Where they will sit, once decided. Assigned during onboarding rather than
  /// fixed at offer, because these legitimately change.
  departmentId  String?
  designationId String?
  managerId     String?

  completedAt DateTime?

  notes String?

  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  application  Application  @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  employee     Employee?    @relation("OnboardingEmployee", fields: [employeeId], references: [id], onDelete: SetNull)
  department   Department?  @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  designation  Designation? @relation(fields: [designationId], references: [id], onDelete: SetNull)
  manager      Employee?    @relation("OnboardingManager", fields: [managerId], references: [id], onDelete: SetNull)
  createdBy    User         @relation("OnboardingCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  tasks OnboardingTask[]

  @@index([stage, joiningDate])
  @@index([joiningDate])
}

/// One thing somebody must do before or just after a hire starts.
///
/// Generic by design. ASSETS, TRAINING and POLICIES are foundations in this
/// phase: the task records that a laptop is owed or a policy must be
/// acknowledged, and a future Asset or Training module finds its work by category
/// without this table knowing anything about either. **No fake asset or course
/// rows are created** — there is no system to create them in.
model OnboardingTask {
  id                 String @id @default(cuid())
  onboardingRecordId String

  title    String
  category OnboardingTaskCategory
  detail   String?

  /// Who owes it. An employee, because every assignee here is internal — a
  /// candidate's own document upload is recorded as an HR task on their behalf.
  assigneeId String?

  dueOn DateTime? @db.Date

  status OnboardingTaskStatus @default(PENDING)

  completedAt   DateTime?
  completedById String?
  notes         String?

  /// Ordering within the checklist, so it reads in the sequence the business works
  /// through rather than by creation time.
  sortOrder Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// HR Phase 4 — the real training this task stands for, once linked.
  ///
  /// Nullable and added additively, which is the whole integration. Phase 3
  /// created a TRAINING task category with no course behind it, deliberately, so
  /// that Phase 4 would not inherit a fake model. Linking an enrollment here lets
  /// the task's status follow actual training progress **without the task losing
  /// its own identity, ordering or history** — it is still the onboarding
  /// checklist's row, not a view of a course.
  ///
  /// SetNull rather than Cascade: withdrawing a training assignment must not
  /// delete the onboarding task that asked for it. The task reverts to unlinked
  /// and somebody decides what to do, which is the honest outcome.
  trainingEnrollmentId String?

  onboardingRecord OnboardingRecord @relation(fields: [onboardingRecordId], references: [id], onDelete: Cascade)
  trainingEnrollment TrainingEnrollment? @relation(fields: [trainingEnrollmentId], references: [id], onDelete: SetNull)
  assignee         Employee?        @relation("OnboardingTaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  completedBy      User?            @relation("OnboardingTaskCompletedBy", fields: [completedById], references: [id], onDelete: SetNull)

  @@index([onboardingRecordId, sortOrder])
  @@index([status, dueOn])
  @@index([assigneeId, status])
}

/// One employee's probation.
///
/// Unique on `employeeId`: a person is on probation once per employment. A second
/// probation would be a second employment, which is a new Employee record.
model ProbationRecord {
  id         String @id @default(cuid())
  employeeId String @unique

  startDate DateTime @db.Date
  /// Moves when probation is extended; the original is kept in the history below.
  endDate   DateTime @db.Date

  status ProbationStatus @default(ACTIVE)

  /// Who assesses it. Usually the reporting manager, but recorded separately
  /// because the assessor and the manager can legitimately differ.
  managerId String?

  /// The decision, once made. All three move together — a CHECK enforces it, so a
  /// decided probation can always say who decided and why.
  decision       ProbationDecision?
  decisionReason String?
  decidedById    String?
  decidedAt      DateTime?

  /// Where an extension moved the end date to, kept so the original term is not
  /// lost to the `endDate` column.
  originalEndDate DateTime? @db.Date

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  employee  Employee @relation("ProbationEmployee", fields: [employeeId], references: [id], onDelete: Cascade)
  manager   Employee? @relation("ProbationManager", fields: [managerId], references: [id], onDelete: SetNull)
  decidedBy User?    @relation("ProbationDecidedBy", fields: [decidedById], references: [id], onDelete: SetNull)

  reviews ProbationReview[]

  @@index([status, endDate])
  @@index([managerId, status])
}

/// A first-week, 30, 60 or 90 day review.
///
/// Probation-specific and deliberately thin: this is not performance management.
/// There are no goals, no competencies and no calibration — those are Phase 4, and
/// building them here would mean guessing at a framework nobody has described.
model ProbationReview {
  id                String @id @default(cuid())
  probationRecordId String

  reviewType ProbationReviewType
  /// When it is due. The service schedules all four when probation starts.
  scheduledOn DateTime @db.Date

  status ProbationReviewStatus @default(SCHEDULED)

  reviewerId String?

  /// 1–5, like interview feedback. A CHECK enforces the range.
  rating         Int?
  comments       String?
  recommendation InterviewRecommendation?

  completedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  probationRecord ProbationRecord @relation(fields: [probationRecordId], references: [id], onDelete: Cascade)
  reviewer        Employee?       @relation("ProbationReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)

  /// One review of each type per probation.
  @@unique([probationRecordId, reviewType])
  @@index([status, scheduledOn])
}

/// One allocated recruitment reference sequence.
///
/// The same mechanism as `PostSalesCaseCounter` and `EmployeeIdCounter`, and
/// present for the same reason: `SELECT max(...) + 1` read by two concurrent
/// creates returns the same number to both, and a requisition code is quoted in
/// correspondence — two roles sharing "ENG-2026-004" is a real confusion.
///
/// `scope` is the key, holding a kind-and-period string such as "JOB-2026" or
/// "OFFER-2026". A second series is a second row rather than a migration.
model RecruitmentCodeCounter {
  scope     String   @id
  lastValue Int      @default(0)
  updatedAt DateTime @updatedAt
}

// ---------------------------------------------------------------------------
//  HR Phase 4 — Training & Learning Management
// ---------------------------------------------------------------------------
//
// ### The journey is data, not a code path
//
// The business's required sequence — company introduction, product training,
// customer psychology, communication, customer experience, productivity tools,
// policies, knowledge test, department training, department test, practical,
// shadowing, final assessment, qualified — is expressed as **ordered
// TrainingModule rows inside a TrainingProgram**, with per-program requirement
// flags saying which gates must pass.
//
// It is deliberately NOT a chain of service conditionals. A hard-coded sequence
// would mean every department that trains differently needs a code change, and the
// first exception would be expressed as an `if` nobody can find later. So
// `TrainingProgram` carries the policy (passing score, attempt limit, whether a
// practical and a shadowing sign-off are required) and the modules carry the order.
//
// ### Eleven tables, and why not more
//
// The brief lists twenty candidate concepts. Several collapse without losing
// anything:
//
//   Course and Program are one thing here. A "course" that is not a program is a
//   distinction with no behaviour behind it in this phase — both would carry the
//   same policy fields and the same enrollment.
//
//   Lesson is TrainingModule's content, not its own table. A module with one
//   ordered body of material is what the journey actually needs; a separate
//   Lesson table would be a second ordering to keep in step for no present gain.
//
//   TrainingSession, TrainingBatch and TrainingTrainer are absent. Cohort
//   scheduling is a real feature, but nothing in the required journey depends on
//   it, and an unused batch table is a migration to undo later. The trainer is
//   recorded where it matters — on the practical reviewer and the shadowing mentor.
//
//   TrainingCertificate is a field on TrainingQualification, not a table. A
//   certificate with no issuer, template or revocation story is a number and a
//   date, and those fit on the record that grants them.
//
// ### Scores
//
// Decimal(5,2) throughout — never a float. A pass mark of 80 against a score of
// 79.995 must not round into a pass, and `0.1 + 0.2 !== 0.3` is exactly the class
// of bug that decides whether somebody is qualified for live work.

/// Where a program is in its own lifecycle.
///
/// DRAFT is separate from ACTIVE because a half-built program must not be
/// assignable — somebody would be enrolled into a course with no modules.
/// ARCHIVED keeps existing enrollments readable while refusing new ones, which is
/// why there is no delete.
enum TrainingProgramStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

/// What kind of module this is, which decides how it is completed.
///
/// The distinction is load-bearing: a LESSON is completed by the learner marking
/// it read, an ASSESSMENT by passing it, a PRACTICAL by somebody else approving
/// it, and SHADOWING by a mentor signing it off. The completion rule follows the
/// kind, which is what lets one ordered list express the whole journey.
enum TrainingModuleKind {
  LESSON
  ASSESSMENT
  PRACTICAL
  SHADOWING
}

/// Where one employee's enrollment stands.
enum TrainingEnrollmentStatus {
  /// Assigned, not opened.
  NOT_STARTED
  IN_PROGRESS
  /// Every required gate passed.
  COMPLETED
  /// Deliberately excused, with a recorded reason. Not the same as abandoned.
  EXEMPTED
  /// Withdrawn by HR — the assignment was a mistake, or the role changed.
  CANCELLED
}

/// Whether an assignment is obligatory.
///
/// Stored on the enrollment rather than read from the program, deliberately: a
/// program's mandatory flag can change, and an enrollment records what was asked
/// of this person at the time. Recomputing it would rewrite history.
enum TrainingObligation {
  MANDATORY
  OPTIONAL
}

enum AssessmentQuestionKind {
  SINGLE_CHOICE
  MULTIPLE_CHOICE
  TRUE_FALSE
}

/// Where one attempt stands.
///
/// IN_PROGRESS is distinct from the terminal states because an unfinished attempt
/// still counts against the limit — otherwise abandoning an attempt would be a
/// free retry.
enum TrainingAttemptStatus {
  IN_PROGRESS
  PASSED
  FAILED
  /// Ran out of time, or was superseded. Counts against the limit like a failure.
  EXPIRED
}

enum PracticalSubmissionStatus {
  NOT_STARTED
  SUBMITTED
  APPROVED
  /// Sent back for rework. The learner may submit again.
  REJECTED
}

enum ShadowingStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

/// A grouping for the catalogue.
///
/// A table rather than an enum because the set of categories is the business's own
/// and changes by decision, not by deployment — the same reasoning
/// `Employee.location` is free text and departments are rows.
model TrainingCategory {
  id          String  @id @default(cuid())
  name        String
  /// The stable identifier a human quotes. Uppercased on the way in.
  code        String  @unique
  description String?
  isActive    Boolean @default(true)

  /// Catalogue ordering, so the list reads the way the business thinks of it.
  sortOrder Int @default(0)

  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  createdBy User              @relation("TrainingCategoryCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  programs  TrainingProgram[]

  @@index([isActive, sortOrder, name])
}

/// One training program — the unit a person is enrolled into.
///
/// Carries the *policy*; the modules carry the sequence. That split is what makes
/// the required journey configurable rather than compiled in.
model TrainingProgram {
  id   String @id @default(cuid())
  /// The reference quoted internally — "TRN-2026-0004". Allocated server-side.
  code String @unique

  title       String
  description String?
  /// What somebody will be able to do afterwards. Prose, shown on the detail page.
  objectives  String?

  categoryId String?

  /// Who this is for. Both nullable: a company-wide induction targets nobody in
  /// particular, and SetNull so archiving a department does not delete its courses.
  targetDepartmentId  String?
  targetDesignationId String?

  status      TrainingProgramStatus @default(DRAFT)
  /// The default obligation for new assignments. Each enrollment stores its own.
  obligation  TrainingObligation    @default(OPTIONAL)

  /// Informational, for planning a learner's time. Nothing is computed from it.
  estimatedMinutes Int?

  /*
    The qualification policy. Every one of these is per-program, which is the
    point: the business's default pass mark is 80, and a CHECK keeps it in range,
    but a program may set its own. Nothing hard-codes 80.
  */
  passingScore Decimal @default(80.00) @db.Decimal(5, 2)
  maxAttempts  Int     @default(3)

  /// Whether a practical approval and a shadowing sign-off gate completion.
  /// Read by `qualificationGaps` — absent flags mean those modules are optional
  /// rather than silently skipped.
  requiresPractical Boolean @default(false)
  requiresShadowing Boolean @default(false)
  /// Whether passing the final assessment is required to qualify for live work.
  requiresFinalAssessment Boolean @default(true)

  /// Days from assignment to the due date. Null means no deadline.
  dueWithinDays Int?

  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  publishedAt DateTime?
  archivedAt  DateTime?

  category          TrainingCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  targetDepartment  Department?       @relation("TrainingTargetDepartment", fields: [targetDepartmentId], references: [id], onDelete: SetNull)
  targetDesignation Designation?      @relation("TrainingTargetDesignation", fields: [targetDesignationId], references: [id], onDelete: SetNull)
  createdBy         User              @relation("TrainingProgramCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  modules     TrainingModule[]
  enrollments TrainingEnrollment[]
  assessments TrainingAssessment[]

  @@index([status, title])
  @@index([categoryId, status])
  @@index([targetDepartmentId])
}

/// One step in a program, in order.
///
/// The journey lives here. `sortOrder` with a unique index per program means two
/// modules cannot claim the same position — without it, "the next module" is
/// ambiguous and a learner's progress depends on insertion order.
model TrainingModule {
  id        String @id @default(cuid())
  programId String

  title   String
  kind    TrainingModuleKind
  /// Where it sits in the sequence. Unique within the program.
  sortOrder Int

  /// Lesson material. Plain text and optional links — deliberately not a rich
  /// content model: this application has no editor, and inventing a block format
  /// here would mean migrating away from it when one arrives.
  content String?
  /// An external reference. A URL field only — **this is not video integration**,
  /// and nothing in this phase plays or tracks media.
  referenceUrl String?

  /// Stored material, where the module has any. A SecureDocument id, never a URL:
  /// links are minted per request, signed and short-lived.
  secureDocumentId String?

  /// Whether this module must be completed for the program to complete. An
  /// optional module is offered and not gated on.
  isRequired Boolean @default(true)

  /// Instructions for a PRACTICAL or SHADOWING module. The learner sees these.
  instructions String?

  estimatedMinutes Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  program        TrainingProgram @relation(fields: [programId], references: [id], onDelete: Cascade)
  secureDocument SecureDocument? @relation("TrainingModuleMaterial", fields: [secureDocumentId], references: [id], onDelete: SetNull)

  assessment TrainingAssessment?
  progress   TrainingModuleProgress[]
  practicals PracticalSubmission[]
  shadowings ShadowingRecord[]

  /// One position per program, so "next module" is never ambiguous.
  @@unique([programId, sortOrder])
  @@index([programId, sortOrder])
}

/// One employee's enrollment in one program.
///
/// Unique on (employeeId, programId) **where the enrollment is still live** — a
/// partial unique index, because somebody legitimately retakes a programme years
/// later and a plain unique would refuse that. The partial index is in the
/// migration; Prisma cannot express it.
model TrainingEnrollment {
  id         String @id @default(cuid())
  employeeId String
  programId  String

  status     TrainingEnrollmentStatus @default(NOT_STARTED)
  obligation TrainingObligation       @default(OPTIONAL)

  /// Who assigned it, and when. A User rather than an Employee: the audit question
  /// is "who did this", and an HR administrator may hold no HR record.
  assignedById String
  assignedAt   DateTime @default(now())

  /// A calendar day, interpreted in IST like every other HR date.
  dueOn DateTime? @db.Date

  startedAt   DateTime?
  completedAt DateTime?

  /*
    How this enrollment came about. Recorded rather than derived, because a
    department-wide assignment must not silently change when the employee later
    moves department — the enrollment is what was asked of them at the time.
  */
  assignedVia String @default("INDIVIDUAL")

  /// Exemption, where granted. All three move together — a CHECK enforces it, so
  /// an excused learner can always say who excused them and why.
  exemptedById String?
  exemptedAt   DateTime?
  exemptionReason String?

  /// Withdrawal, where the assignment was a mistake.
  cancelledAt     DateTime?
  cancellationReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  employee   Employee        @relation("TrainingLearner", fields: [employeeId], references: [id], onDelete: Cascade)
  program    TrainingProgram @relation(fields: [programId], references: [id], onDelete: Restrict)
  assignedBy User            @relation("TrainingAssignedBy", fields: [assignedById], references: [id], onDelete: Restrict)
  exemptedBy User?           @relation("TrainingExemptedBy", fields: [exemptedById], references: [id], onDelete: SetNull)

  moduleProgress TrainingModuleProgress[]
  attempts       TrainingAttempt[]
  practicals     PracticalSubmission[]
  shadowings     ShadowingRecord[]
  qualification  TrainingQualification?
  onboardingTasks OnboardingTask[]

  @@index([employeeId, status])
  @@index([programId, status])
  @@index([status, dueOn])
}

/// One learner's progress through one module.
///
/// A row per (enrollment, module), created lazily when the learner first touches
/// it. Unique on the pair, which is what makes "completed twice" impossible.
model TrainingModuleProgress {
  id           String @id @default(cuid())
  enrollmentId String
  moduleId     String

  startedAt   DateTime?
  completedAt DateTime?

  /// Minutes the learner reports spending. Informational, never used as a gate —
  /// a self-reported duration is not evidence of anything.
  timeSpentMinutes Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  enrollment TrainingEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  module     TrainingModule     @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@unique([enrollmentId, moduleId])
  @@index([enrollmentId])
}

/// An assessment attached to a program, optionally to one module.
///
/// `moduleId` is unique where set: one module has at most one assessment, which is
/// what lets a module of kind ASSESSMENT be completed by passing "its" test.
/// `isFinal` marks the one that gates live-work qualification.
model TrainingAssessment {
  id        String  @id @default(cuid())
  programId String
  moduleId  String? @unique

  title        String
  instructions String?

  /// Null means "inherit the program's". Stored nullable rather than copied, so
  /// changing the program's policy reaches assessments that never set their own.
  passingScore Decimal? @db.Decimal(5, 2)
  maxAttempts  Int?

  /// Minutes allowed once started. Null means untimed.
  timeLimitMinutes Int?

  /// The final assessment — the one `requiresFinalAssessment` refers to. A partial
  /// unique index in the migration allows exactly one per program.
  isFinal  Boolean @default(false)
  isActive Boolean @default(true)

  /// Whether to shuffle question order per attempt. A mild integrity measure, not
  /// a security control — the real control is that answers are graded server-side.
  shuffleQuestions Boolean @default(false)

  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  program   TrainingProgram @relation(fields: [programId], references: [id], onDelete: Cascade)
  module    TrainingModule? @relation(fields: [moduleId], references: [id], onDelete: SetNull)
  createdBy User            @relation("TrainingAssessmentCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  questions TrainingQuestion[]
  attempts  TrainingAttempt[]

  @@index([programId, isActive])
}

/// One question.
///
/// `points` is Decimal, not Int, so a 3-question test can total 100 without
/// forcing whole numbers — and a weighted question does not need a fudge.
model TrainingQuestion {
  id           String @id @default(cuid())
  assessmentId String

  kind   AssessmentQuestionKind
  prompt String
  /// Shown after submission only. Never sent with the question paper.
  explanation String?

  points    Decimal @default(1.00) @db.Decimal(5, 2)
  sortOrder Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assessment TrainingAssessment     @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  options    TrainingQuestionOption[]
  answers    TrainingAnswer[]

  @@unique([assessmentId, sortOrder])
  @@index([assessmentId, sortOrder])
}

/// One answer option.
///
/// `isCorrect` lives here and **must never be serialised to a learner before
/// submission**. The paper-building select in the repository omits it; that
/// omission is the control, and it is asserted by a test.
model TrainingQuestionOption {
  id         String @id @default(cuid())
  questionId String

  label     String
  isCorrect Boolean @default(false)
  sortOrder Int

  createdAt DateTime @default(now())

  question TrainingQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  answers  TrainingAnswerOption[]

  @@unique([questionId, sortOrder])
  @@index([questionId])
}

/// One sitting of one assessment by one learner.
///
/// `attemptNumber` is unique per (enrollment, assessment), which is what enforces
/// the attempt limit under concurrency: two simultaneous starts cannot both claim
/// attempt 3.
model TrainingAttempt {
  id           String @id @default(cuid())
  enrollmentId String
  assessmentId String

  attemptNumber Int

  status TrainingAttemptStatus @default(IN_PROGRESS)

  startedAt DateTime  @default(now())
  /// When the attempt must be in by, where the assessment is timed. Computed on
  /// start from the server's clock, never the client's.
  expiresAt DateTime?
  submittedAt DateTime?

  /*
    The result. All four move together on submission — a CHECK enforces that a
    settled attempt carries them and an in-progress one does not, so a score can
    never exist without the pass decision that goes with it.
  */
  score       Decimal? @db.Decimal(5, 2)
  maxScore    Decimal? @db.Decimal(5, 2)
  percentage  Decimal? @db.Decimal(5, 2)
  passed      Boolean?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  enrollment TrainingEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  assessment TrainingAssessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  answers TrainingAnswer[]

  @@unique([enrollmentId, assessmentId, attemptNumber])
  @@index([enrollmentId, status])
  @@index([assessmentId, status])
}

/// One learner's answer to one question within one attempt.
model TrainingAnswer {
  id         String @id @default(cuid())
  attemptId  String
  questionId String

  /// Graded server-side at submission. Never accepted from the client.
  isCorrect   Boolean @default(false)
  pointsAwarded Decimal @default(0.00) @db.Decimal(5, 2)

  createdAt DateTime @default(now())

  attempt  TrainingAttempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question TrainingQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  selectedOptions TrainingAnswerOption[]

  /// One answer per question per attempt.
  @@unique([attemptId, questionId])
  @@index([attemptId])
}

/// Which options a learner selected.
///
/// A join table rather than an array, so a selection can be validated against the
/// question that owns it — the check that stops an answer referring to another
/// assessment's options.
model TrainingAnswerOption {
  id       String @id @default(cuid())
  answerId String
  optionId String

  answer TrainingAnswer         @relation(fields: [answerId], references: [id], onDelete: Cascade)
  option TrainingQuestionOption @relation(fields: [optionId], references: [id], onDelete: Cascade)

  @@unique([answerId, optionId])
  @@index([optionId])
}

/// A practical exercise submission.
///
/// The reviewer is an Employee, and the service refuses a learner reviewing their
/// own — enforced there rather than by a CHECK, because the comparison needs the
/// enrollment's employee and a row-local constraint cannot reach it.
model PracticalSubmission {
  id           String @id @default(cuid())
  enrollmentId String
  moduleId     String

  status PracticalSubmissionStatus @default(NOT_STARTED)

  /// What the learner submitted. Prose and an optional stored artefact.
  submissionNotes  String?
  secureDocumentId String?
  submittedAt      DateTime?

  /// Who reviews it. Assigned up front where known.
  reviewerId String?

  /// The decision. All three move together — a CHECK enforces it.
  reviewedAt   DateTime?
  reviewNotes  String?
  reviewedById String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  enrollment     TrainingEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  module         TrainingModule     @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  reviewer       Employee?          @relation("PracticalReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)
  reviewedBy     Employee?          @relation("PracticalReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)
  secureDocument SecureDocument?    @relation("PracticalArtefact", fields: [secureDocumentId], references: [id], onDelete: SetNull)

  /// One submission row per module per enrollment, amended on resubmission rather
  /// than accumulating rows nobody can order.
  @@unique([enrollmentId, moduleId])
  @@index([reviewerId, status])
  @@index([status])
}

/// A shadowing period — learning by watching somebody do the work.
model ShadowingRecord {
  id           String @id @default(cuid())
  enrollmentId String
  moduleId     String

  /// Who is being shadowed. An existing Employee — no fake mentor records.
  mentorId String?

  status ShadowingStatus @default(SCHEDULED)

  scheduledFrom DateTime? @db.Date
  scheduledTo   DateTime? @db.Date

  /// What the learner should observe. Plain text, one item per line — a checklist
  /// table would be a second ordering for no behaviour this phase needs.
  checklist String?

  /// The mentor's account of it, and the sign-off. All three move together.
  feedback    String?
  signedOffAt DateTime?
  signedOffById String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  enrollment  TrainingEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  module      TrainingModule     @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  mentor      Employee?          @relation("ShadowingMentor", fields: [mentorId], references: [id], onDelete: SetNull)
  signedOffBy Employee?          @relation("ShadowingSignedOffBy", fields: [signedOffById], references: [id], onDelete: SetNull)

  @@unique([enrollmentId, moduleId])
  @@index([mentorId, status])
  @@index([status])
}

/// Qualification for live work.
///
/// Deliberately a record of its own rather than a flag on Employee, because it is
/// a different business state from employment: somebody can be employed and not yet
/// qualified, and qualifying must not touch `Employee.status`, probation, or the
/// employment timeline.
///
/// Unique on `enrollmentId`: one enrollment grants qualification once.
model TrainingQualification {
  id           String @id @default(cuid())
  enrollmentId String @unique

  /// Granted only when `qualificationGaps` is empty — computed server-side from
  /// the program's requirement flags and the learner's actual progress. There is
  /// no field a client can set to make this true.
  qualifiedAt DateTime

  /// Who granted it. A User, because it is an action an account took.
  grantedById String

  /// The final assessment result it rested on, where one was required.
  finalAttemptId String?
  finalScore     Decimal? @db.Decimal(5, 2)

  notes String?

  /// Revocation. Kept rather than deleted — that somebody was qualified and then
  /// was not is exactly the history worth having.
  revokedAt      DateTime?
  revokedById    String?
  revocationReason String?

  /// The certificate reference, where one was issued. A number and a date on this
  /// record rather than a table of its own: a certificate with no template,
  /// issuer or renewal story is not an entity yet.
  certificateCode String?   @unique
  certificateIssuedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  enrollment TrainingEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  grantedBy  User               @relation("TrainingQualificationGrantedBy", fields: [grantedById], references: [id], onDelete: Restrict)
  revokedBy  User?              @relation("TrainingQualificationRevokedBy", fields: [revokedById], references: [id], onDelete: SetNull)

  @@index([qualifiedAt])
}

/// One allocated training reference sequence.
///
/// The same mechanism as `RecruitmentCodeCounter` and `EmployeeIdCounter`:
/// INSERT … ON CONFLICT DO UPDATE … RETURNING inside the creating transaction,
/// because `SELECT max(...) + 1` read by two concurrent creates hands both the
/// same number.
model TrainingCodeCounter {
  scope     String   @id
  lastValue Int      @default(0)
  updatedAt DateTime @updatedAt
}

// ---------------------------------------------------------------------------
//  HR Phase 5 — Performance Management
// ---------------------------------------------------------------------------
//
// ### The separation-of-duties rule this schema is shaped around
//
// An appraisal is only worth something if the person being appraised did not write
// it, and did not approve it. Three of the decisions below exist for that reason
// alone:
//
//   - `SelfAssessment` and `ManagerAssessment` are **separate tables**, not two
//     halves of one review row. One row with `selfComments` and `managerComments`
//     would mean a single UPDATE could write both, and the only thing standing
//     between an employee and their own manager review would be a service
//     remembering which columns it was allowed to touch.
//   - `PerformanceReview.finalizedById` references **User**, not Employee, and is
//     written only at finalisation. The service refuses a finaliser who is the
//     subject; `performance_review_finalized_has_approver` makes a finalized review
//     without a named approver impossible at the database level.
//   - `CompetencyRating` carries a `source` and is keyed unique per
//     (review, competency, source). An employee writing a MANAGER-sourced rating
//     into their own review collides with the manager's row rather than silently
//     adding a second opinion.
//
// ### Why a cycle owns its competency sheet
//
// `CompetencyDefinition.cycleId` is required and cascades. A global competency
// library was the obvious alternative and is wrong: the attributes a business rates
// change, and a shared library means either editing the definition a past review
// was judged against — rewriting history — or accumulating retired competencies
// forever. A cycle's sheet is fixed when it opens, so a review always shows what it
// was actually rated on.
//
// ### Decimal, never Float
//
// Every rating, weight, target, measured value and attainment is `Decimal`. An
// appraisal figure feeds pay conversations; `0.1 + 0.2 !== 0.3` is not an
// acceptable property for a number somebody disputes. The same reasoning as the
// money columns in Sales and the pass marks in Training.

enum ReviewCycleStatus {
  DRAFT
  ACTIVE
  CLOSED
  ARCHIVED
}

enum ReviewCycleCadence {
  MONTHLY
  QUARTERLY
  HALF_YEARLY
  ANNUAL
  AD_HOC
}

/// Where one person's review stands. The order is the progression; the service
/// decides which transitions are legal and who may make each one.
enum PerformanceReviewStatus {
  NOT_STARTED
  SELF_ASSESSMENT
  PENDING_MANAGER
  MANAGER_REVIEW
  PENDING_APPROVAL
  FINALIZED
  CANCELLED
}

enum GoalScope {
  EMPLOYEE
  DEPARTMENT
}

/// Three outcomes rather than two: forcing a 70%-of-target result to be called
/// either a success or a failure produces a number worth nothing.
enum GoalStatus {
  DRAFT
  ACTIVE
  ACHIEVED
  PARTIALLY_MET
  MISSED
  CANCELLED
}

/// How a KPI is measured, and therefore how its attainment is computed.
enum KpiMetricKind {
  NUMBER
  PERCENTAGE
  CURRENCY
  DURATION
  BOOLEAN
}

/// Which way is good. Without this, a KPI for "average handling time" would score
/// a team as failing for reducing exactly what they were asked to reduce.
enum KpiDirection {
  HIGHER_IS_BETTER
  LOWER_IS_BETTER
}

enum CompetencyCategory {
  CORE
  FUNCTIONAL
  LEADERSHIP
  BEHAVIOURAL
}

/// Who gave a rating. Part of the unique key on CompetencyRating, which is what
/// stops an employee filing a MANAGER-sourced rating in their own review.
enum RatingSource {
  SELF
  MANAGER
  HR
}

enum DevelopmentPlanStatus {
  OPEN
  COMPLETED
  ABANDONED
}

/// IMPROVEMENT is the formal underperformance case; GROWTH is a next step. Kept
/// distinct so no screen shows a promotion track and a formal warning alike.
enum DevelopmentPlanKind {
  IMPROVEMENT
  GROWTH
}

/// One appraisal period.
///
/// Born DRAFT so it can be configured — dates, thresholds, competencies — without
/// anybody being reviewed against a half-built sheet. Opening it is a named act
/// that stamps `activatedAt`, because a cycle that became live with nothing saying
/// who opened it is a cycle nobody can audit.
model ReviewCycle {
  id   String @id @default(cuid())
  /// The reference quoted internally — "PRF-2026-0001". Allocated server-side from
  /// the same counter mechanism as employee numbers and requisition codes.
  code String @unique

  name        String
  description String?

  cadence ReviewCycleCadence @default(ANNUAL)
  status  ReviewCycleStatus  @default(DRAFT)

  /// The period being appraised. Dates, not instants: an appraisal period is a
  /// span of calendar days in company time, and storing a timestamp would make
  /// "Q1" depend on the reader's timezone.
  periodStart DateTime @db.Date
  periodEnd   DateTime @db.Date

  /// When each side's work is expected. Null means no stated deadline, which is
  /// different from a deadline of today — the overdue figures skip these.
  selfAssessmentDueOn DateTime? @db.Date
  managerReviewDueOn  DateTime? @db.Date

  /// Which department this covers. Null is the whole company. SetNull so
  /// archiving a department does not delete the cycle that appraised it.
  targetDepartmentId String?

  /*
    This cycle's own goal thresholds. The business defaults are 100 and 50 and a
    CHECK keeps them ordered and in range, but a cycle may state its own — a
    stretch cycle might call 110% "achieved". Nothing in the services compares
    against the constants; they read whatever the cycle holds.
  */
  goalAchievementThreshold Decimal @default(100.00) @db.Decimal(6, 2)
  goalPartialThreshold     Decimal @default(50.00) @db.Decimal(6, 2)

  createdById String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  activatedAt DateTime?
  closedAt    DateTime?
  archivedAt  DateTime?
  /// Why it was closed early, where it was.
  closureReason String?

  targetDepartment Department? @relation("ReviewCycleDepartment", fields: [targetDepartmentId], references: [id], onDelete: SetNull)
  createdBy        User        @relation("ReviewCycleCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  competencies CompetencyDefinition[]
  reviews      PerformanceReview[]
  goals        PerformanceGoal[]

  @@index([status, periodStart])
  @@index([targetDepartmentId, status])
}

/// One attribute a cycle rates.
///
/// Cascade from the cycle: a deleted cycle's sheet has nothing to describe. The
/// service refuses deleting a cycle that has reviews, so this cascade only ever
/// fires on a DRAFT cycle nobody was reviewed in.
model CompetencyDefinition {
  id      String @id @default(cuid())
  cycleId String

  name        String
  category    CompetencyCategory @default(CORE)
  description String?

  /// Relative importance within the sheet. A CHECK keeps it in (0, 100].
  weight Decimal @default(100.00) @db.Decimal(5, 2)

  sortOrder Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cycle   ReviewCycle        @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  ratings CompetencyRating[]

  /// One competency of a given name per cycle. Two "Communication" rows on one
  /// sheet would mean a reviewer rating the same thing twice with no way to tell
  /// the rows apart.
  @@unique([cycleId, name])
  @@index([cycleId, sortOrder])
}

/// A goal, owned by exactly one employee or one department.
///
/// Two nullable owner columns with a CHECK rather than a polymorphic owner, because
/// the two are read by different people and scoped differently — and a polymorphic
/// `ownerType`/`ownerId` pair cannot be a foreign key at all, so a goal could
/// reference an employee who no longer exists.
model PerformanceGoal {
  id   String @id @default(cuid())
  /// The reference quoted in conversation — "GOL-2026-0042".
  code String @unique

  title           String
  description     String?
  /// How success was defined, in the words agreed at the time. Kept verbatim: a
  /// goal renegotiated later should show what was originally asked.
  successCriteria String?

  scope  GoalScope
  status GoalStatus @default(DRAFT)

  /// Exactly one is set — `goal_exactly_one_owner` enforces it.
  employeeId   String?
  departmentId String?

  /// The cycle this is appraised in. Null for a goal that stands outside any
  /// cycle, which is legitimate: a project objective with its own dates.
  /// SetNull so archiving a cycle does not delete the goals it contained.
  cycleId String?

  startOn DateTime @db.Date
  dueOn   DateTime @db.Date

  /// Weight within the owner's goal set. A CHECK keeps it in (0, 100].
  weight Decimal @default(100.00) @db.Decimal(5, 2)

  /*
    Cached roll-up of this goal's KPI attainment, as a percentage.

    Stored rather than computed on read, and that is a deliberate trade: the
    dashboard and the goal list both need it across hundreds of rows, and
    recomputing from child KPIs per row is a join and an aggregate per goal. It is
    written only by the service, inside the same transaction as the KPI progress
    that changed it, so it cannot drift from its inputs.

    Null means no KPI has a recorded value — which is NOT zero, and the UI shows
    them differently: nothing recorded is not the same as nothing achieved.
  */
  attainment Decimal? @db.Decimal(8, 2)

  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  /// Set together when the goal reaches a terminal status.
  /// `goal_closure_complete` requires all three or none.
  closedById   String?
  closedAt     DateTime?
  closureNote  String?

  employee   Employee?    @relation("GoalEmployee", fields: [employeeId], references: [id], onDelete: Cascade)
  department Department?  @relation("GoalDepartment", fields: [departmentId], references: [id], onDelete: Cascade)
  cycle      ReviewCycle? @relation(fields: [cycleId], references: [id], onDelete: SetNull)
  createdBy  User         @relation("GoalCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  closedBy   User?        @relation("GoalClosedBy", fields: [closedById], references: [id], onDelete: SetNull)

  kpis          PerformanceKpi[]
  reviewLinks   ReviewGoalLink[]

  @@index([employeeId, status])
  @@index([departmentId, status])
  @@index([cycleId, status])
  @@index([status, dueOn])
}

/// One measurable indicator under a goal.
///
/// This model is what makes a target *measurable* rather than a sentence somebody
/// rates out of five. `targetValue` and `currentValue` are Decimal; `direction`
/// decides whether attainment improves by going up or down, and without it a KPI
/// for "average handling time" would score a team as failing for reducing exactly
/// what they were asked to reduce.
model PerformanceKpi {
  id     String @id @default(cuid())
  goalId String

  name        String
  description String?

  metricKind KpiMetricKind
  direction  KpiDirection  @default(HIGHER_IS_BETTER)

  /// Decimal(14,2): wide enough for a currency target, exact for a percentage.
  targetValue   Decimal  @db.Decimal(14, 2)
  /// Where it stood at the start. Optional, and used by the attainment arithmetic
  /// when present so progress is measured from the baseline rather than from zero.
  baselineValue Decimal? @db.Decimal(14, 2)
  /// The latest recorded figure. Null until somebody records progress.
  currentValue  Decimal? @db.Decimal(14, 2)

  /// Display only — "orders", "₹", "minutes". No arithmetic reads it; the unit a
  /// calculation cares about comes from `metricKind`.
  unitLabel String?

  /// Weight within the goal. A CHECK keeps it in (0, 100].
  weight Decimal @default(100.00) @db.Decimal(5, 2)

  /// Cached attainment percentage, written with `currentValue` in one transaction.
  /// Uncapped: 140% of target is a fact worth keeping, and clamping it to 100 would
  /// erase exactly what an appraisal exists to surface.
  attainment Decimal? @db.Decimal(8, 2)

  sortOrder Int @default(0)

  lastUpdatedById String?
  lastUpdatedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  goal          PerformanceGoal    @relation(fields: [goalId], references: [id], onDelete: Cascade)
  lastUpdatedBy User?              @relation("KpiLastUpdatedBy", fields: [lastUpdatedById], references: [id], onDelete: SetNull)
  progress      KpiProgressRecord[]

  @@unique([goalId, name])
  @@index([goalId, sortOrder])
}

/// One recorded movement on a KPI.
///
/// Append-only by intent, like `EmployeeHistory`: rows are written and never
/// updated, so the history of a number cannot be quietly rewritten. The KPI's
/// `currentValue` is the latest of these and is cached on the parent for reading.
model KpiProgressRecord {
  id    String @id @default(cuid())
  kpiId String

  value Decimal @db.Decimal(14, 2)
  note  String?

  recordedById String
  recordedAt   DateTime @default(now())

  kpi        PerformanceKpi @relation(fields: [kpiId], references: [id], onDelete: Cascade)
  recordedBy User           @relation("KpiProgressRecordedBy", fields: [recordedById], references: [id], onDelete: Restrict)

  @@index([kpiId, recordedAt])
}

/// One person's review within one cycle.
///
/// The spine of the phase. Status drives everything, and the two assessment tables
/// hang off it rather than living in its columns — see the file note on separation
/// of duties.
///
/// `reviewerId` is the manager who owes the review, captured **at generation time**
/// rather than read live from `Employee.managerId`. That is deliberate: if somebody
/// changes manager mid-cycle, the review is still owed by the person who actually
/// managed them over the period, and a live lookup would silently reassign it.
model PerformanceReview {
  id      String @id @default(cuid())
  cycleId String

  employeeId String
  /// Who owes the manager review. Nullable: an employee with no manager set still
  /// gets a review, and HR writes it. SetNull so a departing manager does not
  /// delete their reports' appraisals.
  reviewerId String?

  status PerformanceReviewStatus @default(NOT_STARTED)

  /*
    The three ratings, each Decimal(4,2) over the 1.00–5.00 scale and each null
    until its own side has submitted. Three columns rather than one, because they
    answer different questions and the gap between them is what the appraisal
    conversation is about.

    `finalRating` is the figure of record. It is written once, at finalisation, by
    somebody holding APPROVE who is not the subject.
  */
  selfOverallRating    Decimal? @db.Decimal(4, 2)
  managerOverallRating Decimal? @db.Decimal(4, 2)
  finalRating          Decimal? @db.Decimal(4, 2)

  /// Weighted goal attainment across this review's goals, cached at finalisation
  /// and refreshed on read while the review is open. Null when nothing is recorded.
  goalAttainment Decimal? @db.Decimal(8, 2)

  selfSubmittedAt    DateTime?
  managerSubmittedAt DateTime?

  /// Finalisation. `finalizedById` is a **User**, because approving is an act of
  /// the account rather than of an employment record — and HR approvers do not all
  /// have Employee rows. `performance_review_finalized_has_approver` makes a
  /// FINALIZED review with no named approver impossible.
  finalizedById String?
  finalizedAt   DateTime?
  finalComments String?

  cancelledAt        DateTime?
  cancellationReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cycle       ReviewCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  employee    Employee    @relation("PerformanceReviewEmployee", fields: [employeeId], references: [id], onDelete: Cascade)
  reviewer    Employee?   @relation("PerformanceReviewReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)
  finalizedBy User?       @relation("PerformanceReviewFinalizedBy", fields: [finalizedById], references: [id], onDelete: SetNull)

  selfAssessment    SelfAssessment?
  managerAssessment ManagerAssessment?
  competencyRatings CompetencyRating[]
  goalLinks         ReviewGoalLink[]
  developmentPlans  DevelopmentPlan[]

  /// One review per person per cycle. The invariant that stops a second review
  /// being generated for somebody a batch already covered.
  @@unique([cycleId, employeeId])
  @@index([reviewerId, status])
  @@index([employeeId, status])
  @@index([cycleId, status])
}

/// The employee's own account of their period.
///
/// A separate table from `ManagerAssessment` on purpose. One row carrying both
/// sides would mean a single UPDATE could write either, and the only protection
/// against an employee writing their own manager review would be a service
/// remembering which columns it may touch. Two tables make the wrong write
/// impossible to express rather than merely forbidden.
///
/// `@unique` on reviewId: one self-assessment per review, enforced by the database.
model SelfAssessment {
  id       String @id @default(cuid())
  reviewId String @unique

  achievements      String?
  challenges        String?
  /// What they want next. Usually what a development plan is built from.
  developmentWishes String?

  overallRating Decimal? @db.Decimal(4, 2)

  /// Null while a draft. Set by the submit endpoint, never by the client.
  submittedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  review PerformanceReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)
}

/// The manager's assessment of the period.
///
/// `submittedById` is the User who submitted, recorded because HR may legitimately
/// write a review for an employee whose manager has left — and the record should
/// say who actually wrote it rather than implying the stored reviewer did.
model ManagerAssessment {
  id       String @id @default(cuid())
  reviewId String @unique

  strengths        String?
  improvementAreas String?
  comments         String?

  overallRating Decimal? @db.Decimal(4, 2)

  /// Null means not stated, which is different from "no". A screen must not read
  /// an unanswered question as a negative recommendation.
  promotionRecommended Boolean?

  submittedAt   DateTime?
  submittedById String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  review      PerformanceReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  submittedBy User?             @relation("ManagerAssessmentSubmittedBy", fields: [submittedById], references: [id], onDelete: SetNull)
}

/// One rating of one competency by one party.
///
/// Rows rather than `selfRating`/`managerRating` columns, for two reasons. A third
/// rater — a peer, a skip-level — is a plausible later requirement and would
/// otherwise be a migration plus every query rewritten. And the unique key below
/// does real work: an employee attempting to write a MANAGER-sourced rating into
/// their own review collides with the manager's row rather than silently adding a
/// second opinion the averages would then include.
model CompetencyRating {
  id           String @id @default(cuid())
  reviewId     String
  competencyId String

  source RatingSource

  /// 1–5. A CHECK enforces the range, matching Phase 3's interview feedback and
  /// probation reviews — two HR scales differing by a point would make the two
  /// incomparable for no benefit.
  rating   Int
  comments String?

  /// The User who recorded it. Restrict: a rating whose author vanished is a
  /// rating nobody can stand behind.
  ratedById String
  ratedAt   DateTime @default(now())
  updatedAt DateTime @updatedAt

  review     PerformanceReview    @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  competency CompetencyDefinition @relation(fields: [competencyId], references: [id], onDelete: Cascade)
  ratedBy    User                 @relation("CompetencyRatedBy", fields: [ratedById], references: [id], onDelete: Restrict)

  @@unique([reviewId, competencyId, source])
  @@index([reviewId])
}

/// Which goals a review appraises.
///
/// A join table rather than `PerformanceGoal.reviewId`, because a goal can
/// legitimately appear in more than one review — a two-year objective appraised in
/// both years — and a single foreign key would force a choice between duplicating
/// the goal and losing one of the appraisals.
model ReviewGoalLink {
  id       String @id @default(cuid())
  reviewId String
  goalId   String

  /// The goal's attainment as it stood when this review was finalized. A snapshot,
  /// because the live figure keeps moving and a finalized review must not change.
  attainmentAtFinalisation Decimal? @db.Decimal(8, 2)

  createdAt DateTime @default(now())

  review PerformanceReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  goal   PerformanceGoal   @relation(fields: [goalId], references: [id], onDelete: Cascade)

  @@unique([reviewId, goalId])
  @@index([goalId])
}

/// A development or improvement plan.
///
/// `kind` separates the two cases that must not look alike: IMPROVEMENT is the
/// formal underperformance case with a mandatory review date, GROWTH is somebody
/// doing well who wants a next step. A screen showing them identically would put a
/// promotion track beside a formal warning and call both "development".
model DevelopmentPlan {
  id         String @id @default(cuid())
  employeeId String

  kind   DevelopmentPlanKind
  status DevelopmentPlanStatus @default(OPEN)

  title          String
  objective      String?
  /// What the business will do to help. An improvement plan that lists only what
  /// the employee must change is a warning, not a plan.
  supportOffered String?

  /// When it will be reviewed. Required for IMPROVEMENT —
  /// `development_plan_improvement_has_review_date` enforces it.
  reviewOn DateTime? @db.Date

  /// The review this came out of, where it did. SetNull so deleting a draft review
  /// does not delete the plan that outlived it.
  reviewId String?

  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  closedById  String?
  closedAt    DateTime?
  outcomeNote String?

  employee  Employee           @relation("DevelopmentPlanEmployee", fields: [employeeId], references: [id], onDelete: Cascade)
  review    PerformanceReview? @relation(fields: [reviewId], references: [id], onDelete: SetNull)
  createdBy User               @relation("DevelopmentPlanCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  closedBy  User?              @relation("DevelopmentPlanClosedBy", fields: [closedById], references: [id], onDelete: SetNull)

  actions DevelopmentAction[]

  @@index([employeeId, status])
  @@index([status, reviewOn])
  @@index([reviewId])
}

/// One thing a plan says will be done.
model DevelopmentAction {
  id     String @id @default(cuid())
  planId String

  description String
  dueOn       DateTime? @db.Date

  isCompleted   Boolean   @default(false)
  completedAt   DateTime?
  completedById String?

  sortOrder Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  plan        DevelopmentPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  completedBy User?           @relation("DevelopmentActionCompletedBy", fields: [completedById], references: [id], onDelete: SetNull)

  @@index([planId, sortOrder])
}

/// One allocated performance reference sequence.
///
/// The same mechanism as `RecruitmentCodeCounter` and `EmployeeIdCounter`, present
/// for the same reason: `SELECT max(...) + 1` read by two concurrent creates hands
/// both the same number, and these references are quoted in appraisal conversations.
///
/// `scope` holds a kind-and-period string — "PRF-2026" for cycles, "GOL-2026" for
/// goals. A second series is a second row rather than a migration.
model PerformanceCodeCounter {
  scope     String   @id
  lastValue Int      @default(0)
  updatedAt DateTime @updatedAt
}

// ===========================================================================
//  HR Phase 6 — Payroll & Compensation
// ===========================================================================
//
// One rule governs this whole block: **nothing here encodes a statutory rule.**
//
// No provident-fund rate, no insurance threshold, no tax slab, no overtime
// multiplier and no rounding policy appears as a default, a constant or a CHECK.
// Each is a configured `SalaryComponent` row or an `HRSetting`. A rate written
// into a shipped schema is a legal claim this codebase cannot substantiate and
// cannot correct without a migration, and payroll errors are recovered from
// people's livelihoods. See `backend/src/modules/hr/PAYROLL-SCOPE.md`.
//
// Three structural decisions worth stating before the models:
//
//   1. **Salary assignments are append-only.** Changing somebody's pay inserts a
//      row with a later `effectiveFrom`; nothing updates one in place. A payslip
//      from eight months ago must stay explicable from the assignment that
//      produced it.
//   2. **A finalised period stores a snapshot per employee.** Every input can
//      legitimately change afterwards — the rate, the structure, the assignment,
//      the attendance policy — so the computation is frozen as JSON rather than
//      recomputed. A payslip that recomputed itself would silently restate what
//      somebody was paid.
//   3. **The period carries its own arithmetic policy.** `dailyRateBasis`,
//      `roundingMode` and `payableDaysDivisor` live on the row. If the business
//      switches basis in April, March still reconciles.

/// Whether a component adds to pay, subtracts from it, or is an employer cost.
///
/// EMPLOYER_CONTRIBUTION is separate from DEDUCTION deliberately: both are costs,
/// but only a deduction reduces net pay. An employer's share of a retirement fund
/// never passes through the employee's hands, and netting it off their payslip
/// would understate what they were paid.
enum SalaryComponentKind {
  EARNING
  DEDUCTION
  EMPLOYER_CONTRIBUTION
}

/// How a component's amount is arrived at.
///
/// PERCENT_OF_GROSS is evaluated after every FIXED and PERCENT_OF_BASE earning,
/// and may not be an input to another PERCENT_OF_GROSS. A percentage of a total
/// that includes itself is a fixed-point problem rather than a payroll line, and
/// the service refuses the configuration instead of iterating to a figure nobody
/// can reproduce by hand.
enum SalaryCalculationKind {
  FIXED
  PERCENT_OF_BASE
  PERCENT_OF_GROSS
  FORMULA_BALANCE
}

/// Which divisor turns a monthly figure into a daily one.
///
/// All three are in real use and they disagree by up to 10% on the same salary,
/// which is exactly why the choice is stored per period rather than derived.
enum DailyRateBasis {
  CALENDAR_DAYS
  WORKING_DAYS
  FIXED_THIRTY
}

/// How a monetary result is rounded to paise. Stored per period, for the same
/// reason the divisor basis is.
enum MonetaryRoundingMode {
  HALF_UP
  HALF_EVEN
  DOWN
}

/// Where a payroll run stands.
///
/// There is no transition out of FINALIZED, and no FINALIZED → PAID either.
/// Nothing in this module moves money: marking a row PAID when no bank
/// instruction has been issued would make the system assert something untrue
/// about an employee's livelihood. Correcting a finalised run means a
/// `PayrollAdjustment` in a later period, never an edit to a figure somebody has
/// already been paid against.
enum PayrollPeriodStatus {
  DRAFT
  CALCULATED
  PENDING_APPROVAL
  APPROVED
  FINALIZED
  CANCELLED
}

/// Where one employee's line within a run stands.
///
/// Separate from the period's status so one employee can be held back without
/// stopping ninety colleagues from being paid. EXCLUDED earns its place: a
/// zero-value payslip and a deliberate exclusion look identical in a total and
/// mean entirely different things to the person not being paid.
enum PayrollItemStatus {
  PENDING
  CALCULATED
  EXCLUDED
  FINALIZED
}

/// Why an employee was held out of a run.
///
/// Recorded rather than inferred, because "why was I not paid" is the one
/// question this module must always be able to answer.
enum PayrollExclusionReason {
  NOT_ELIGIBLE
  NO_SALARY_ASSIGNMENT
  JOINED_AFTER_PERIOD
  EXITED_BEFORE_PERIOD
  MANUALLY_EXCLUDED
}

/// What an adjustment does to a later period. The correction mechanism, since a
/// finalised period cannot be edited.
enum PayrollAdjustmentKind {
  ARREAR
  RECOVERY
  BONUS
  REIMBURSEMENT
}

/// One configurable line that can appear on a payslip.
///
/// `calculation` and `rate` together are where every statutory figure in this
/// system lives. A provident-fund deduction is a DEDUCTION with PERCENT_OF_BASE
/// and whatever rate the business configured; the schema holds no opinion on
/// what that rate should be.
model SalaryComponent {
  id String @id @default(cuid())

  /// Stable, upper snake case. Appears in immutable snapshots that must stay
  /// readable years later, which is why it is unique and never reused.
  code String @unique
  name String
  description String?

  kind        SalaryComponentKind
  calculation SalaryCalculationKind

  /// A percentage, for the two PERCENT_* kinds. Null otherwise — the
  /// salary_component_rate_presence CHECK enforces that pairing, so a percentage
  /// component with no rate cannot exist to compute nothing.
  rate Decimal? @db.Decimal(6, 2)

  /// An upper bound on the computed amount, where policy caps it. This is how a
  /// capped statutory contribution is configured without the cap being code.
  capAmount Decimal? @db.Decimal(12, 2)

  /// Below this gross the component does not apply. How an eligibility threshold
  /// is configured, again without the threshold being code.
  floorAmount Decimal? @db.Decimal(12, 2)

  /// The single earning that PERCENT_OF_BASE components are taken of. At most one
  /// per structure; the service enforces that, since it is a property of a set.
  isBase Boolean @default(false)

  /// Whether unpaid-leave proration reduces this component. A fixed reimbursement
  /// typically does not; a basic salary does.
  prorates Boolean @default(true)

  /// For reporting only. **No tax is computed anywhere in this module.**
  isTaxable Boolean @default(true)

  isActive     Boolean @default(true)
  displayOrder Int     @default(100)

  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  createdBy User? @relation("SalaryComponentCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  structureComponents SalaryStructureComponent[]
  salaryOverrides     EmployeeSalaryComponent[]

  @@index([kind, isActive, displayOrder])
  @@index([isActive, displayOrder])
}

/// A named set of components, assignable to employees.
model SalaryStructure {
  id String @id @default(cuid())

  code String @unique
  name String
  description String?

  /// Stored rather than global, so adding a second currency later is a migration
  /// of defaults rather than a rewrite of every read path.
  currency String @default("INR")

  isActive Boolean @default(true)

  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  createdBy User? @relation("SalaryStructureCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  components  SalaryStructureComponent[]
  assignments EmployeeSalary[]

  @@index([isActive, name])
}

/// One component's place and value within a structure.
model SalaryStructureComponent {
  id String @id @default(cuid())

  structureId String
  componentId String

  /// The monthly amount, for FIXED components. Null for rate-based ones, whose
  /// figure is computed from the rate at calculation time.
  amount Decimal? @db.Decimal(12, 2)

  /// Overrides the component's own rate for this structure only.
  rateOverride Decimal? @db.Decimal(6, 2)

  displayOrder Int @default(100)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Cascade from the structure: a deleted structure's rows describe nothing. The
  /// service refuses deleting a structure that has assignments, so this cascade
  /// only ever reaches an unused draft.
  structure SalaryStructure @relation(fields: [structureId], references: [id], onDelete: Cascade)
  /// Restrict from the component: a component in use must not vanish from under
  /// a structure. Deactivate it instead.
  component SalaryComponent @relation(fields: [componentId], references: [id], onDelete: Restrict)

  /// One row per component per structure. A component appearing twice would be
  /// counted twice in the gross with nothing saying which row was meant.
  @@unique([structureId, componentId])
  @@index([structureId, displayOrder])
  @@index([componentId])
}

/// One employee's salary, effective from a date.
///
/// **Append-only.** Changing pay inserts a new row with a later `effectiveFrom`
/// and sets `effectiveTo` on the previous one; nothing is ever updated in place.
/// That is what keeps a historical payslip explicable, and it is why there is no
/// update endpoint for this model.
model EmployeeSalary {
  id String @id @default(cuid())

  employeeId  String
  structureId String?

  /// The agreed monthly gross this assignment is built around. FORMULA_BALANCE
  /// components resolve against it.
  monthlyGross Decimal @db.Decimal(12, 2)
  currency     String  @default("INR")

  effectiveFrom DateTime @db.Date
  /// Null while in force; set when a later assignment supersedes it. Not derived
  /// at read time, so "what was in force in March" is an index lookup rather than
  /// a window function over every row.
  effectiveTo DateTime? @db.Date

  notes String?

  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  employee  Employee         @relation("EmployeeSalaryEmployee", fields: [employeeId], references: [id], onDelete: Cascade)
  structure SalaryStructure? @relation(fields: [structureId], references: [id], onDelete: Restrict)
  createdBy User?            @relation("EmployeeSalaryCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  overrides   EmployeeSalaryComponent[]
  payrollItems PayrollItem[]

  /// One assignment per employee per start date. Two salaries beginning the same
  /// day is a data-entry error with no correct resolution, so it is impossible.
  @@unique([employeeId, effectiveFrom])
  @@index([employeeId, effectiveFrom])
  @@index([structureId])
}

/// A per-employee amount or rate that differs from the structure's default.
model EmployeeSalaryComponent {
  id String @id @default(cuid())

  salaryId    String
  componentId String

  amount       Decimal? @db.Decimal(12, 2)
  rateOverride Decimal? @db.Decimal(6, 2)

  createdAt DateTime @default(now())

  /// Cascade from the assignment: an override with no assignment describes
  /// nothing. Safe because assignments are never deleted in normal operation.
  salary    EmployeeSalary  @relation(fields: [salaryId], references: [id], onDelete: Cascade)
  component SalaryComponent @relation(fields: [componentId], references: [id], onDelete: Restrict)

  @@unique([salaryId, componentId])
  @@index([salaryId])
  @@index([componentId])
}

/// A monthly payroll run.
model PayrollPeriod {
  id String @id @default(cuid())

  /// Human reference, allocated from PayrollCodeCounter: "PAY-2026-03".
  code String @unique
  name String

  periodStart DateTime @db.Date
  periodEnd   DateTime @db.Date

  /// The month this run is *for*. Separate from the dates because the dates are
  /// derived from these, and because the unique constraint below is what makes a
  /// duplicate run impossible rather than merely unlikely.
  year  Int
  month Int

  status   PayrollPeriodStatus @default(DRAFT)
  currency String              @default("INR")

  /// The arithmetic policy, frozen onto the row at creation and used at
  /// calculation. A finalised period keeps its own arithmetic forever.
  dailyRateBasis DailyRateBasis       @default(CALENDAR_DAYS)
  roundingMode   MonetaryRoundingMode @default(HALF_UP)
  calendarDays   Int
  workingDays    Int                  @default(0)
  /// The divisor actually used, resolved from the basis when the run was costed.
  /// Zero until calculated, which the payroll_period_divisor_when_costed CHECK
  /// ties to the status.
  payableDaysDivisor Int @default(0)

  /// Server-computed totals, written at calculation. Null before that.
  grossEarnings         Decimal? @db.Decimal(14, 2)
  totalDeductions       Decimal? @db.Decimal(14, 2)
  employerContributions Decimal? @db.Decimal(14, 2)
  netPay                Decimal? @db.Decimal(14, 2)

  employeeCount Int @default(0)

  calculatedAt   DateTime?
  calculatedById String?

  /// The open ApprovalRequest, reusing the existing approval engine rather than
  /// a second one. Unenforced by a FK for the same reason Notification and
  /// AuditLog are: the approval table is polymorphic by design.
  approvalRequestId String?

  approvedAt   DateTime?
  approvedById String?
  finalizedAt  DateTime?
  finalizedById String?

  notes String?
  cancellationReason String?

  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  calculatedBy User? @relation("PayrollCalculatedBy", fields: [calculatedById], references: [id], onDelete: SetNull)
  approvedBy   User? @relation("PayrollApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  finalizedBy  User? @relation("PayrollFinalizedBy", fields: [finalizedById], references: [id], onDelete: SetNull)
  createdBy    User? @relation("PayrollCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  items       PayrollItem[]
  adjustments PayrollAdjustment[] @relation("AdjustmentPaidInPeriod")
  corrections PayrollAdjustment[] @relation("AdjustmentCorrectsPeriod")

  /// **The constraint that makes duplicate payroll impossible.** One run per
  /// calendar month, enforced by the database rather than by a service check that
  /// two concurrent requests could both pass.
  @@unique([year, month])
  @@index([status, year, month])
  @@index([periodStart, periodEnd])
}

/// One employee's line within a run.
model PayrollItem {
  id String @id @default(cuid())

  periodId   String
  employeeId String

  status          PayrollItemStatus       @default(PENDING)
  exclusionReason PayrollExclusionReason?
  exclusionNote   String?

  currency String @default("INR")

  /// The assignment this line was computed from. Restrict, so the salary that
  /// explains a payslip cannot be deleted from under it.
  salaryAssignmentId String?
  monthlyGross       Decimal? @db.Decimal(12, 2)

  /// Attendance-derived inputs, all server-computed and stored so the figure can
  /// be explained without re-reading attendance that may since have been
  /// corrected.
  presentDays     Decimal? @db.Decimal(5, 2)
  paidLeaveDays   Decimal? @db.Decimal(5, 2)
  unpaidLeaveDays Decimal? @db.Decimal(5, 2)
  holidayDays     Decimal? @db.Decimal(5, 2)
  weekOffDays     Decimal? @db.Decimal(5, 2)
  payableDays     Decimal? @db.Decimal(5, 2)
  overtimeMinutes Int?

  grossEarnings         Decimal? @db.Decimal(12, 2)
  totalDeductions       Decimal? @db.Decimal(12, 2)
  employerContributions Decimal? @db.Decimal(12, 2)
  netPay                Decimal? @db.Decimal(12, 2)

  /// The immutable computation, written at finalisation. Json because the shape
  /// is evidence to display rather than data to query, and because every input
  /// can legitimately change afterwards.
  snapshot Json?

  /// The generated payslip, where one exists. A SecureDocument rather than a URL,
  /// so access is resolved by the same permission service as everything else and
  /// the stored link is never publicly fetchable.
  payslipDocumentId String? @unique

  calculatedAt DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  period   PayrollPeriod   @relation(fields: [periodId], references: [id], onDelete: Cascade)
  employee Employee        @relation("PayrollItemEmployee", fields: [employeeId], references: [id], onDelete: Cascade)
  salaryAssignment EmployeeSalary? @relation(fields: [salaryAssignmentId], references: [id], onDelete: Restrict)

  lines PayrollItemLine[]

  /// One line per employee per run. The second half of the duplicate-payroll
  /// guarantee: even if two calculations raced, neither could create a second
  /// line for the same person.
  @@unique([periodId, employeeId])
  @@index([periodId, status])
  @@index([employeeId, createdAt])
  @@index([salaryAssignmentId])
}

/// One component as it landed on one employee's line.
///
/// Written per calculation and replaced on recalculation. The finalised record of
/// these lives in `PayrollItem.snapshot`, which is why deleting and rewriting
/// them during recalculation loses nothing.
model PayrollItemLine {
  id String @id @default(cuid())

  itemId String

  /// Denormalised from the component deliberately. A payslip line must still read
  /// correctly after the component is renamed or deactivated, and joining to a
  /// mutable row would let a historical figure acquire a new label.
  componentCode String
  componentName String
  kind          SalaryComponentKind
  calculation   SalaryCalculationKind

  rate Decimal? @db.Decimal(6, 2)

  /// Before proration, and after. Both stored so a reduced figure can be
  /// explained rather than merely asserted.
  fullAmount Decimal @db.Decimal(12, 2)
  amount     Decimal @db.Decimal(12, 2)

  prorationNote String?
  displayOrder  Int @default(100)

  createdAt DateTime @default(now())

  item PayrollItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([itemId, componentCode])
  @@index([itemId, displayOrder])
}

/// A correction attaching to a later period.
///
/// The only way a finalised figure is corrected. The amount is always positive
/// and `kind` decides its direction, for the same reason a deduction is not a
/// negative earning.
model PayrollAdjustment {
  id String @id @default(cuid())

  employeeId String
  /// The period this is paid in. Null while unassigned, set when a run picks it
  /// up. SetNull rather than Cascade so cancelling a run returns its adjustments
  /// to the queue instead of destroying them.
  periodId String?

  kind     PayrollAdjustmentKind
  amount   Decimal @db.Decimal(12, 2)
  currency String  @default("INR")

  reason String

  /// The finalised period being corrected, where it corrects one. This is what
  /// makes the trail read forwards: period N was wrong, N+1 says so and by how
  /// much.
  correctsPeriodId String?
  reference        String?

  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  employee       Employee       @relation("PayrollAdjustmentEmployee", fields: [employeeId], references: [id], onDelete: Cascade)
  period         PayrollPeriod? @relation("AdjustmentPaidInPeriod", fields: [periodId], references: [id], onDelete: SetNull)
  correctsPeriod PayrollPeriod? @relation("AdjustmentCorrectsPeriod", fields: [correctsPeriodId], references: [id], onDelete: SetNull)
  createdBy      User?          @relation("PayrollAdjustmentCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([employeeId, createdAt])
  @@index([periodId])
  @@index([correctsPeriodId])
}

/// Sequential payroll references, allocated atomically.
///
/// The same mechanism as `PerformanceCodeCounter`, `RecruitmentCodeCounter` and
/// `EmployeeIdCounter`, present for the same reason: `SELECT max(...) + 1` read
/// by two concurrent creates hands both the same number.
///
/// `scope` holds a year string — "PAY-2026".
model PayrollCodeCounter {
  scope     String   @id
  lastValue Int      @default(0)
  updatedAt DateTime @updatedAt
}

// ---------------------------------------------------------------------------
//  Inventory Alerts
//
//  Watches CRM stock — `ShopifyVariant.crmStockQty`, the hand-maintained count
//  — and never Shopify's `inventoryQty`. The two answer different questions:
//  one is what the warehouse holds, the other is what the storefront believes
//  it can sell, and the storefront figure is overwritten by every sync.
//
//  Two tables rather than one, because a configuration and an event have
//  different lifetimes. A threshold is edited; an alert is a fact about a
//  moment and must not change when the threshold later does.
// ---------------------------------------------------------------------------

/// Why an alert stopped being active. Recorded rather than inferred: "stock
/// recovered" and "somebody switched monitoring off" are different stories and
/// a history that cannot tell them apart is not worth keeping.
enum InventoryAlertResolution {
  /// crmStockQty rose above the threshold.
  STOCK_RECOVERED
  /// An administrator disabled monitoring while the alert was live.
  MONITORING_DISABLED
  /// The threshold was lowered so the current stock is no longer low.
  THRESHOLD_CHANGED
  /// The variant itself disappeared — a Shopify sync removed it.
  VARIANT_REMOVED
}

enum InventoryAlertStatus {
  ACTIVE
  RESOLVED
}

/// One variant somebody chose to watch, and the level they chose.
///
/// Keyed on `variantId`, which is `ShopifyVariant.id` — a cuid. Deliberately
/// NOT the SKU: the live catalogue holds five duplicate SKU groups (one SKU on
/// three variants) and two variants with no SKU at all, so a SKU-keyed
/// configuration would silently watch three things as one, or nothing.
model MonitoredVariant {
  id String @id @default(cuid())

  /**
   * The variant being watched — null once it no longer exists.
   *
   * Nullable with `SetNull` rather than non-null with `Cascade`, and that
   * distinction is the whole history-preservation design. A Shopify sync
   * hard-deletes variants absent from a payload; under a cascade the
   * configuration went with the variant, and `InventoryAlert` cascades from the
   * configuration, so the alert history went too — erasing the record that a
   * product had run out of stock, which is exactly the record somebody
   * reviewing a stockout needs.
   *
   * With `SetNull` the configuration row survives with `variantId` null, the
   * history hangs off a row that still exists, and the snapshots on each alert
   * remain the readable description of what happened.
   *
   * `@unique` on a nullable column still does the job: Postgres permits many
   * NULLs in a unique index, so any number of archived configurations coexist
   * while a live variant can still be configured only once.
   */
  variantId String? @unique

  /// The level at or below which stock is low. Non-negative whole units; a
  /// CHECK enforces it in the database as well as in Zod, because a negative
  /// threshold would make every variant permanently alerting.
  threshold Int

  /// Whether this configuration is being evaluated.
  ///
  /// Disabling is not deletion: the row and its alert history stay, so turning
  /// monitoring back on restores the threshold somebody chose rather than
  /// asking them to remember it.
  isActive Boolean @default(true)

  /// Set when the variant this watched no longer exists. The configuration is
  /// archived rather than removed so the history below stays explicable.
  archivedAt DateTime?

  createdById String?
  createdAt   DateTime  @default(now())
  updatedById String?
  updatedAt   DateTime  @updatedAt

  /*
    SetNull, never Cascade. Deleting a variant detaches this row rather than
    removing it, so `archivedAt` can be stamped and the alert history below
    survives. See the note on `variantId` above.
  */
  variant ShopifyVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  createdBy User? @relation("MonitoredVariantCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy User? @relation("MonitoredVariantUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  alerts InventoryAlert[]

  /// The evaluator's own query: every configuration still being watched.
  @@index([isActive])
}

/// One low-stock episode: raised when stock went low, resolved when it stopped.
///
/// ### Why this does not cascade from the variant
///
/// A Shopify sync hard-deletes variants absent from a payload, and
/// `ShopifyVariant` cascades from `RsProduct`. If alert history cascaded from
/// either, a product leaving the Shopify catalogue would erase the record that
/// it ran out of stock — which is exactly the record somebody reviewing a
/// stockout needs. So `variantId` is nullable with `SetNull`, and the columns
/// below snapshot what the row described.
///
/// ### Why the snapshots exist
///
/// `thresholdAtRaise` and `stockAtRaise` are copies, not lookups. An alert
/// says "stock was 2 against a threshold of 10 on this date". Reading the
/// threshold live would rewrite that sentence every time somebody edited the
/// configuration, and the product title and SKU would vanish entirely once the
/// variant did.
model InventoryAlert {
  id                 String @id @default(cuid())
  monitoredVariantId String

  /// Nullable on purpose — see the note above. Null means the variant has been
  /// removed; the snapshots are then the only description of what this was.
  variantId String?

  status     InventoryAlertStatus      @default(ACTIVE)
  resolution InventoryAlertResolution?

  /// What was true when this was raised. Never recomputed.
  thresholdAtRaise Int
  stockAtRaise     Int

  /// Identity and display, copied so history survives the variant.
  productTitleAtRaise String
  skuAtRaise          String?
  /// The product this belonged to, for a link that may later 404. Plain string
  /// rather than a relation: a product can be deleted too.
  rsProductIdAtRaise  String

  raisedAt       DateTime  @default(now())
  resolvedAt     DateTime?
  stockAtResolve Int?

  monitoredVariant MonitoredVariant @relation(fields: [monitoredVariantId], references: [id], onDelete: Cascade)
  variant          ShopifyVariant?  @relation(fields: [variantId], references: [id], onDelete: SetNull)

  /// The alerts page: active first, newest first.
  @@index([status, raisedAt])
  /// One configuration's own history.
  @@index([monitoredVariantId, raisedAt])
  /*
    AT MOST ONE ACTIVE ALERT PER CONFIGURATION.

    Prisma cannot express a partial unique index, so the real guarantee is
    added by hand in the migration:

      CREATE UNIQUE INDEX "InventoryAlert_one_active_per_monitor"
        ON "InventoryAlert"("monitoredVariantId") WHERE status = 'ACTIVE';

    It is a database constraint rather than a service check because two
    concurrent stock updates can both read "no active alert" and both insert.
    The loser gets P2002, which the service treats as "somebody else raised it"
    — the same pattern Notification already uses for its own dedupe.
  */
}
