// =============================================================================
//  RoyalStuffs CRM — relational model
//
//  Module 1 (Product Enquiry) is fully modelled. Customer, Vendor, MediaAsset
//  and User are deliberately built as shared masters so that Sales, Procurement,
//  Packing & Dispatch, Billing, Vendor Invoices and Post-Sales attach by foreign
//  key later without altering anything here.
//
//  Locked decisions:
//    Q1  the customer belongs to the enquiry, not to each product line
//    Q2  the SLA clock stops at the first submit (firstSubmitAt)
//    Q3  Full Submit needs every line RESPONDED or NO_VENDOR (with a reason)
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------------------
//  Identity & access
// ---------------------------------------------------------------------------

enum Role {
  ADMIN
  USER
}

/// Pre-declared for all seven modules so future permissions need no migration.
enum AppModule {
  PRODUCT_ENQUIRY
  SALES
  PROCUREMENT
  PACKING_DISPATCH
  CUSTOMER_BILLING
  VENDOR_INVOICE
  POST_SALES
}

enum PermissionAction {
  VIEW
  CREATE
  EDIT
  DELETE
  ASSIGN
}

/// §6 — created by seed only; there is no public signup in v1.
model User {
  id           String    @id @default(cuid())
  employeeId   String    @unique
  name         String
  email        String    @unique
  mobile       String?
  passwordHash String
  role         Role      @default(USER)
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  permissions       UserModulePermission[]
  createdEnquiries  ProductEnquiry[]       @relation("EnquiryCreatedBy")
  assignedEnquiries ProductEnquiry[]       @relation("EnquiryAssignedTo")
  closedEnquiries   ProductEnquiry[]       @relation("EnquiryClosedBy")
  vendorResponses   VendorResponse[]
  events            EnquiryEvent[]
  delayRecords      DelayRecord[]
  auditLogs         AuditLog[]
  uploadedAssets    MediaAsset[]
  createdSalesOrders SalesOrder[]          @relation("SalesOrderCreatedBy")
  closedSalesOrders  SalesOrder[]          @relation("SalesOrderClosedBy")
  proposedSalesItems SalesOrderItem[]      @relation("SalesItemProposedBy")
  approvedSalesItems SalesOrderItem[]      @relation("SalesItemApprovedBy")
  requestedSalesChanges SalesItemChangeRequest[] @relation("SalesChangeRequestedBy")
  reviewedSalesChanges  SalesItemChangeRequest[] @relation("SalesChangeReviewedBy")
  createdPurchaseBills  PurchaseBill[]           @relation("PurchaseBillCreatedBy")
  purchaseAllocations   PurchaseAllocation[]     @relation("AllocationBy")

  @@index([role, isActive])
}

/// Absent rows mean "use the role default"; present rows override it.
/// v1 needs no rows at all while the mechanism is already in place.
model UserModulePermission {
  id      String           @id @default(cuid())
  userId  String
  module  AppModule
  action  PermissionAction
  allowed Boolean          @default(true)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, module, action])
}

// ---------------------------------------------------------------------------
//  Shared masters
// ---------------------------------------------------------------------------

enum CustomerType {
  RETAIL
  BULK
  WEDDING_GIFTING
  CORPORATE_GIFTING
}

/// Q1 — one enquiry belongs to one customer. Sales and Billing will reference
/// this same row rather than duplicating the name.
model Customer {
  id        String       @id @default(cuid())
  name      String
  type      CustomerType
  phone     String?
  email     String?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  enquiries   ProductEnquiry[]
  salesOrders SalesOrder[]

  /// Not unique: two real firms can legitimately share a name.
  @@index([name])
}

/// §37 — a reusable entity, never re-created per enquiry.
model Vendor {
  id            String   @id @default(cuid())
  name          String   @unique
  contactPerson String?
  phone         String?
  email         String?
  city          String?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  responses     VendorResponse[]
  purchaseBills PurchaseBill[]

  @@index([isActive, name])
}

/// §5 / §6 — one Cloudinary object. URL and public ID only; never binary data.
/// Detailed Cloudinary behaviour is deferred until those requirements arrive.
model MediaAsset {
  id           String   @id @default(cuid())
  publicId     String   @unique
  secureUrl    String
  format       String?
  width        Int?
  height       Int?
  bytes        Int?
  uploadedById String
  createdAt    DateTime @default(now())

  uploadedBy      User             @relation(fields: [uploadedById], references: [id])
  enquiryProducts EnquiryProduct[]
  vendorResponses VendorResponse[]
  salesOrderItems SalesOrderItem[] @relation("SalesItemImage")
  salesChangeRequests SalesItemChangeRequest[] @relation("SalesChangeImage")
  purchaseBills       PurchaseBill[]           @relation("PurchaseBillImage")
  purchaseBillItems   PurchaseBillItem[]       @relation("PurchaseItemImage")

  @@index([uploadedById, createdAt])
}

// ---------------------------------------------------------------------------
//  Product Enquiry
// ---------------------------------------------------------------------------

enum EnquirySource {
  WHATSAPP
  EMAIL
  CALL
  WEBSITE
  INDIAMART
  OTHERS
}

/// §27 — coverage status only. Time state lives in the SLA columns below.
enum EnquiryStatus {
  OPEN
  PARTIAL_CLOSED
  CLOSED
}

enum EnquiryEfficiency {
  ON_TIME
  DELAYED
}

/// Q3 — NO_VENDOR is what makes Full Submit reachable when nobody stocks a line.
enum EnquiryProductStatus {
  PENDING
  RESPONDED
  NO_VENDOR
}

enum WeightUnit {
  G
  KG
  LB
}

enum DimensionUnit {
  MM
  CM
  IN
  FT
}

/// §38 — how a vendor's offering relates to the product the customer asked for.
/// SIMILAR_PRODUCT keeps its original position so existing rows are unaffected.
enum ProductMatchType {
  SIMILAR_PRODUCT
  EXACT_PRODUCT
}

model ProductEnquiry {
  /// Used in URLs — not guessable, unlike a sequential integer.
  id        String @id @default(cuid())
  /// §23 — human-facing only: ENQ-2026-000001.
  enquiryNo String @unique

  customerId   String
  source       EnquirySource
  /// §17 — required when source is OTHERS; also a CHECK constraint.
  sourceDetail String?

  status       EnquiryStatus @default(OPEN)
  createdById  String
  /// §28 — "Towards": whose SLA clock is running.
  assignedToId String

  // --- the clock -----------------------------------------------------------
  // Every timestamp comes from one Postgres now() taken inside the creation
  // transaction. Node's clock is never consulted for business time.

  /// §24 — snapshot of the policy in force, so a later change to the SLA
  /// cannot retroactively rewrite whether this enquiry was on time.
  slaMinutes    Int      @default(15)
  createdAt     DateTime
  slaDeadlineAt DateTime

  /// Q2 — the clock stops at the first submit, partial or full.
  firstSubmitAt   DateTime?
  /// createdAt → firstSubmitAt, frozen at the same moment. Powers average
  /// response time without recomputing it from the event log.
  responseSeconds Int?
  /// §29 — written exactly once, never recalculated.
  efficiency      EnquiryEfficiency?

  partialSubmittedAt DateTime?
  closedAt           DateTime?
  closedById         String?
  updatedAt          DateTime  @updatedAt

  customer   Customer @relation(fields: [customerId], references: [id])
  createdBy  User     @relation("EnquiryCreatedBy", fields: [createdById], references: [id])
  assignedTo User     @relation("EnquiryAssignedTo", fields: [assignedToId], references: [id])
  closedBy   User?    @relation("EnquiryClosedBy", fields: [closedById], references: [id])

  products EnquiryProduct[]
  events   EnquiryEvent[]
  delays   DelayRecord[]

  @@index([status, slaDeadlineAt])
  @@index([assignedToId, status])
  @@index([customerId])
  @@index([createdAt])
  @@index([efficiency, createdAt])
  @@index([firstSubmitAt])
}

/// §11 — one of up to twenty requested items.
/// The cap is guaranteed by @@unique([enquiryId, lineNo]) plus a CHECK
/// constraint, so two concurrent requests cannot produce a 21st row.
model EnquiryProduct {
  id        String @id @default(cuid())
  enquiryId String
  lineNo    Int

  name     String
  /// Catalogue link, added with Purchase & Procurement. Nullable for the same
  /// reason as on SalesOrderItem: existing lines are untouched and `name`
  /// stays the label the customer actually asked for.
  productId String?
  imageId  String?
  quantity Int

  // §19 — stored as entered, plus a normalised column so mixed units still
  // sort and filter together.
  weightValue   Decimal?    @db.Decimal(10, 3)
  weightUnit    WeightUnit?
  weightInGrams Decimal?    @db.Decimal(12, 3)

  // §20 — structured, never a free-text string.
  lengthValue   Decimal?       @db.Decimal(10, 2)
  widthValue    Decimal?       @db.Decimal(10, 2)
  heightValue   Decimal?       @db.Decimal(10, 2)
  dimensionUnit DimensionUnit?
  lengthMm      Decimal?       @db.Decimal(12, 2)
  widthMm       Decimal?       @db.Decimal(12, 2)
  heightMm      Decimal?       @db.Decimal(12, 2)

  /// §21 — the customer will accept alternatives for this line.
  similarOptionNeeded Boolean              @default(false)
  status              EnquiryProductStatus @default(PENDING)
  /// Q3 — mandatory when status is NO_VENDOR; also a CHECK constraint.
  noVendorReason      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  enquiry         ProductEnquiry   @relation(fields: [enquiryId], references: [id], onDelete: Cascade)
  product         Product?         @relation(fields: [productId], references: [id])
  image           MediaAsset?      @relation(fields: [imageId], references: [id], onDelete: SetNull)
  vendorResponses VendorResponse[]

  @@unique([enquiryId, lineNo])
  @@index([enquiryId, status])
  @@index([productId])
}

/// §39 — many of these per line. That is the heart of the module.
model VendorResponse {
  id               String @id @default(cuid())
  enquiryProductId String
  vendorId         String

  /// §32 — a separate relation from the customer's image, so a vendor upload
  /// can never overwrite what the customer sent.
  imageId   String?
  /// §38 — always a similar/alternative option for the requested product.
  matchType ProductMatchType

  /// §35 / Q8 — NUMERIC, per unit. The line total is derived, never stored.
  ratePerUnit Decimal @db.Decimal(12, 2)
  currency    String  @default("INR")

  /// §36 — structured days rather than free text.
  deliveryWithinDays Int
  /// The vendor can deliver on the day of order.
  ///
  /// A separate flag rather than deliveryWithinDays = 0, which the
  /// delivery_positive CHECK forbids, or = 1, which already means "tomorrow".
  /// Nullable so vendor responses recorded before this field existed remain
  /// valid and read as "not stated" rather than a false denial.
  sameDay            Boolean?
  deliveryNote       String?

  weightValue   Decimal?       @db.Decimal(10, 3)
  weightUnit    WeightUnit?
  weightInGrams Decimal?       @db.Decimal(12, 3)
  lengthValue   Decimal?       @db.Decimal(10, 2)
  widthValue    Decimal?       @db.Decimal(10, 2)
  heightValue   Decimal?       @db.Decimal(10, 2)
  dimensionUnit DimensionUnit?

  notes       String?
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  enquiryProduct EnquiryProduct @relation(fields: [enquiryProductId], references: [id], onDelete: Cascade)
  vendor         Vendor         @relation(fields: [vendorId], references: [id])
  image          MediaAsset?    @relation(fields: [imageId], references: [id], onDelete: SetNull)
  createdBy      User           @relation(fields: [createdById], references: [id])

  @@index([enquiryProductId])
  @@index([vendorId, createdAt])
}

// ---------------------------------------------------------------------------
//  History, delays, numbering
// ---------------------------------------------------------------------------

enum EnquiryEventType {
  CREATED
  ASSIGNED
  REASSIGNED
  PRODUCT_ADDED
  PRODUCT_UPDATED
  PRODUCT_REMOVED
  VENDOR_RESPONSE_ADDED
  VENDOR_RESPONSE_UPDATED
  DEADLINE_BREACHED
  DELAY_REASON_SUBMITTED
  PARTIAL_SUBMITTED
  FULL_SUBMITTED
  CLOSED
  REOPENED
}

/// §44 — the Efficiency History. Append-only: the service layer exposes no
/// update path, and nothing here is ever rewritten.
model EnquiryEvent {
  id         String           @id @default(cuid())
  enquiryId  String
  type       EnquiryEventType
  /// Null means the system acted — the SLA breach sweeper, typically.
  actorId    String?
  field      String?
  oldValue   String?
  newValue   String?
  /// Shape-varying diff payload; never queried relationally.
  metadata   Json?
  occurredAt DateTime         @default(now())

  enquiry ProductEnquiry @relation(fields: [enquiryId], references: [id], onDelete: Cascade)
  actor   User?          @relation(fields: [actorId], references: [id])

  @@index([enquiryId, occurredAt])
  @@index([type, occurredAt])
}

/// §43 — one row per breach, many rows allowed. Never overwritten, because
/// management analytics depend on the full history.
model DelayRecord {
  id            String   @id @default(cuid())
  enquiryId     String
  reason        String
  /// Snapshot of the deadline that was missed.
  deadlineAt    DateTime
  /// When the breach was detected.
  detectedAt    DateTime
  minutesLate   Int
  submittedById String
  submittedAt   DateTime @default(now())

  enquiry     ProductEnquiry @relation(fields: [enquiryId], references: [id], onDelete: Cascade)
  submittedBy User           @relation(fields: [submittedById], references: [id])

  @@index([enquiryId, submittedAt])
}

/// §23 — row-locked inside the creation transaction so two employees creating
/// enquiries at the same instant cannot be handed the same number.
model EnquiryCounter {
  /// "2026" for a calendar year, "2026-27" for an Indian financial year (Q5).
  period    String @id
  lastValue Int    @default(0)
}

// ---------------------------------------------------------------------------
//  Sales
// ---------------------------------------------------------------------------

/// A deliberately linear lifecycle. There is no reopen: leaving CLOSED is not a
/// sanctioned move, and every closed order therefore carries a frozen verdict.
enum SalesOrderStatus {
  OPEN
  DISPATCHED
  CLOSED
}

/// The dispatch verdict. Mirrors EnquiryEfficiency in shape but is its own type,
/// because the two are frozen by different events and must stay free to diverge.
enum SalesEfficiency {
  ON_TIME
  DELAYED
}

/// Whether a line counts toward the order.
///
/// A line added during editing by someone without approval rights waits here
/// until an approver acts. PENDING_APPROVAL lines are excluded from every total,
/// so a proposal cannot move money on its own.
/// Every item row that exists is part of the order. PENDING_APPROVAL is kept so
/// no column has to be dropped, but nothing writes it any more: proposals live
/// in SalesItemChangeRequest, so there is one mechanism rather than two.
enum SalesItemStatus {
  ACTIVE
  PENDING_APPROVAL
}

/// What a change request is asking for.
enum SalesChangeType {
  ADD
  EDIT
  REMOVE
}

/// A request is decided exactly once. The decision is kept rather than deleted,
/// so an order can show what was asked for and refused, not only what survived.
enum SalesChangeStatus {
  PENDING
  APPROVED
  REJECTED
}

/// A proposed change to an order's products, held apart from the products
/// themselves.
///
/// This is the only way an order's lines change after creation. The separation
/// is the whole point: an EDIT has to hold proposed values *beside* the
/// untouched original, and a REMOVE has to record intent while the line keeps
/// counting. Neither is expressible on the item row itself, which has exactly
/// one quantity and one price.
///
/// Nothing here is visible to any total. Order value sums SalesOrderItem rows,
/// so a pending request cannot move money however long it sits.
model SalesItemChangeRequest {
  id      String @id @default(cuid())
  orderId String
  /// Null for ADD — there is no line yet. Required for EDIT and REMOVE.
  itemId  String?

  type   SalesChangeType
  status SalesChangeStatus @default(PENDING)

  // Proposed values: required for ADD and EDIT, unused by REMOVE.
  productName    String?
  /// Optional catalogue link carried through a change request, so an approved
  /// ADD or EDIT can set SalesOrderItem.productId. Nullable like every other
  /// field here: a REMOVE request carries none of them.
  productId      String?
  productImageId String?
  quantity       Int?
  price          Decimal? @db.Decimal(12, 2)

  requestedById String
  requestedAt   DateTime @default(now())

  /// Written together with reviewedAt when the request is decided.
  reviewedById String?
  reviewedAt   DateTime?
  reviewNote   String?

  order        SalesOrder      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  /// Cascade: if the line is ever removed, its request history goes with it.
  item         SalesOrderItem? @relation(fields: [itemId], references: [id], onDelete: Cascade)
  product      Product?        @relation(fields: [productId], references: [id])
  productImage MediaAsset?     @relation("SalesChangeImage", fields: [productImageId], references: [id], onDelete: SetNull)
  requestedBy  User            @relation("SalesChangeRequestedBy", fields: [requestedById], references: [id])
  reviewedBy   User?           @relation("SalesChangeReviewedBy", fields: [reviewedById], references: [id])

  @@index([orderId, status])
  @@index([itemId, status])
}

/// One sales order, holding one or more product lines.
///
/// Money invariant: the only figure stored on the order itself is paidAmount.
/// The total is the sum of its ACTIVE lines and pending is total − paid; neither
/// has a column anywhere, so there is exactly one definition of each and nothing
/// to drift. A read-only field with no column cannot be edited by a hand-crafted
/// request, only by one that does not exist.
///
/// Because the total now spans two tables, a row-local CHECK can no longer
/// express the payment ceiling or the settlement rule. Deferred constraint
/// triggers do that instead — see the sales_order_multi_item migration.
model SalesOrder {
  /// Used in URLs — not guessable, and stable even if the order id is corrected.
  id      String @id @default(cuid())
  /// Manually entered, never generated: orders arrive from Shopify as often as
  /// they are keyed in by hand, so the CRM records the number rather than
  /// inventing a competing one.
  orderId String @unique

  customerId String

  /// Partial payments accumulate here. The ceiling is the sum of the order's
  /// ACTIVE lines, enforced by trigger rather than written down a second time.
  paidAmount Decimal @db.Decimal(14, 2) @default(0)

  orderDate        DateTime
  /// The dispatch deadline. A date, so the verdict below compares against the
  /// end of this day rather than its midnight.
  toBeDispatchedBy DateTime

  status SalesOrderStatus @default(OPEN)

  /// Written exactly once, together with efficiency, at dispatch.
  dispatchedAt DateTime?
  /// Frozen at dispatch and never recalculated — a later edit to the deadline
  /// cannot retroactively rewrite whether this order went out on time.
  efficiency   SalesEfficiency?

  closedAt   DateTime?
  closedById String?

  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  customer  Customer         @relation(fields: [customerId], references: [id])
  createdBy User             @relation("SalesOrderCreatedBy", fields: [createdById], references: [id])
  closedBy  User?            @relation("SalesOrderClosedBy", fields: [closedById], references: [id])
  items          SalesOrderItem[]
  changeRequests SalesItemChangeRequest[]

  @@index([status, toBeDispatchedBy])
  @@index([customerId])
  @@index([orderDate])
  @@index([efficiency, orderDate])
}

/// One product line on an order.
///
/// A line proposed by someone without approval rights is created
/// PENDING_APPROVAL and contributes nothing to the order's total until an
/// approver moves it to ACTIVE. That is the whole of the approval mechanism:
/// totals only ever sum ACTIVE rows, so a pending line cannot move money.
model SalesOrderItem {
  id      String @id @default(cuid())
  orderId String
  /// Position on the order. Unique per order, so two concurrent adds cannot
  /// collide on the same line number.
  lineNo  Int

  productName    String
  /// Catalogue link, added with Purchase & Procurement. Nullable on purpose:
  /// every line written before the Product master existed keeps working, and
  /// productName remains the authoritative label on the order either way.
  productId      String?
  productImageId String?
  quantity       Int
  /**
   * Units already supplied to the customer *outside* procurement — from a
   * previous despatch, a counter sale, whatever happened before this system
   * saw the order.
   *
   * Deliberately not derived from InventoryItem.onHand. Warehouse stock is
   * shared: ten on the shelf would otherwise appear to satisfy every order
   * needing that product at once, so three customers each wanting ten would
   * all read as fulfilled by the same ten units. A per-line count cannot make
   * that mistake.
   *
   * Fulfilment through procurement is *not* recorded here — that is the sum of
   * this line's PurchaseAllocation rows. Keeping the two apart is what stops a
   * second, drifting copy of the same total:
   *
   *     totalFulfilled = alreadyFulfilled + Σ allocations
   *     unfulfilled    = max(0, quantity - totalFulfilled)
   */
  alreadyFulfilled Int @default(0)
  price          Decimal @db.Decimal(12, 2)

  status SalesItemStatus @default(ACTIVE)

  /// Who put this line forward. Always set, including for lines created with
  /// the order itself.
  proposedById String
  /// Written together with approvedAt when the line is accepted.
  approvedById String?
  approvedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  order        SalesOrder  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product      Product?    @relation(fields: [productId], references: [id])
  productImage MediaAsset? @relation("SalesItemImage", fields: [productImageId], references: [id], onDelete: SetNull)
  proposedBy   User        @relation("SalesItemProposedBy", fields: [proposedById], references: [id])
  approvedBy   User?       @relation("SalesItemApprovedBy", fields: [approvedById], references: [id])
  changeRequests SalesItemChangeRequest[]
  allocations    PurchaseAllocation[]

  @@unique([orderId, lineNo])
  @@index([orderId, status])
  @@index([productId])
}

/// §45 — generic trail for everything without an enquiry parent: logins, user
/// management, vendor edits, permission changes.
model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  action     String
  entityType String
  entityId   String?
  oldValue   Json?
  newValue   Json?
  ip         String?
  userAgent  String?
  createdAt  DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id])

  @@index([entityType, entityId, createdAt])
  @@index([actorId, createdAt])
}

// ---------------------------------------------------------------------------
//  Product master & inventory
// ---------------------------------------------------------------------------

/// The product catalogue, introduced with Purchase & Procurement.
///
/// Until this module, a product was a free-text string on an order line, so
/// "Bottle" on one order had no relationship to "Bottle" on another. That is
/// tolerable while a line is only ever read by a human, and impossible once
/// stock has to be counted: a shortage is `required - on hand`, and neither
/// side of that subtraction exists without a product identity.
///
/// The link from SalesOrderItem and EnquiryProduct is deliberately *nullable*.
/// Every row written before this module keeps working untouched, and a line
/// can still be typed as free text where no catalogue entry fits yet.
model Product {
  id   String @id @default(cuid())
  /// The name as a person typed it. Unique on the raw string, which catches
  /// only byte-identical spellings — `normalizedName` below is what actually
  /// enforces one product per logical item.
  name String @unique
  /// `name` folded to lowercase with every space removed, so "Kansa Dinner
  /// Set", "kansa dinner set" and "kansadinnerset" collapse to one key.
  ///
  /// Unique, and that is the point: it is the database, not the application,
  /// that refuses the second insert, so two concurrent requests cannot both
  /// pass a check-then-insert and create rival products with separate stock.
  /// Derived on write and never displayed — `name` remains the label, and is
  /// never rewritten to match.
  normalizedName String @unique
  /// Free-text, matching how the rest of the CRM treats descriptive fields.
  description String?
  /// Retired products stay for history; they simply stop being offered.
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  inventory           InventoryItem?
  purchaseBillItems   PurchaseBillItem[]
  salesOrderItems     SalesOrderItem[]
  enquiryProducts     EnquiryProduct[]
  salesChangeRequests SalesItemChangeRequest[]

  @@index([isActive, name])
}

/// What is physically on hand, one row per product.
///
/// Separate from Product because the catalogue entry is descriptive and this is
/// operational: quantities change constantly and are written under a row lock,
/// while the name and description are edited rarely. Keeping them apart means
/// stock updates never contend with catalogue edits.
model InventoryItem {
  id        String @id @default(cuid())
  productId String @unique

  /// Physically in the warehouse. Never negative — a DB CHECK enforces it.
  onHand Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

// ---------------------------------------------------------------------------
//  Purchase & Procurement
// ---------------------------------------------------------------------------

/// Credit or settled at purchase.
enum PurchaseBillType {
  CREDIT
  PAID_UP
}

/// A bill's progress. Deliberately linear, like the Sales lifecycle.
enum PurchaseBillStatus {
  OPEN
  RECEIVED
  CLOSED
}

/// One bill from one vendor.
///
/// A procurement run that spans several vendors is several bills, which is how
/// the paperwork actually arrives: a vendor issues one bill for the goods they
/// supplied. "Multiple vendors" is therefore satisfied by multiple bills
/// against the same shortage, not by a vendor column on every line — that
/// would model one document as though it came from several suppliers.
model PurchaseBill {
  id String @id @default(cuid())

  /// As printed on the vendor's bill. Unique per vendor, not globally: two
  /// vendors can each have a bill numbered "001".
  billNumber String
  vendorId   String

  billType PurchaseBillType
  status   PurchaseBillStatus @default(OPEN)

  billDate DateTime
  /// When the goods were promised. A delay is measured against this.
  expectedBy DateTime?

  /// The photographed bill, through the existing Cloudinary/MediaAsset path.
  billImageId String?

  /// Set when the goods arrive later than expectedBy. The reason is mandatory
  /// whenever the flag is set — enforced by a CHECK, as elsewhere in the CRM.
  isDelayed   Boolean @default(false)
  delayReason String?

  notes String?

  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  vendor    Vendor             @relation(fields: [vendorId], references: [id])
  billImage MediaAsset?        @relation("PurchaseBillImage", fields: [billImageId], references: [id], onDelete: SetNull)
  createdBy User               @relation("PurchaseBillCreatedBy", fields: [createdById], references: [id])
  items     PurchaseBillItem[]

  @@unique([vendorId, billNumber])
  @@index([status, billDate])
  @@index([vendorId])
  @@index([isDelayed, billDate])
}

/// One product line on a purchase bill.
///
/// `receivedQty` is what actually arrived and is the only quantity that can be
/// allocated — ordering ten and receiving four must not let four become ten of
/// available stock. Standing quantity is `receivedQty` minus everything
/// allocated from this line.
model PurchaseBillItem {
  id     String @id @default(cuid())
  billId String
  /// Position on the bill; unique per bill, so concurrent adds cannot collide.
  lineNo Int

  /**
   * What the vendor's bill actually calls it.
   *
   * A purchase bill is a record of a document someone was handed, so the line
   * keeps the supplier's own description rather than a tidied catalogue name.
   * That is what makes the recorded bill checkable against the paper.
   */
  productName String

  /**
   * The catalogue link, optional at bill entry.
   *
   * A bill is typed up from a piece of paper, often before anyone has decided
   * which catalogue entry the goods correspond to — and sometimes the entry
   * does not exist yet. Forcing the decision at entry time would make
   * recording a bill impossible until the catalogue was curated.
   *
   * Allocation still requires it: stock can only be matched to a customer
   * requirement by product identity, never by spelling. An unlinked line can
   * therefore be recorded and received, but not allocated, until it is linked.
   */
  productId String?

  /// What was ordered, and what turned up. received <= ordered (CHECK).
  orderedQty Int
  receivedQty Int @default(0)

  /// Per unit, NUMERIC so no floating point touches money.
  rate Decimal @db.Decimal(12, 2)

  productImageId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bill         PurchaseBill         @relation(fields: [billId], references: [id], onDelete: Cascade)
  product      Product?             @relation(fields: [productId], references: [id])
  productImage MediaAsset?          @relation("PurchaseItemImage", fields: [productImageId], references: [id], onDelete: SetNull)
  allocations  PurchaseAllocation[]

  @@unique([billId, lineNo])
  @@index([productId])
}

/// Purchased stock assigned to one order line.
///
/// This is the join that makes one purchase serve many customers: a bill item
/// can carry several allocations to different orders, and an order line can be
/// filled from several bills. Both quantities it is checked against — the
/// line's remaining requirement and the bill item's standing quantity — are
/// read under a row lock before the row is written, so two people cannot spend
/// the same stock.
model PurchaseAllocation {
  id                 String @id @default(cuid())
  purchaseBillItemId String
  /// The order line being filled. Identity comes from the line, not a product
  /// name, so an allocation cannot drift onto the wrong requirement.
  salesOrderItemId   String

  quantity Int

  allocatedById String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  purchaseBillItem PurchaseBillItem @relation(fields: [purchaseBillItemId], references: [id], onDelete: Cascade)
  salesOrderItem   SalesOrderItem   @relation(fields: [salesOrderItemId], references: [id], onDelete: Cascade)
  allocatedBy      User             @relation("AllocationBy", fields: [allocatedById], references: [id])

  /// One row per (bill item, order line): a second allocation of the same
  /// stock to the same line is an edit, not a new row.
  @@unique([purchaseBillItemId, salesOrderItemId])
  @@index([salesOrderItemId])
}
