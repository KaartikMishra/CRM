{
  "name": "@rs/database",
  "version": "0.1.0",
  "private": true,
  "description": "Prisma schema, migrations, seed and the shared PrismaClient. The only tier permitted to talk to PostgreSQL.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "prisma"
  ],
  "scripts": {
    "generate": "dotenv -e ../.env -- prisma generate",
    "migrate": "dotenv -e ../.env -- prisma migrate dev",
    "migrate:deploy": "dotenv -e ../.env -- prisma migrate deploy",
    "migrate:invariants": "prisma migrate dev --create-only --name business_invariants",
    "studio": "dotenv -e ../.env -- prisma studio",
    "seed": "tsx prisma/seed.ts",
    "build": "prisma generate && tsc -p tsconfig.json",
    "prepare": "npm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "migrate:status": "dotenv -e ../.env -- prisma migrate status",
    "migrate:create": "dotenv -e ../.env -- prisma migrate dev --create-only",
    "validate": "dotenv -e ../.env -- prisma validate"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.0.0",
    "@rs/shared": "*",
    "bcrypt": "^6.0.0",
    "dotenv": "^16.4.5"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/node": "^22.9.0",
    "prisma": "^6.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "dotenv-cli": "^7.4.4"
  }
}
