{
  "name": "royalstuffs-crm",
  "version": "0.1.0",
  "private": true,
  "description": "Internal CRM for RoyalStuffs.com",
  "workspaces": [
    "shared",
    "database",
    "backend"
  ],
  "scripts": {
    "build:shared": "npm run build --workspace @rs/shared",
    "db:generate": "npm run generate --workspace @rs/database",
    "db:migrate": "npm run migrate --workspace @rs/database",
    "db:seed": "npm run seed --workspace @rs/database",
    "db:studio": "npm run studio --workspace @rs/database",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "dev:backend": "npm run dev --workspace @rs/backend",
    "build:backend": "npm run build --workspace @rs/backend"
  },
  "engines": {
    "node": ">=20"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.0"
  }
}
