{
  "name": "royalstuffs-crm",
  "version": "0.1.0",
  "private": true,
  "description": "Internal CRM for RoyalStuffs.com",
  "workspaces": [
    "shared",
    "database",
    "backend",
    "frontend"
  ],
  "scripts": {
    "build:shared": "npm run build --workspace @rs/shared",
    "build:database": "npm run build --workspace @rs/database",
    "db:generate": "npm run generate --workspace @rs/database",
    "db:migrate": "npm run migrate --workspace @rs/database",
    "db:seed": "npm run seed --workspace @rs/database",
    "db:studio": "npm run studio --workspace @rs/database",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "dev": "concurrently --names \"backend,frontend\" --prefix-colors \"yellow.bold,cyan.bold\" --prefix \"[{name}]\" --kill-others --handle-input --success first \"npm:dev:backend\" \"npm:dev:frontend\"",
    "dev:backend": "npm run dev --workspace @rs/backend",
    "build:backend": "npm run build --workspace @rs/backend",
    "dev:frontend": "npm run dev --workspace @rs/frontend",
    "build:frontend": "npm run build --workspace @rs/frontend",
    "test": "npm run test --workspace @rs/backend",
    "test:watch": "npm run test:watch --workspace @rs/backend",
    "build": "npm run build:shared && npm run build:database && npm run build:backend && npm run build:frontend",
    "start": "npm run start --workspace @rs/backend",
    "start:backend": "npm run start --workspace @rs/backend",
    "start:frontend": "npm run start --workspace @rs/frontend"
  },
  "engines": {
    "node": ">=20"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.0"
  },
  "devDependencies": {
    "vitest": "^4.1.11",
    "concurrently": "^9.1.2"
  }
}
